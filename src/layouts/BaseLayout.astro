---
import { asset } from '../lib/asset';
export interface Props {
  title: string;
  description?: string;
  /** 로그인/회원가입 등 색인할 콘텐츠가 없는 기능성 페이지에 true */
  noindex?: boolean;
  ogImage?: string;
  /** 광고 스크립트 로드 여부. 콘텐츠가 없는 페이지(404·로그인 등)는 false */
  ads?: boolean;
  /** Vue·dayjs·html2canvas 로드 여부. 코스 상세 페이지 전용 */
  app?: boolean;
}
const {
  title,
  description = 'Travel HUIHUI — 직접 다녀온 국내 여행 코스를 일자별 동선, 장소별 운영시간·비용·팁까지 정리한 국내 여행 안내서.',
  noindex = false,
  ogImage,
  ads = true,
  app = false,
} = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname.replace(/\/index\.html$/, ''), Astro.site).href
  : undefined;
const ogImageUrl = ogImage && Astro.site ? new URL(ogImage, Astro.site).href : ogImage;

/* Cloudflare Web Analytics 사이트 토큰 (대시보드 > Web Analytics > travel-huihui.com). 쿠키를 쓰지 않는다.
   비어 있거나 개발 서버(npm run dev)면 넣지 않아 로컬 방문이 집계되지 않는다 */
const CF_ANALYTICS_TOKEN = '53f2ea5a237d4f8f915784e58e921541';
const analytics = import.meta.env.PROD && CF_ANALYTICS_TOKEN;
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- 네이버 서치어드바이저 / 구글 서치 콘솔 사이트 소유 확인 -->
  <meta name="naver-site-verification" content="7dee88d4e7cf30ec338c0325fc0af403fab5c46e" />
  <meta name="google-site-verification" content="ERBbopIYyCodMqXl9JogBp2P5epPslJDiJZWx81BP4Y" />
  <!-- PC/모바일 화면 전환: 다른 스크립트보다 먼저 동기 실행 -->
  <script src={asset('/assets/js/view-mode.js')} is:inline></script>
  <title>{title}</title>
  <!-- 파비콘: 囍 로고 아이콘 (scripts/make_favicon.mjs로 생성) -->
  <link rel="icon" href={asset('/favicon.ico')} sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
  <link rel="icon" type="image/png" href={asset('/favicon-32.png')} sizes="32x32" />
  <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
  <link rel="manifest" href="/site.webmanifest" />
  {description && <meta name="description" content={description} />}
  {canonical && <link rel="canonical" href={canonical} />}
  {noindex
    ? <meta name="robots" content="noindex, follow" />
    : <meta name="robots" content="index, follow, max-image-preview:large" />}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Travel HUIHUI" />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

  <!-- Google AdSense -->
  {ads && <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3271578034191442" crossorigin="anonymous"></script>}

  <!-- Fonts -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <!-- Pretendard: 모던 산세리프 하나로 제목·본문을 모두 쓴다 (전통 장식과 대비) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" integrity="sha384-GIdEBaqGN9mNkDkMkzMHW8EKUqtpPIe/sLj1X7DIrnc9uPtLROJgmuDlh+3rBw0j" crossorigin="anonymous" />
  <!-- Hahmlet: 제목·지명에 쓰는 개성 있는 한글 디스플레이 세리프 (본문은 Pretendard) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hahmlet:wght@600;700;800&display=swap" />

  <!-- Design tokens -->
  <link rel="stylesheet" href={asset('/assets/css/tokens.css')} />
  <link rel="stylesheet" href={asset('/assets/css/hanok.css')} />

  <!-- Vue 3 + utilities (코스 상세 페이지에서만)
       CDN 라이브러리는 정확한 버전으로 고정하고 integrity(SRI)로 내용을 검사한다.
       버전을 올릴 때는 해시도 새로 받아야 한다: curl -sL <url> | openssl dgst -sha384 -binary | openssl base64 -A -->
  {app && <script src="https://cdn.jsdelivr.net/npm/vue@3.5.44/dist/vue.global.prod.js" integrity="sha384-tORx0bXmMnTC28EYQe1coaGZKSQupXQEYDBNex8xkzJ9iqUoNy9Y+VFBhVxi4kUr" crossorigin="anonymous" is:inline></script>}
  {app && <script src="https://cdn.jsdelivr.net/npm/dayjs@1.11.23/dayjs.min.js" integrity="sha384-1Ft4/JTNbt7S/44V0himpcjx+YfQ1a6W6SYBJMr94ba6jwZhWoWoLaZsMmtJILgq" crossorigin="anonymous" is:inline></script>}
  {app && <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js" integrity="sha384-ZZ1pncU3bQe8y31yfZdMFdSpttDoPmOZg2wguVK9almUodir1PghgT0eY7Mrty8H" crossorigin="anonymous" is:inline></script>}

  <!-- Supabase -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.118.0/dist/umd/supabase.min.js" integrity="sha384-UagCvVPT5XXA0Hx+nJYUAGBFseHT9zBgpJMSebsAxl9lciTwbT+39j5VfRjdP5Tp" crossorigin="anonymous" is:inline></script>
  <script src={asset('/assets/js/supabase-client.js')} is:inline></script>

  <!-- 방문 통계 (Cloudflare Web Analytics) -->
  {analytics && <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })} is:inline></script>}

  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main">본문으로 건너뛰기</a>
  <slot />
</body>
</html>
