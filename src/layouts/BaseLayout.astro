---
export interface Props {
  title: string;
  description?: string;
  /** 로그인/회원가입 등 색인할 콘텐츠가 없는 기능성 페이지에 true */
  noindex?: boolean;
  ogImage?: string;
}
const {
  title,
  description = 'HUIHUI Travel — 직접 다녀온 국내 여행 코스를 일자별 동선, 장소별 운영시간·비용·팁까지 정리한 국내 여행 안내서.',
  noindex = false,
  ogImage,
} = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname.replace(/\/index\.html$/, ''), Astro.site).href
  : undefined;
const ogImageUrl = ogImage && Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {canonical && <link rel="canonical" href={canonical} />}
  {noindex
    ? <meta name="robots" content="noindex, follow" />
    : <meta name="robots" content="index, follow, max-image-preview:large" />}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="HUIHUI Travel" />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3271578034191442" crossorigin="anonymous"></script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=DM+Sans:wght@300;400;500;600&family=DM+Serif+Display&family=Noto+Sans+KR:wght@300;400;500&display=swap" rel="stylesheet" />

  <!-- Design tokens -->
  <link rel="stylesheet" href="/assets/css/tokens.css" />

  <!-- Vue 3 + utilities (used by trip pages) -->
  <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/dayjs@1/dayjs.min.js" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/html2canvas@1" is:inline></script>

  <!-- Supabase -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" is:inline></script>
  <script src="/assets/js/supabase-client.js" is:inline></script>

  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
