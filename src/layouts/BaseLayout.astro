---
import { asset } from '../lib/asset';
export interface Props {
  title: string;
  description?: string;
  /** 로그인/회원가입 등 색인할 콘텐츠가 없는 기능성 페이지에 true */
  noindex?: boolean;
  ogImage?: string;
  /** 광고 스크립트 로드 여부. 콘텐츠가 없는 페이지(404·로그인 등)는 false */
  ads?: boolean;
  /** Vue·dayjs·html2canvas 로드 여부. 코스 상세 페이지 전용 */
  app?: boolean;
}
const {
  title,
  description = 'Travel HUIHUI — 직접 다녀온 국내 여행 코스를 일자별 동선, 장소별 운영시간·비용·팁까지 정리한 국내 여행 안내서.',
  noindex = false,
  ogImage,
  ads = true,
  app = false,
} = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname.replace(/\/index\.html$/, ''), Astro.site).href
  : undefined;
const ogImageUrl = ogImage && Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- PC/모바일 화면 전환: 다른 스크립트보다 먼저 동기 실행 -->
  <script src={asset('/assets/js/view-mode.js')} is:inline></script>
  <title>{title}</title>
  <!-- 파비콘: 喜 브랜드 아이콘 (scripts/make_favicon.mjs로 생성) -->
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
  <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {description && <meta name="description" content={description} />}
  {canonical && <link rel="canonical" href={canonical} />}
  {noindex
    ? <meta name="robots" content="noindex, follow" />
    : <meta name="robots" content="index, follow, max-image-preview:large" />}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Travel HUIHUI" />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

  <!-- Google AdSense -->
  {ads && <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3271578034191442" crossorigin="anonymous"></script>}

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&family=Noto+Serif+KR:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Design tokens -->
  <link rel="stylesheet" href={asset('/assets/css/tokens.css')} />
  <link rel="stylesheet" href={asset('/assets/css/hanok.css')} />

  <!-- Vue 3 + utilities (코스 상세 페이지에서만) -->
  {app && <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js" is:inline></script>}
  {app && <script src="https://cdn.jsdelivr.net/npm/dayjs@1/dayjs.min.js" is:inline></script>}
  {app && <script src="https://cdn.jsdelivr.net/npm/html2canvas@1" is:inline></script>}

  <!-- Supabase -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" is:inline></script>
  <script src={asset('/assets/js/supabase-client.js')} is:inline></script>

  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main">본문으로 건너뛰기</a>
  <slot />
</body>
</html>
