---
/**
 * 서버에서 렌더링되는 여행 코스 목록.
 * 홈/갤러리의 카드는 클라이언트 JS로 그려지기 때문에 크롤러가 개별 코스 페이지를
 * 발견할 수 없다. 이 섹션이 정적 HTML 안의 실제 <a href> 진입점 역할을 한다.
 */
import type { TripData } from '../lib/tripData';

export interface Props {
  trips: TripData[];
  title?: string;
  desc?: string;
  /** 코스 상세 페이지 하단처럼 목록이 본문이 아닌 곳에서는 운영자 노트를 생략한다. */
  compact?: boolean;
}

const {
  trips,
  title = '전체 여행 코스',
  desc = '직접 다녀온 국내 여행 코스입니다. 코스별로 방문 순서, 이동 시간, 장소별 상세 정보와 팁을 정리했습니다.',
  compact = false,
} = Astro.props;

/* 태그 앞 이모지는 빼고 글만 쓴다 */
const plain = (s: string) => s.replace(/^[\p{Extended_Pictographic}\uFE0F\u200D\s]+/u, '');
const entries = trips.map((t) => ({
  href: `/trips/${t.id}`,
  title: t.title,
  eyebrow: t.locationLabel,
  placeCount: t.places.length,
  tags: t.tags.slice(0, 3).map(plain),
  note: t.operatorNote?.text ?? '',
}));
---

<section class={`trip-index${compact ? ' is-compact' : ''}`} id="trip-index" aria-labelledby="trip-index-title">
  <div class="ti-head">
    <h2 class="ti-title" id="trip-index-title">{title}</h2>
    <p class="ti-desc">{desc}</p>
  </div>

  <ul class="ti-list">
    {entries.map((e) => (
      <li class="ti-item">
        <a class="ti-link" href={e.href}>
          <span class="ti-item-loc">{e.eyebrow}</span>
          <p class="ti-item-title">{e.title}</p>
        </a>
        <p class="ti-item-meta">
          장소 {e.placeCount}곳
          {e.tags.length > 0 && <> · {e.tags.join(' · ')}</>}
        </p>
        {!compact && e.note && <p class="ti-item-note">{e.note}</p>}
        {!compact && <a class="ti-more" href={e.href}>코스 자세히 보기 →</a>}
      </li>
    ))}
  </ul>
</section>

<style>
/* 에디토리얼 목차: 굵은 먹 선 아래 번호 붙은 항목, 항목 사이는 가는 선 */
.trip-index {
  max-width: 1148px;
  margin: 0 auto;
  padding: 64px clamp(20px, 5vw, 48px) 72px;
}
.ti-head {
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 12px 48px; align-items: end;
  border-top: 2px solid var(--color-text-primary);
  padding: 20px 0 24px;
  border-bottom: 1px solid var(--color-rule);
}
.ti-title {
  font-family: var(--font-display);
  font-size: clamp(26px, 3.4vw, 40px);
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 0;
  letter-spacing: -0.02em;
  word-break: keep-all;
}
.ti-desc {
  font-size: 14px;
  line-height: 1.8;
  color: var(--color-text-secondary);
  margin: 0;
  word-break: keep-all;
}
.ti-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); column-gap: 48px;
}
.ti-item {
  position: relative;
  padding: 22px 0 20px;
  border-bottom: 1px solid var(--color-rule);
}
.ti-link {
  text-decoration: none;
  display: inline-block;
}
.ti-item-loc {
  display: block;
  font-family: var(--font-heading);
  font-size: 12px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-text-tertiary);
  margin-bottom: 6px;
}
.ti-item-title {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--color-text-primary);
  margin: 0 0 8px;
  word-break: keep-all;
  transition: color 0.18s;
}
.ti-link:hover .ti-item-title { color: var(--yeonji-600); }
.ti-item-meta {
  font-size: 12px;
  letter-spacing: 0.02em;
  color: var(--color-text-tertiary);
  margin: 0 0 10px;
}
.ti-item-note {
  font-size: 14px;
  line-height: 1.8;
  color: var(--color-text-secondary);
  margin: 0 0 6px;
  word-break: keep-all;
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
}
.ti-more {
  display: inline-flex; align-items: center; min-height: 44px;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.04em;
  color: var(--color-text-primary);
  text-decoration: none;
}
.ti-more:hover { color: var(--yeonji-600); }

/* 목차처럼 작게: 홈·코스 페이지 아래 부록 */
.is-compact .ti-title { font-size: clamp(20px, 2.2vw, 26px); }
.is-compact .ti-item { padding: 14px 0 12px; }
.is-compact .ti-item-title { font-size: 17px; margin-bottom: 4px; }
.is-compact .ti-item-meta { margin: 0; }

@media (max-width: 720px) {
  .trip-index { padding: 44px 20px 56px; }
  .ti-head { grid-template-columns: 1fr; }
  .ti-list { grid-template-columns: 1fr; }
  .ti-item-title { font-size: 18px; }
}
</style>
