---
/**
 * 홈 히어로 맨 위를 가로지르는 기와 처마 — 먹 선 한 가닥으로 그린 에디토리얼 삽화.
 * 위에서부터 기와골 → 막새 → 부연 → 서까래 → 창방. 양 끝은 추녀처럼 들린다.
 * 색은 먹 하나, 풍경 물고기만 연지로 찍는다.
 *
 * 모션 (prefers-reduced-motion이면 모두 멈춘 완성 상태로 보인다)
 *   - 처음 열릴 때 선이 위에서부터 차례로 그려진다 (pathLength=1 + stroke-dashoffset)
 *   - 풍경이 바람에 천천히 흔들린다
 *   - 스크롤하면 처마가 조금 늦게 따라 올라간다 (패럴랙스)
 * 슬롯(default)으로 넘긴 요소는 처마 영역 위에 겹쳐 놓인다(오늘의 키).
 */
const W = 1440;
const MID = W / 2;
const INK = '#1A1714';
const RED = '#B23A44';

const FLAT = 400;
const SPAN = MID + 40 - FLAT;
const EAVE = 168;
const eaveY = (x) => {
  const d = Math.abs(x - MID);
  if (d <= FLAT) return EAVE;
  const t = Math.min(1, (d - FLAT) / SPAN);
  return EAVE - 150 * Math.pow(t, 2.1);
};
const tilt = (x) => (Math.atan2(eaveY(x + 1) - eaveY(x - 1), 2) * 180) / Math.PI;
const line = (off = 0) => {
  const p = [];
  for (let x = -40; x <= W + 40; x += 8) p.push(`${x},${(eaveY(x) + off).toFixed(1)}`);
  return 'M' + p.join(' L');
};

const STEP = 46;
const xs = [];
for (let x = (MID % STEP) - STEP; x <= W + STEP; x += STEP) xs.push(x);
const top = (x) => MID + (x - MID) * 0.8;
const BEAM = 236;
const wash = (() => {
  const p = [];
  for (let x = W + 40; x >= -40; x -= 8) p.push(`${x},${eaveY(x).toFixed(1)}`);
  return `M-40 -10H${W + 40}L${p.join(' L')}Z`;
})();
---
<div class="hanok-eave" data-eave>
  <svg class="he-svg" viewBox={`0 0 ${W} 300`} preserveAspectRatio="xMidYMin slice" fill="none" stroke={INK} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <g class="he-par">
      <!-- 지붕 면: 아주 옅은 먹 번짐으로 무게만 준다 -->
      <path class="he-wash" d={wash} fill={INK} fill-opacity=".045" stroke="none" />
      <!-- 1. 기와골: 처마 가까이만 짧게 (위로는 한지로 사라진다) -->
      <g class="he-draw" style="--d:0s" stroke-opacity=".3" stroke-width="1">
        {xs.map((x) => {
          const y = eaveY(x) - 12;
          const k = 0.8 + 0.2 * (1 - Math.abs(x - MID) / MID);
          return <path pathLength="1" d={`M${(x + (top(x) - x) * 0.35).toFixed(1)} ${(y - 90 * k).toFixed(1)} L${x} ${y.toFixed(1)}`} />;
        })}
      </g>
      <!-- 2. 처마선 -->
      <g class="he-draw" style="--d:.35s" stroke-width="1.3">
        <path pathLength="1" d={line(0)} />
        
      </g>
      <!-- 3. 막새 + 암막새 -->
      <g class="he-draw" style="--d:.6s" stroke-width="1.1">
        {xs.map((x) => (
          <>
            <circle pathLength="1" cx={x} cy={eaveY(x)} r="10.5" fill="#F4F1EA" />
            <circle pathLength="1" cx={x} cy={eaveY(x)} r="5.5" stroke-opacity=".55" stroke-width=".8" />
            <path pathLength="1" d={`M${x + 11} ${eaveY(x) + 3} Q${x + STEP / 2} ${((eaveY(x) + eaveY(x + STEP)) / 2 + 11).toFixed(1)} ${x + STEP - 11} ${eaveY(x + STEP) + 3}`} stroke-opacity=".7" />
          </>
        ))}
      </g>
      <!-- 4. 서까래 끝 -->
      <g class="he-draw" style="--d:.85s" stroke-width=".9" stroke-opacity=".7">
        {xs.map((x) => {
          const cx = x + STEP / 2;
          return <circle pathLength="1" cx={cx} cy={(eaveY(cx) + 40).toFixed(1)} r="6.5" />;
        })}
      </g>
      <!-- 5. 창방: 두 줄 가는 선 + 마름모 마디 -->
      <g class="he-draw" style="--d:1.1s" stroke-width="1">
        <path pathLength="1" d={`M-40 ${BEAM}H${W + 40}`} />
        <path pathLength="1" d={`M-40 ${BEAM + 16}H${W + 40}`} />
        {Array.from({ length: 5 }, (_, i) => 144 + i * 288).map((x) => (
          <path pathLength="1" d={`M${x} ${BEAM + 2}L${x + 6} ${BEAM + 8}L${x} ${BEAM + 14}L${x - 6} ${BEAM + 8}Z`} stroke-opacity=".7" />
        ))}
      </g>
    </g>

    <!-- 풍경: 왼쪽 추녀 끝 -->
    <g class="he-pung" style="transform-origin:262px 120px">
      <g class="he-draw" style="--d:1.3s" stroke-width="1">
        <path pathLength="1" d="M262 120V146" />
        <path pathLength="1" d="M252 164C252 152 256 146 262 146C268 146 272 152 272 164Z" />
        <path pathLength="1" d="M249 164H275M262 164V178" />
      </g>
      <g class="he-fish" style="transform-origin:262px 178px">
        <path d="M262 178C268 182 268 192 262 198C256 192 256 182 262 178ZM262 198L258 204H266Z" fill={RED} stroke="none" />
      </g>
    </g>
  </svg>
  <slot />
</div>

<script is:inline>
  /* 스크롤하면 처마가 조금 늦게 따라 올라간다. 움직임 줄이기 설정이면 하지 않는다 */
  (function () {
    var el = document.querySelector('[data-eave] .he-par');
    if (!el || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var ticking = false;
    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        var y = Math.min(window.scrollY, 600);
        el.style.transform = 'translateY(' + (y * 0.12).toFixed(1) + 'px)';
        ticking = false;
      });
    }, { passive: true });
  })();
</script>

<style>
  .hanok-eave { position: relative; width: 100%; height: clamp(150px, 20.8vw, 300px); }
  .he-svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; overflow: hidden; }

  /* 선이 그려지며 나타난다 */
  .he-draw > *, .he-draw path, .he-draw circle, .he-draw rect {
    stroke-dasharray: 1; stroke-dashoffset: 1;
    animation: heDraw 1.4s cubic-bezier(0.65, 0, 0.35, 1) forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes heDraw { to { stroke-dashoffset: 0; } }
  .he-fish { opacity: 0; animation: heFade .6s ease-out 1.9s forwards, heSway 2.6s ease-in-out 2.5s infinite; transform-box: view-box; }
  @keyframes heFade { to { opacity: 1; } }
  .he-wash { opacity: 0; animation: heFade 1.2s ease-out .4s forwards; }

  .he-pung { transform-box: view-box; animation: heSway 5.4s ease-in-out 2s infinite; }
  @keyframes heSway { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(3deg); } }

  @media (prefers-reduced-motion: reduce) {
    .he-draw > *, .he-draw path, .he-draw circle, .he-draw rect { animation: none; stroke-dashoffset: 0; }
    .he-fish, .he-wash { animation: none; opacity: 1; }
    .he-pung { animation: none; }
  }
</style>
