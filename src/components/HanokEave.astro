  }
  .he-svg :global(.he-fade) { opacity: 0; animation: heFade .9s ease-out forwards; animation-delay: var(--d, 0s); }
  @keyframes heDraw { to { stroke-dashoffset: 0; } }
  @keyframes heFade { to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .he-svg :global(.he-draw path) { animation: none; stroke-dashoffset: 0; }
    .he-svg :global(.he-fade) { animation: none; opacity: 1; }
