---
/**
 * 홈 히어로 맨 위 기와 처마 — 먹 선화 위에 숨어 있는 단청.
 *
 * 같은 그림을 두 장 겹친다.
 *   1) 아래: 단청 채색층 (.he-color) — 평소에는 가려져 있다
 *   2) 위:   먹 선화층  (.he-line)  — 늘 보인다
 * 마우스(손가락)가 지나가는 자리만 원형 마스크로 채색층이 드러나, 붓으로 색을 입히듯 단청이 나타난다.
 * 커서 가까운 연화(서까래·막새·창방 머리초)는 천천히 돌며 피어난다.
 * 처음 열릴 때는 선이 그려진 뒤 색이 처마를 한 번 훑고 지나간다.
 *
 * 부재: 기와골 → 수막새(연화) → 부연(주화) → 서까래(녹화) → 창방(머리초·휘·금문)
 * 움직임 줄이기 설정이면 선 그리기·인트로·회전 없이, 호버 드러남만 남긴다.
 */
const W = 1440;
const H = 340;
const MID = W / 2;
const INK = '#1A1714';

// 단청 색
const C = {
  green: '#2F7F6C', blue: '#2E4A7D', sky: '#86A9CF',
  red: '#B23A44', brown: '#6E3329', gold: '#D2A23A', white: '#F4F1EA', pink: '#E6A3A6',
  tile: '#2A333F', tileHi: '#46525F', clay: '#59636F',
};

const FLAT = 400;
const SPAN = MID + 40 - FLAT;
const EAVE = 150;
const eaveY = (x) => {
  const d = Math.abs(x - MID);
  if (d <= FLAT) return EAVE;
  const t = Math.min(1, (d - FLAT) / SPAN);
  return EAVE - 134 * Math.pow(t, 2.1);
};
const tilt = (x) => (Math.atan2(eaveY(x + 1) - eaveY(x - 1), 2) * 180) / Math.PI;
const f = (n) => +n.toFixed(1);
const STEP = 46;
const xs = [];
for (let x = (MID % STEP) - STEP; x <= W + STEP; x += STEP) xs.push(x);
const top = (x) => MID + (x - MID) * 0.8;
const BEAM = 252; // 창방 윗선
const BH = 38;    // 창방 높이
const SEG = 240;  // 창방 한 칸

const eavePts = (off = 0) => {
  const p = [];
  for (let x = -40; x <= W + 40; x += 8) p.push(`${x},${f(eaveY(x) + off)}`);
  return p;
};
const roofPath = `M-40 -10H${W + 40}L${eavePts(-2).reverse().join(' L')}Z`;

/* ── 연화(꽃잎 n장) ─────────────────────── */
const petals = (cx, cy, n, r1, r2, w, mode, fill) => {
  let s = '';
  for (let i = 0; i < n; i++) {
    const a = (i * 360) / n;
    s += `<ellipse cx="${cx}" cy="${f(cy - (r1 + r2) / 2)}" rx="${w}" ry="${f((r2 - r1) / 2)}" transform="rotate(${a} ${cx} ${cy})" ${
      mode === 'color' ? `fill="${fill}"` : `fill="none" stroke="${INK}" stroke-width=".7" stroke-opacity=".75"`
    }/>`;
  }
  return s;
};

/* 서까래 끝: 녹화(綠花) */
const rafter = (cx, cy, mode) => {
  const g = mode === 'color'
    ? `<circle cx="${cx}" cy="${cy}" r="12" fill="${C.green}"/><circle cx="${cx}" cy="${cy}" r="9.6" fill="${C.white}"/><circle cx="${cx}" cy="${cy}" r="8.4" fill="${C.blue}"/>${petals(cx, cy, 8, 2.4, 8, 2.2, 'color', C.pink)}${petals(cx, cy, 8, 2.4, 6, 1.4, 'color', C.red)}<circle cx="${cx}" cy="${cy}" r="2.4" fill="${C.gold}"/>`
    : `<circle cx="${cx}" cy="${cy}" r="12" fill="none" stroke="${INK}" stroke-width="1"/><circle cx="${cx}" cy="${cy}" r="8.6" fill="none" stroke="${INK}" stroke-width=".6" stroke-opacity=".6"/>${petals(cx, cy, 8, 2.4, 8, 2.2, 'line')}<circle cx="${cx}" cy="${cy}" r="2.2" fill="none" stroke="${INK}" stroke-width=".7"/>`;
  return `<g class="he-rot" data-cx="${cx}" data-cy="${cy}">${g}</g>`;
};

/* 부연 끝: 주화(朱花) 네모 */
const buyeon = (cx, cy, a, mode) => {
  const body = mode === 'color'
    ? `<rect x="-9" y="-9" width="18" height="18" fill="${C.blue}"/><rect x="-6.6" y="-6.6" width="13.2" height="13.2" fill="${C.sky}"/><path d="M0 -6L6 0L0 6L-6 0Z" fill="${C.white}"/>${petals(0, 0, 4, 0.8, 5, 1.8, 'color', C.red)}<circle r="1.6" fill="${C.gold}"/>`
    : `<rect x="-9" y="-9" width="18" height="18" fill="none" stroke="${INK}" stroke-width=".9"/><path d="M0 -6L6 0L0 6L-6 0Z" fill="none" stroke="${INK}" stroke-width=".6" stroke-opacity=".7"/><circle r="1.6" fill="none" stroke="${INK}" stroke-width=".6"/>`;
  return `<g transform="translate(${cx} ${cy}) rotate(${f(a)})">${body}</g>`;
};

/* 수막새: 연화문 */
const maksae = (cx, cy, mode) => {
  const g = mode === 'color'
    ? `<circle cx="${cx}" cy="${cy}" r="11.5" fill="${C.clay}"/><circle cx="${cx}" cy="${cy}" r="9" fill="${C.tileHi}"/>${petals(cx, cy, 8, 2.6, 8.4, 2, 'color', C.sky)}<circle cx="${cx}" cy="${cy}" r="2.4" fill="${C.gold}"/>`
    : `<circle cx="${cx}" cy="${cy}" r="11.5" fill="#F4F1EA" fill-opacity=".001" stroke="${INK}" stroke-width="1.1"/>${petals(cx, cy, 8, 2.6, 8.4, 2, 'line')}<circle cx="${cx}" cy="${cy}" r="2.2" fill="none" stroke="${INK}" stroke-width=".7"/>`;
  return `<g class="he-rot" data-cx="${cx}" data-cy="${cy}">${g}</g>`;
};

/* 창방 한 칸: 머리초(연화) + 휘(화살촉 띠) + 가운데 금문(비단 무늬) + 반대쪽 머리초 */
const beamSeg = (x0, mode) => {
  const y = BEAM, cy = BEAM + BH / 2;
  let s = '';
  const hwi = (xStart, dir) => {
    const cols = [C.blue, C.white, C.green, C.red];
    let o = '';
    for (let k = 0; k < 4; k++) {
      const xx = xStart + dir * k * 7;
      o += mode === 'color'
        ? `<path d="M${xx} ${y + 3}L${xx + dir * 8} ${cy}L${xx} ${y + BH - 3}L${xx + dir * 5} ${y + BH - 3}L${xx + dir * 13} ${cy}L${xx + dir * 5} ${y + 3}Z" fill="${cols[k]}"/>`
        : `<path d="M${xx} ${y + 3}L${xx + dir * 8} ${cy}L${xx} ${y + BH - 3}" fill="none" stroke="${INK}" stroke-width=".7" stroke-opacity=".7"/>`;
    }
    return o;
  };
  const rose = (cx) => {
    const g = mode === 'color'
      ? `<circle cx="${cx}" cy="${cy}" r="15" fill="${C.blue}"/><circle cx="${cx}" cy="${cy}" r="12.6" fill="${C.white}"/>${petals(cx, cy, 8, 3, 12, 3.4, 'color', C.red)}${petals(cx, cy, 8, 3, 8, 2, 'color', C.pink)}<circle cx="${cx}" cy="${cy}" r="3.4" fill="${C.gold}"/>`
      : `<circle cx="${cx}" cy="${cy}" r="15" fill="none" stroke="${INK}" stroke-width="1"/>${petals(cx, cy, 8, 3, 12, 3.4, 'line')}<circle cx="${cx}" cy="${cy}" r="3.2" fill="none" stroke="${INK}" stroke-width=".8"/>`;
    return `<g class="he-rot" data-cx="${cx}" data-cy="${cy}">${g}</g>`;
  };
  if (mode === 'color') s += `<rect x="${x0}" y="${y}" width="${SEG}" height="${BH}" fill="${C.green}"/>`;
  // 가운데 금문
  const gx = x0 + 92, gw = 56, gh = BH - 8;
  if (mode === 'color') {
    s += `<rect x="${gx}" y="${y + 4}" width="${gw}" height="${gh}" fill="${C.brown}"/>`;
    s += `<g clip-path="url(#heGum)">`;
    for (let i = -4; i < 8; i++) s += `<path d="M${gx + i * 8} ${y + 4}l${gh} ${gh}M${gx + i * 8 + gh} ${y + 4}l-${gh} ${gh}" stroke="${C.gold}" stroke-width=".8"/>`;
    s += `</g>`;
  } else {
    s += `<rect x="${gx}" y="${y + 4}" width="${gw}" height="${gh}" fill="none" stroke="${INK}" stroke-width=".8"/>`;
    for (let i = 0; i < 7; i++) { const l = Math.min(8 * (7 - i), gh); s += `<path d="M${gx + i * 8} ${y + 4}l${l} ${l}" stroke="${INK}" stroke-width=".5" stroke-opacity=".45"/>`; }
  }
  s += hwi(x0 + 50, 1) + hwi(x0 + SEG - 50, -1);
  s += rose(x0 + 28) + rose(x0 + SEG - 28);
  if (mode === 'line') s += `<path d="M${x0 + SEG} ${y}V${y + BH}" stroke="${INK}" stroke-width=".8"/>`;
  return s;
};

/* ── 한 장 그리기 ─────────────────────── */
const draw = (mode) => {
  const color = mode === 'color';
  let s = '';
  // 지붕 면 + 기와골
  if (color) {
    s += `<path d="${roofPath}" fill="${C.tile}"/>`;
    s += xs.map((x) => `<path d="M${f(x + (top(x) - x) * 0.35)} ${f(eaveY(x) - 110)}L${x} ${f(eaveY(x) - 8)}" stroke="${C.tileHi}" stroke-width="18"/>`).join('');
    s += `<path d="M${eavePts(0).join(' L')} L${eavePts(84).reverse().join(' L')}Z" fill="${C.green}" fill-opacity=".9"/>`;
  } else {
    s += `<g class="he-draw" style="--d:0s">` + xs.map((x) => `<path pathLength="1" d="M${f(x + (top(x) - x) * 0.35)} ${f(eaveY(x) - 100)}L${x} ${f(eaveY(x) - 12)}" stroke="${INK}" stroke-opacity=".3" stroke-width="1"/>`).join('') + `</g>`;
    s += `<g class="he-draw" style="--d:.3s"><path pathLength="1" d="M${eavePts().join(' L')}" stroke="${INK}" stroke-width="1.3"/></g>`;
  }
  // 암막새
  s += `<g class="${color ? '' : 'he-draw'}" style="--d:.55s">`;
  xs.forEach((x) => {
    const d = `M${x + 12} ${f(eaveY(x) + 3)}Q${x + STEP / 2} ${f((eaveY(x) + eaveY(x + STEP)) / 2 + 12)} ${x + STEP - 12} ${f(eaveY(x + STEP) + 3)}`;
    s += color ? `<path d="${d}" stroke="${C.clay}" stroke-width="5"/>` : `<path pathLength="1" d="${d}" stroke="${INK}" stroke-opacity=".6"/>`;
  });
  s += `</g>`;
  // 수막새
  s += `<g class="${color ? '' : 'he-fade'}" style="--d:.8s">` + xs.map((x) => maksae(x, f(eaveY(x)), mode)).join('') + `</g>`;
  // 부연 · 서까래
  s += `<g class="${color ? '' : 'he-fade'}" style="--d:1s">`;
  s += xs.map((x) => buyeon(x, f(eaveY(x) + 32), tilt(x), mode)).join('');
  s += xs.map((x) => { const cx = x + STEP / 2; return rafter(cx, f(eaveY(cx) + 62), mode); }).join('');
  s += `</g>`;
  // 창방
  s += `<g class="${color ? '' : 'he-fade'}" style="--d:1.2s">`;
  if (!color) s += `<path d="M-40 ${BEAM}H${W + 40}M-40 ${BEAM + BH}H${W + 40}" stroke="${INK}" stroke-width="1.1"/>`;
  for (let x0 = 0; x0 < W; x0 += SEG) s += beamSeg(x0, mode);
  if (color) s += `<path d="M-40 ${BEAM + 1.5}H${W + 40}M-40 ${BEAM + BH - 1.5}H${W + 40}" stroke="${C.red}" stroke-width="3"/>`;
  s += `</g>`;
  return s;
};
const colorSvg = draw('color');
const lineSvg = draw('line');
const gumRects = Array.from({ length: Math.ceil(W / SEG) }, (_, i) => i * SEG + 92);
---
<div class="hanok-eave" data-eave>
  <div class="he-stack">
    <svg class="he-svg he-color" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMin slice" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <defs><clipPath id="heGum">{gumRects.map((x) => <rect x={x} y={BEAM + 4} width="56" height={BH - 8} />)}</clipPath></defs>
      <Fragment set:html={colorSvg} />
    </svg>
    <svg class="he-svg he-line" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMin slice" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <Fragment set:html={lineSvg} />
      <!-- 풍경: 왼쪽 추녀 끝 -->
      <g class="he-pung" style="transform-origin:262px 104px">
        <path d="M262 104V128M252 146C252 134 256 128 262 128C268 128 272 134 272 146ZM249 146H275M262 146V160" stroke={INK} stroke-width="1" />
        <g class="he-fish" style="transform-origin:262px 160px">
          <path d="M262 160C268 164 268 174 262 180C256 174 256 164 262 160ZM262 180L258 186H266Z" fill="#B23A44" />
        </g>
      </g>
    </svg>
  </div>
  <p class="he-hint" aria-hidden="true">처마에 마우스를 대 보세요 — 단청이 피어납니다</p>
</div>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-eave]');
    if (!root) return;
    var stack = root.querySelector('.he-stack');
    var color = root.querySelector('.he-color');
    var line = root.querySelector('.he-line');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* 두 층의 연화 묶음을 짝지어 둔다 (같은 순서로 그려졌다) */
    var cRot = [].slice.call(color.querySelectorAll('.he-rot'));
    var roses = [].slice.call(line.querySelectorAll('.he-rot')).map(function (g, i) {
      return { a: g, b: cRot[i], x: +g.dataset.cx, y: +g.dataset.cy, ang: 0, s: 1 };
    });

    var target = null;   // 커서 위치 (SVG 좌표)
    var running = false;

    function setMask(px, py, r) {
      stack.style.setProperty('--mx', px + 'px');
      stack.style.setProperty('--my', py + 'px');
      if (r != null) stack.style.setProperty('--mr', r + 'px');
    }
    function toSvg(cx, cy) {
      var m = line.getScreenCTM();
      if (!m) return null;
      var p = line.createSVGPoint(); p.x = cx; p.y = cy;
      return p.matrixTransform(m.inverse());
    }

    /* 커서 가까운 연화가 돌며 커진다. 멀어지면 천천히 제자리로 */
    function tick() {
      var busy = false;
      roses.forEach(function (r) {
        var goalA = 0, goalS = 1;
        if (target) {
          var k = Math.max(0, 1 - Math.hypot(r.x - target.x, r.y - target.y) / 150);
          goalA = k * 90; goalS = 1 + k * 0.28;
        }
        r.ang += (goalA - r.ang) * 0.12;
        r.s += (goalS - r.s) * 0.14;
        if (Math.abs(goalA - r.ang) > 0.05 || Math.abs(goalS - r.s) > 0.002) busy = true;
        var tf = 'translate(' + r.x + ' ' + r.y + ') rotate(' + r.ang.toFixed(2) + ') scale(' + r.s.toFixed(3) + ') translate(' + -r.x + ' ' + -r.y + ')';
        r.a.setAttribute('transform', tf);
        r.b.setAttribute('transform', tf);
      });
      if (busy || target) requestAnimationFrame(tick); else running = false;
    }
    function kick() { if (!running && !reduce) { running = true; requestAnimationFrame(tick); } }

    function reveal(e) {
      var b = stack.getBoundingClientRect();
      setMask(e.clientX - b.left, e.clientY - b.top, b.width < 700 ? 90 : 130);
      target = toSvg(e.clientX, e.clientY);
      root.classList.add('is-touched');
      kick();
    }
    /* 마우스는 지나가기만 해도, 손가락은 톡 누르거나 가로로 쓸면 드러난다 */
    root.addEventListener('pointermove', reveal);
    root.addEventListener('pointerdown', reveal);
    root.addEventListener('pointerleave', function () {
      stack.style.setProperty('--mr', '0px');
      target = null;
      kick();
    });

    /* 인트로: 선이 다 그려지면 색이 처마를 왼쪽에서 오른쪽으로 한 번 훑는다 */
    if (!reduce) {
      setTimeout(function () {
        if (root.classList.contains('is-touched')) return;
        var b = stack.getBoundingClientRect();
        var t0 = performance.now(), dur = 2600;
        stack.classList.add('is-sweeping');
        (function step(now) {
          if (root.classList.contains('is-touched')) { stack.classList.remove('is-sweeping'); return; }
          var t = Math.min(1, (now - t0) / dur);
          var e = t < .5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
          var x = -120 + e * (b.width + 240);
          setMask(x, b.height * 0.62, 220 * Math.sin(Math.PI * t));
          target = t < 1 ? toSvg(b.left + x, b.top + b.height * 0.62) : null;
          kick();
          if (t < 1) requestAnimationFrame(step);
          else { stack.classList.remove('is-sweeping'); stack.style.setProperty('--mr', '0px'); }
        })(t0);
      }, 1700);
    }

    /* 스크롤하면 처마가 조금 늦게 따라 올라간다 */
    if (!reduce) {
      var ticking = false;
      window.addEventListener('scroll', function () {
        if (ticking) return; ticking = true;
        requestAnimationFrame(function () {
          stack.style.transform = 'translateY(' + (Math.min(window.scrollY, 600) * 0.12).toFixed(1) + 'px)';
          ticking = false;
        });
      }, { passive: true });
    }
  })();
</script>

<style>
  @property --mr { syntax: '<length>'; inherits: true; initial-value: 0px; }
  .hanok-eave { position: relative; width: 100%; height: clamp(170px, 23.6vw, 340px); cursor: crosshair; touch-action: pan-y; }
  .he-stack { position: absolute; inset: 0; --mx: -999px; --my: -999px; --mr: 0px; transition: --mr .45s cubic-bezier(0.22, 1, 0.36, 1); }
  .he-stack.is-sweeping { transition: none; }
  .he-svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; overflow: hidden; }

  /* 단청 채색층: 커서 둘레만 붓자국처럼 드러난다 (가장자리는 부드럽게) */
  .he-color {
    -webkit-mask-image: radial-gradient(circle var(--mr) at var(--mx) var(--my), #000 0%, #000 45%, rgba(0,0,0,.55) 70%, transparent 100%);
            mask-image: radial-gradient(circle var(--mr) at var(--mx) var(--my), #000 0%, #000 45%, rgba(0,0,0,.55) 70%, transparent 100%);
  }

  .he-hint {
    position: absolute; right: clamp(20px, 5vw, 48px); bottom: 0;
    font-family: var(--font-heading); font-size: 11px; letter-spacing: 0.08em; color: var(--color-text-tertiary);
    opacity: 0; animation: heFade .8s ease-out 4.6s forwards;
  }
  .hanok-eave.is-touched .he-hint { animation: none; opacity: 0; transition: opacity .4s; }
  @media (hover: none) { .he-hint { display: none; } }

  /* 선이 그려지며 나타난다 / 장식은 차례로 스민다 */
  .he-line :global(.he-draw path) {
    stroke-dasharray: 1; stroke-dashoffset: 1;
    animation: heDraw 1.4s cubic-bezier(0.65, 0, 0.35, 1) forwards;
    animation-delay: var(--d, 0s);
  }
  .he-line :global(.he-fade) { opacity: 0; animation: heFade .9s ease-out forwards; animation-delay: var(--d, 0s); }
  @keyframes heDraw { to { stroke-dashoffset: 0; } }
  @keyframes heFade { to { opacity: 1; } }

  .he-pung { transform-box: view-box; animation: heSway 5.4s ease-in-out 2s infinite; }
  .he-fish { transform-box: view-box; animation: heSway 2.6s ease-in-out 2.4s infinite; }
  @keyframes heSway { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(3deg); } }

  @media (prefers-reduced-motion: reduce) {
    .he-line :global(.he-draw path) { animation: none; stroke-dashoffset: 0; }
    .he-line :global(.he-fade) { animation: none; opacity: 1; }
    .he-pung, .he-fish { animation: none; }
    .he-hint { animation: none; opacity: 1; }
  }
</style>
