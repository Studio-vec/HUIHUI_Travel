---
import type { TripData } from '../lib/tripData';

export interface Props {
  data: TripData;
  /** 같은 여행지의 다른 버전으로 가는 탭 (여행지 페이지가 만들어 넘긴다) */
  variantSwitchHtml?: string;
}

const { data, variantSwitchHtml = '' } = Astro.props;
const dayCount = Math.max(...data.places.map((p) => p.day));
/* 태그 앞 이모지는 화면 장치에서 빼고 글만 쓴다 */
const plain = (s: string) => s.replace(/^[\p{Extended_Pictographic}\uFE0F\u200D\s]+/u, '');
const days = Array.from({ length: dayCount }, (_, i) => i + 1).map((day) => ({
  day,
  places: data.places.filter((p) => p.day === day),
}));
---

<article class="trip-article">
  <header class="ta-hero">
    <h1 class="ta-title" set:html={data.headerTitleHtml} />
    {variantSwitchHtml && <Fragment set:html={variantSwitchHtml} />}
    <div class="ta-chips">
      {data.tags.map((t) => <span class="ta-chip">{plain(t)}</span>)}
      {data.meta.map((m) => <span class="ta-chip ta-chip-meta">{plain(m)}</span>)}
    </div>
  </header>

  {data.operatorNote && (
    <blockquote class="ta-note">
      <div>
        <p class="ta-note-text">{data.operatorNote.text}</p>
        <p class="ta-note-name">— {data.operatorNote.name}</p>
      </div>
    </blockquote>
  )}

  {days.map(({ day, places }) => (
    <section class="ta-day">
      <h2 class="ta-day-title"><span class="ta-day-no">Day {day}</span><span class="ta-day-count">장소 {places.length}곳</span></h2>
      {places.map((p) => (
        <div class="ta-place">
          <div class="ta-place-head">
            <span class="ta-place-time">{p.time}</span>
            <h3 class="ta-place-name">{p.name}</h3>
            <span class={`place-tag tag-${p.theme_id}`}>{p.theme}</span>
            {((p.closedDays && p.closedDays.length > 0) || (p.closedLastWeekdays && p.closedLastWeekdays.length > 0) || p.closedNote) && (
              <span class="ta-closed">휴무 {[
                (p.closedDays || []).map((d) => '일월화수목금토'[d]).join('·'),
                ...(p.closedLastWeekdays || []).map((d) => `매월 마지막 ${'일월화수목금토'[d]}`),
                p.closedNote,
              ].filter(Boolean).join(' · ')}</span>
            )}
          </div>
          {p.desc && p.desc.map((para) => <p class="ta-place-desc">{para}</p>)}
          {p.details && p.details.length > 0 && (
            <table class="ta-place-details">
              <tbody>
                {p.details.map((d) => (
                  <tr>
                    <th>
                      {d.label}
                    </th>
                    <td>{d.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      ))}
    </section>
  ))}
</article>
