---
/**
 * 홈 히어로의 '기와집 프런트 데스크' 선화.
 * 밤(먹·쪽빛) 바탕에 흰 선으로 그린 기와집, 포인트는 연지·비취·금 세 가지만 쓴다.
 * 문살 창은 안에서 불이 켜진 것처럼 금빛으로 은은하게 빛난다.
 * 슬롯(default)으로 넘긴 요소는 오른쪽 처마 끝에 매달린다(오늘의 키).
 */
const W = 1200;
const LINE = '#E6E0D2';
const RED = '#B23A44';
const JADE = '#4F9F8A';
const GOLD = '#CFA94E';

// 처마선: 양 끝이 들린 곡선. 지붕면은 용마루(위)와 처마(아래) 사이
const eave = 'M140 150 C190 196 250 214 330 216 L870 216 C950 214 1010 196 1060 150';
const roof = `M372 96 L828 96 C880 120 960 140 1060 150 C1010 196 950 214 870 216 L330 216 C250 214 190 196 140 150 C240 140 320 120 372 96 Z`;
// 기와골: 처마를 따라 일정 간격으로 세로 골, 끝에는 둥근 막새
const tiles = [];
for (let x = 170; x <= 1030; x += 22) {
  const t = Math.abs(x - 600) / 460;                 // 0(가운데) ~ 1(끝)
  const yBottom = 216 - Math.pow(Math.max(0, t - 0.55) / 0.45, 2) * 62 * (t > 0.55 ? 1 : 0);
  const yTop = 96 + t * 52;
  tiles.push({ x, yTop, yBottom });
}
// 서까래 끝(단청 머리)
const rafters = [];
for (let x = 300; x <= 900; x += 30) rafters.push(x);
// 기둥과 칸
const cols = [292, 452, 748, 908];
const doorBays = [[310, 452], [766, 908]];
// 띠살문 살
const slats = (x0, x1) => {
  const out = [];
  const w = (x1 - x0 - 16) / 2;
  for (const d of [0, 1]) {
    const dx = x0 + 6 + d * (w + 4);
    for (let i = 1; i < 6; i++) out.push(`M${dx + (w * i) / 6} 286V448`);
    for (const y of [300, 316, 410, 426]) out.push(`M${dx} ${y}H${dx + w}`);
  }
  return out.join('');
};
// 점으로 찍은 구름 (가로 줄마다 길이를 달리한 점 띠)
const cloud = (cx, cy, rows) =>
  rows.map(([dx, len], r) => {
    const dots = [];
    for (let i = 0; i < len; i++) dots.push(`<circle cx="${cx + dx + i * 9}" cy="${cy + r * 9}" r="1.6"/>`);
    return dots.join('');
  }).join('');
---
<div class="hanok-front">
  <svg class="hanok-svg" viewBox={`0 0 ${W} 560`} fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="hfMoon" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color={LINE} stop-opacity=".16" />
        <stop offset="1" stop-color={LINE} stop-opacity="0" />
      </radialGradient>
      <linearGradient id="hfLamp" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#F6DFA6" stop-opacity=".95" />
        <stop offset="1" stop-color="#C98B3A" stop-opacity=".75" />
      </linearGradient>
      <linearGradient id="hfRoof" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2A3542" />
        <stop offset="1" stop-color="#1A222C" />
      </linearGradient>
      <linearGradient id="hfFloor" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#C98B3A" stop-opacity=".22" />
        <stop offset="1" stop-color="#C98B3A" stop-opacity="0" />
      </linearGradient>
      <clipPath id="hfRoofClip"><path d={roof} /></clipPath>
    </defs>

    <!-- 달과 동심원 -->
    <circle cx="600" cy="250" r="300" fill="url(#hfMoon)" />
    <g stroke={LINE} stroke-opacity=".14" stroke-width="1">
      <circle cx="600" cy="250" r="230" /><circle cx="600" cy="250" r="244" /><circle cx="600" cy="250" r="290" />
    </g>

    <!-- 점 구름 -->
    <g fill={LINE} fill-opacity=".28" class="hf-cloud hf-cloud-l">
      <Fragment set:html={cloud(40, 70, [[30, 8], [10, 14], [0, 20], [24, 12]])} />
    </g>
    <g fill={LINE} fill-opacity=".22" class="hf-cloud hf-cloud-r">
      <Fragment set:html={cloud(960, 40, [[20, 10], [0, 18], [36, 14]])} />
    </g>

    <!-- 기단 -->
    <path d="M232 470H968L992 500H208Z" fill="#1A222C" stroke={LINE} stroke-width="1.4" />
    <path d="M540 470V500M660 470V500M560 486H640" stroke={LINE} stroke-opacity=".5" stroke-width="1" />
    <rect x="300" y="458" width="600" height="80" fill="url(#hfFloor)" />

    <!-- 문살 창 (불 켜진 칸) -->
    {doorBays.map(([x0, x1]) => (
      <g>
        <rect x={x0} y={280} width={x1 - x0} height={174} fill="url(#hfLamp)" opacity=".85" />
        <path d={slats(x0, x1)} stroke="#5B3B1E" stroke-opacity=".55" stroke-width="1.6" />
        <rect x={x0} y={280} width={x1 - x0} height={174} stroke={LINE} stroke-width="1.4" />
        <path d={`M${(x0 + x1) / 2} 280V454`} stroke={LINE} stroke-width="1.4" />
      </g>
    ))}

    <!-- 가운데 칸: 프런트 데스크 -->
    <rect x="470" y="280" width="260" height="174" fill="#0F141B" />
    <rect x="470" y="280" width="260" height="174" fill="url(#hfLamp)" opacity=".12" />
    <!-- 데스크 위 종 -->
    <g class="hf-bell" stroke={GOLD} stroke-width="1.6">
      <path d="M584 394C584 380 592 372 600 372C608 372 616 380 616 394Z" fill={GOLD} fill-opacity=".35" />
      <path d="M580 395H620M600 366V372" />
      <circle cx="600" cy="364" r="2.4" fill={GOLD} />
    </g>
    <!-- 데스크 -->
    <path d="M486 398H714V454H486Z" fill="#1A222C" stroke={LINE} stroke-width="1.4" />
    <path d="M486 410H714" stroke={LINE} stroke-opacity=".6" stroke-width="1" />
    <g stroke={GOLD} stroke-opacity=".75" stroke-width="1">
      <path d="M520 422h40v22h-40zM640 422h40v22h-40z" />
      <path d="M532 433h16M652 433h16" />
    </g>

    <!-- 기둥 -->
    {cols.map((x) => (
      <g>
        <rect x={x} y={252} width={18} height={218} fill="#3A2420" stroke={LINE} stroke-width="1.4" />
        <rect x={x - 4} y={462} width={26} height={10} fill="#1A222C" stroke={LINE} stroke-width="1.2" />
      </g>
    ))}

    <!-- 창방(단청 띠) -->
    <rect x="270" y="232" width="660" height="22" fill="#1F4A40" stroke={LINE} stroke-width="1.4" />
    <path d="M270 238H930M270 248H930" stroke={JADE} stroke-width="1.6" />
    <g fill={RED} stroke={GOLD} stroke-width=".8">
      {[300, 380, 460, 540, 660, 740, 820, 900].map((x) => <circle cx={x} cy={243} r={4.2} />)}
    </g>
    <!-- 현판 -->
    <g class="hf-hyeonpan">
      <rect x="530" y="250" width="140" height="44" rx="2" fill="#1F3A33" stroke={GOLD} stroke-width="1.2" />
      <rect x="536" y="256" width="128" height="32" fill={RED} stroke={GOLD} stroke-width=".8" />
      <g transform="translate(548 259) scale(.26)" stroke={GOLD} stroke-width="9">
        <path d="M22 13H78M50 5V26M33 26H67M35 33H65A4 4 0 0 1 69 37V42A4 4 0 0 1 65 46H35A4 4 0 0 1 31 42V37A4 4 0 0 1 35 33ZM39 52L43.5 57M61 52L56.5 57M15 63H85M33 70H67A4 4 0 0 1 71 74V90A4 4 0 0 1 67 94H33A4 4 0 0 1 29 90V74A4 4 0 0 1 33 70Z" />
      </g>
      <text x="618" y="278" text-anchor="middle" fill="#F1E2B4" font-family="'Gowun Batang', serif" font-size="14" font-weight="700" letter-spacing="2">HUIHUI</text>
    </g>

    <!-- 서까래 끝 -->
    <g>
      {rafters.map((x) => (
        <g>
          <rect x={x - 5} y={218} width={10} height={12} fill="#1F4A40" stroke={LINE} stroke-width="1" />
          <circle cx={x} cy={224} r={2} fill={RED} />
        </g>
      ))}
    </g>

    <!-- 지붕 -->
    <path d={roof} fill="url(#hfRoof)" />
    <g clip-path="url(#hfRoofClip)" stroke={LINE} stroke-opacity=".32" stroke-width="1.1">
      {tiles.map(({ x, yTop }) => <path d={`M${x} ${yTop - 20}L${x + (x - 600) * 0.05} 230`} />)}
    </g>
    <path d={roof} stroke={LINE} stroke-width="1.6" />
    <!-- 막새 (처마 끝 둥근 기와) -->
    <g stroke={LINE} stroke-width="1.2" fill="#1A222C">
      {tiles.filter((t) => t.x > 200 && t.x < 1000).map(({ x }) => {
        const tt = Math.abs(x - 600) / 460;
        const y = tt > 0.6 ? 216 - Math.pow((tt - 0.6) / 0.4, 2) * 44 : 216;
        return <circle cx={x + (x - 600) * 0.05} cy={y} r={5.5} />;
      })}
    </g>
    <!-- 용마루 -->
    <path d="M350 98C360 82 372 80 384 86H816C828 80 840 82 850 98" stroke={LINE} stroke-width="2.2" />
    <path d="M384 86H816V96H384Z" fill="#2A3542" stroke={LINE} stroke-width="1.2" />
    <path d="M352 98C344 76 356 62 370 66M848 98C856 76 844 62 830 66" stroke={LINE} stroke-width="2" />

    <!-- 청사초롱 (왼쪽 처마 끝) -->
    <g class="hf-lantern">
      <path d="M150 158V238" stroke={LINE} stroke-width="1.2" />
      <rect x="138" y="238" width="24" height="7" rx="1.5" fill={RED} />
      <rect x="136" y="245" width="28" height="34" rx="4" fill={JADE} fill-opacity=".85" stroke={LINE} stroke-width="1" />
      <rect x="138" y="279" width="24" height="7" rx="1.5" fill={RED} />
      <rect x="140" y="250" width="20" height="24" fill="#F6DFA6" fill-opacity=".35" />
      <path d="M150 286V300M146 300H154" stroke={RED} stroke-width="2" />
    </g>
  </svg>
  <slot />
</div>

<style>
  .hanok-front { position: relative; width: 100%; max-width: 1200px; margin: 0 auto; aspect-ratio: 1200 / 560; }
  .hanok-svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .hf-cloud { animation: hfDrift 18s ease-in-out infinite alternate; }
  .hf-cloud-r { animation-duration: 24s; animation-direction: alternate-reverse; }
  .hf-lantern { transform-origin: 150px 158px; animation: hfSway 6s ease-in-out infinite; }
  @keyframes hfDrift { from { transform: translateX(-12px); } to { transform: translateX(14px); } }
  @keyframes hfSway { 0%, 100% { transform: rotate(-2.5deg); } 50% { transform: rotate(2.5deg); } }
  @media (prefers-reduced-motion: reduce) { .hf-cloud, .hf-lantern { animation: none; } }
</style>
