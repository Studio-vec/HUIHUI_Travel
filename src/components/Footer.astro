<style>
/* 에디토리얼 콜로폰: 굵은 먹 선 한 줄 + 가는 선 */
.hh-footer {
  padding: 40px clamp(20px, 5vw, 48px) 28px;
  border-top: 2px solid var(--color-text-primary);
  background: var(--color-bg);
}
.hh-footer-top {
  display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; flex-wrap: wrap;
  padding-bottom: 24px; border-bottom: 1px solid var(--color-rule);
}
.hh-footer-brand { display: flex; align-items: center; gap: 14px; }
.hh-footer-mark { display: block; }
.hh-footer-name {
  font-family: var(--font-display);
  font-size: 15px; font-weight: 700; letter-spacing: 0.04em; color: var(--color-text-primary);
}
.hh-footer-tagline { font-size: 12px; color: var(--color-text-tertiary); margin-top: 4px; }
.hh-footer-links { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
.hh-footer-link {
  display: inline-flex; align-items: center; min-height: 44px;
  font-size: 12px; font-weight: 500; color: var(--color-text-secondary);
  text-decoration: none; transition: color 0.15s;
}
.hh-footer-link:hover { color: var(--yeonji-600); }
.hh-footer-bottom {
  display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;
  padding-top: 16px; font-size: 11px; letter-spacing: 0.06em; color: var(--color-text-tertiary);
}
</style>
