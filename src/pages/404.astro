---
/**
 * 404 — 창호지 문
 * 찾는 방(페이지)은 비어 있다. 닫힌 창호 문의 한지를 손가락으로 콕콕 뚫어 안을 들여다보면,
 * 방 안에 '대신 가 볼 만한 여행지' 열쇠가 걸려 있다. 구멍을 다섯 개 내면 문이 스르르 열린다.
 *  - 한지는 <canvas> 한 장: 누른 자리를 destination-out 으로 찢어 낸다(가장자리는 들쭉날쭉 + 섬유 결)
 *  - 문살은 그 위 SVG, 방은 그 아래 HTML
 *  - 키보드·스크린리더 사용자는 '문 열기' 버튼과 아래 링크로 같은 곳에 갈 수 있다
 */
import fs from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { publicTrips } from '../lib/tripData';

const rooms = publicTrips()
  .filter((t) => fs.existsSync(`public/assets/keys/${t.id}.png`) || fs.existsSync(`public/assets/keys/${t.id}.webp`))
  .map((t) => ({
    url: `/trips/${t.id}`,
    key: `/assets/keys/${t.id}.webp`,
    name: t.shortNameKo || t.title,
    tagline: t.tagline || t.locationLabel || '',
  }));
const first = rooms[0];
---
<BaseLayout
  title="404 — 비어 있는 방 | Travel HUIHUI"
  description="찾으시는 페이지를 찾을 수 없습니다. 창호지 문 너머의 다른 여행지를 들여다보세요."
  noindex
  ads={false}
>
  <Navbar />

  <main class="nf" id="main">
    <div class="nf-inner">

      <div class="nf-grid">
        <div class="nf-copy">
          <h1 class="nf-title">이 방은<br />비어 있어요</h1>
          <p class="nf-desc">
            주소가 바뀌었거나 아직 짓지 않은 방이에요.<br />
            창호지에 손가락으로 <em>콕</em> 구멍을 내서 옆방을 들여다보세요.
          </p>
          <p class="nf-count" aria-live="polite" id="nfCount">구멍 0 / 5</p>
          <div class="nf-actions">
            <button type="button" class="nf-btn" id="nfOpen">문 열기</button>
            <a class="nf-link" href="/">홈으로 →</a>
            <a class="nf-link" href="/gallery">갤러리 →</a>
          </div>
        </div>

        <!-- 창호 문 -->
        <div class="door" id="door" data-open="false">
          <!-- 방 안 (문 뒤) -->
          <a class="room" id="room" href={first?.url ?? '/'} tabindex="-1">
            <span class="room-light" aria-hidden="true"></span>
            <span class="room-cord" aria-hidden="true"></span>
            <img class="room-key" id="roomKey" src={first?.key} alt="" width="416" height="1077" />
            <span class="room-cap">
              <span class="room-name" id="roomName">{first?.name}</span>
            </span>
          </a>

          <!-- 두 짝 문: 한지(canvas) + 문살(svg) -->
          {['l', 'r'].map((side) => (
            <div class={`leaf leaf-${side}`}>
              <canvas class="hanji" data-side={side} aria-hidden="true"></canvas>
              <svg class="sal" viewBox="0 0 100 260" preserveAspectRatio="none" aria-hidden="true">
                <!-- 띠살: 세로살 여섯 + 위·가운데·아래 가로살 묶음 -->
                <g stroke="#202943" stroke-width="2.4" vector-effect="non-scaling-stroke">
                  {[1, 2, 3, 4, 5].map((i) => <line x1={i * 100 / 6} y1="0" x2={i * 100 / 6} y2="260" />)}
                  {[22, 30, 38, 126, 134, 222, 230, 238].map((y) => <line x1="0" y1={y} x2="100" y2={y} />)}
                </g>
                <rect x="0" y="0" width="100" height="260" fill="none" stroke="#202943" stroke-width="6" vector-effect="non-scaling-stroke" />
              </svg>
              <span class="handle" aria-hidden="true"></span>
            </div>
          ))}
          <div class="door-frame" aria-hidden="true"></div>
        </div>
      </div>

      <!-- 손가락을 쓸 수 없는 경우를 위한 같은 길 -->
      <nav class="nf-more" aria-label="다른 여행지">
        <p class="hh-label">다른 방 둘러보기</p>
        <ul>
          {rooms.slice(0, 6).map((r) => (
            <li><a href={r.url}>{r.name}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script define:vars={{ rooms }}>
  window.__NF_ROOMS__ = rooms;
</script>
<script is:inline>
(function () {
  var rooms = window.__NF_ROOMS__ || [];
  var door = document.getElementById('door');
  var countEl = document.getElementById('nfCount');
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var NEED = 5;
  var holes = 0;

  /* 오늘 날짜로 고르는 옆방 (하루 종일 같은 방) */
  if (rooms.length) {
    var d = new Date();
    var doy = Math.floor((d - new Date(d.getFullYear(), 0, 0)) / 86400000);
    var r = rooms[doy % rooms.length];
    document.getElementById('room').href = r.url;
    document.getElementById('roomKey').src = r.key;
    document.getElementById('roomName').textContent = r.name;
  }

  /* 한지 한 장 그리기: 바탕색 + 닥섬유 결 */
  function paint(cv) {
    var rect = cv.getBoundingClientRect();
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.width = Math.round(rect.width * dpr);
    cv.height = Math.round(rect.height * dpr);
    var c = cv.getContext('2d');
    c.setTransform(dpr, 0, 0, dpr, 0, 0);
    c.globalCompositeOperation = 'source-over';
    c.fillStyle = '#F6F1E4';
    c.fillRect(0, 0, rect.width, rect.height);
    var seed = cv.dataset.side === 'l' ? 7 : 13;
    function rnd() { seed = (seed * 16807) % 2147483647; return seed / 2147483647; }
    c.lineCap = 'round';
    for (var i = 0; i < 260; i++) {
      var x = rnd() * rect.width, y = rnd() * rect.height, a = rnd() * Math.PI, l = 4 + rnd() * 16;
      c.strokeStyle = 'rgba(150,130,100,' + (0.05 + rnd() * 0.12) + ')';
      c.lineWidth = 0.4 + rnd() * 0.6;
      c.beginPath(); c.moveTo(x, y);
      c.quadraticCurveTo(x + Math.cos(a) * l * 0.5 + (rnd() - .5) * 4, y + Math.sin(a) * l * 0.5, x + Math.cos(a) * l, y + Math.sin(a) * l);
      c.stroke();
    }
    /* 구멍은 문짝 크기에 대한 비율로 저장해 두었다가, 크기가 바뀌면 새 크기에 맞춰 다시 낸다 */
    cv._holes && cv._holes.forEach(function (h) { tear(cv, h.x * rect.width, h.y * rect.height, h.r * rect.width, h.s, true); });
  }

  /* 찢긴 구멍: 들쭉날쭉한 원을 오려 내고, 가장자리에 말린 종이 테두리를 남긴다 */
  function tear(cv, x, y, r, s, replay) {
    var c = cv.getContext('2d');
    var n = 22, pts = [];
    var seed = s;
    function rnd() { seed = (seed * 16807) % 2147483647; return seed / 2147483647; }
    for (var i = 0; i < n; i++) {
      var a = (i / n) * Math.PI * 2;
      var rr = r * (0.72 + rnd() * 0.4);
      pts.push([x + Math.cos(a) * rr, y + Math.sin(a) * rr]);
    }
    function path(scale) {
      c.beginPath();
      pts.forEach(function (p, i) {
        var px = x + (p[0] - x) * scale, py = y + (p[1] - y) * scale;
        i ? c.lineTo(px, py) : c.moveTo(px, py);
      });
      c.closePath();
    }
    c.globalCompositeOperation = 'source-over';
    c.fillStyle = 'rgba(205,190,160,0.9)';
    path(1.18); c.fill();
    c.strokeStyle = 'rgba(120,100,70,0.35)'; c.lineWidth = 0.6;
    for (var k = 0; k < 14; k++) {
      var p = pts[(k * 3) % n];
      c.beginPath(); c.moveTo(p[0], p[1]);
      c.lineTo(x + (p[0] - x) * 1.35, y + (p[1] - y) * 1.35); c.stroke();
    }
    c.globalCompositeOperation = 'destination-out';
    path(1); c.fill();
    c.globalCompositeOperation = 'source-over';
    if (!replay) {
      var b = cv.getBoundingClientRect();
      (cv._holes = cv._holes || []).push({ x: x / b.width, y: y / b.height, r: r / b.width, s: s });
    }
  }

  var canvases = [].slice.call(door.querySelectorAll('.hanji'));
  function paintAll() { canvases.forEach(paint); }
  paintAll();
  var rt;
  window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(paintAll, 120); });

  function updateCount() {
    countEl.textContent = door.dataset.open === 'true' ? '문이 열렸어요' : '구멍 ' + Math.min(holes, NEED) + ' / ' + NEED;
  }

  function openDoor() {
    if (door.dataset.open === 'true') return;
    door.dataset.open = 'true';
    var room = document.getElementById('room');
    room.tabIndex = 0;
    updateCount();
    document.getElementById('nfOpen').textContent = '옆방으로 가기 →';
    if (!reduce) setTimeout(function () { room.focus({ preventScroll: true }); }, 900);
  }

  canvases.forEach(function (cv) {
    cv.addEventListener('pointerdown', function (e) {
      if (door.dataset.open === 'true') return;
      var b = cv.getBoundingClientRect();
      var x = e.clientX - b.left, y = e.clientY - b.top;
      tear(cv, x, y, Math.max(20, b.width * 0.15), Math.floor(Math.random() * 1e6) + 1);
      cv.parentNode.classList.remove('poke'); void cv.offsetWidth; cv.parentNode.classList.add('poke');
      holes++;
      updateCount();
      if (holes >= NEED) setTimeout(openDoor, reduce ? 0 : 650);
    });
  });

  document.getElementById('nfOpen').addEventListener('click', function () {
    if (door.dataset.open === 'true') location.href = document.getElementById('room').href;
    else openDoor();
  });
})();
</script>

<style is:global>
  .nf { min-height: calc(100vh - 60px); }
  .nf-inner {
    max-width: 1148px; margin: 0 auto;
    padding: clamp(24px, 4vw, 48px) clamp(20px, 5vw, 48px) clamp(48px, 7vw, 88px);
  }
  .nf-grid {
    display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(240px, 380px);
    gap: clamp(32px, 6vw, 96px); align-items: center;
    padding: clamp(32px, 5vw, 64px) 0;
    border-bottom: 1px solid var(--color-rule);
  }
  @media (max-width: 860px) { .nf-grid { grid-template-columns: 1fr; } .door { max-width: 380px; } }
  .nf-title, .nf-desc { word-break: keep-all; }

  .nf-title {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(44px, 7.4vw, 96px); line-height: 1.04; letter-spacing: -0.035em;
    color: var(--color-text-primary); margin: 14px 0 24px;
  }
  .nf-desc {
    font-family: var(--font-body); font-size: clamp(15px, 1.5vw, 18px); line-height: 1.85;
    color: var(--color-text-secondary); max-width: 30em;
  }
  .nf-desc em { font-style: normal; color: var(--yeonji-600); font-weight: 600; }
  .nf-count {
    margin-top: 24px; padding-top: 12px; border-top: 1px solid var(--color-rule); max-width: 240px;
    font-family: var(--font-heading); font-size: 12px; letter-spacing: 0.14em; color: var(--color-text-tertiary);
  }
  .nf-actions { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 20px; }
  .nf-btn {
    min-height: 44px; padding: 0 22px; border: none; border-radius: 2px; cursor: pointer;
    background: var(--color-text-primary); color: var(--color-bg);
    font-family: var(--font-heading); font-size: 13px; font-weight: 500; letter-spacing: 0.06em;
    transition: background var(--dur-fast);
  }
  .nf-btn:hover { background: var(--yeonji-500); }
  .nf-link {
    display: inline-flex; align-items: center; min-height: 44px;
    font-size: 13px; letter-spacing: 0.04em; color: var(--color-text-primary);
    text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; min-height: 0;
  }
  .nf-link:hover { color: var(--yeonji-600); }

  /* ── 창호 문 ── */
  .door {
    position: relative; width: calc(100% - 22px); aspect-ratio: 3 / 4;
    background: #0B0E1A; overflow: hidden;
    box-shadow: 0 0 0 10px #161C30, 0 0 0 11px var(--color-text-primary), 0 30px 60px -30px rgba(32,41,67,0.5);
    margin: 11px;
  }
  .door-frame { position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.6); }
  .leaf {
    position: absolute; top: 0; bottom: 0; width: 50%; z-index: 2;
    transition: transform 1.1s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .leaf-l { left: 0; }
  .leaf-r { right: 0; }
  .door[data-open="true"] .leaf-l { transform: translateX(-96%); }
  .door[data-open="true"] .leaf-r { transform: translateX(96%); }
  .hanji { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: crosshair; touch-action: manipulation; }
  .door[data-open="true"] .hanji { cursor: default; }
  .sal { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .handle {
    position: absolute; top: 50%; width: 10px; height: 26px; margin-top: -13px;
    border: 1.5px solid var(--geum-500); border-radius: 6px; background: rgba(176,138,52,0.15); pointer-events: none;
  }
  .leaf-l .handle { right: 10px; }
  .leaf-r .handle { left: 10px; }
  .leaf.poke { animation: nfPoke .28s ease-out; }
  @keyframes nfPoke { 30% { filter: brightness(.96); } }

  /* ── 방 안 ── */
  .room {
    position: absolute; inset: 0; z-index: 1;
    display: flex; flex-direction: column; align-items: center; justify-content: flex-start;
    padding-top: 5%; text-decoration: none; color: #F7F0E5;
    /* 방 안: 차콜 네이비에서 거의 검정으로, 단계 없이 부드럽게 */
    background:
      radial-gradient(120% 90% at 50% 34%, rgba(54,64,96,.55) 0%, rgba(32,41,67,.35) 30%, rgba(22,28,48,.15) 55%, rgba(10,12,22,0) 80%),
      linear-gradient(180deg, #1B2238 0%, #121729 60%, #0B0E1A 100%);
  }
  /* 열쇠 뒤 등잔빛: 가장자리를 여러 단계로 풀고 흐려서 테두리가 보이지 않게 */
  .room-light {
    position: absolute; left: 50%; top: 8%; width: 115%; aspect-ratio: 1; transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(246,223,166,.28) 0%, rgba(246,223,166,.18) 25%, rgba(246,223,166,.09) 48%, rgba(246,223,166,.035) 70%, rgba(246,223,166,0) 100%);
    filter: blur(8px); pointer-events: none;
  }
  .room-cord { width: 1px; height: 7%; background: var(--yeonji-400); position: relative; }
  .room-cord::after {
    content: ''; position: absolute; left: 50%; bottom: -5px; width: 9px; height: 9px;
    transform: translateX(-50%) rotate(45deg); border: 1.2px solid var(--yeonji-400); background: #1B2238;
  }
  .room-key { height: 70%; width: auto; margin-top: 6px; filter: drop-shadow(0 12px 20px rgba(0,0,0,.55)); transform-origin: 50% 0; animation: nfSway 4.6s ease-in-out infinite; }
  @keyframes nfSway { 0%, 100% { transform: rotate(-3deg); } 50% { transform: rotate(3deg); } }
  /* 아래 글은 작게: 번호와 지명만 */
  .room-cap { position: absolute; left: 0; right: 0; bottom: 4%; display: flex; align-items: baseline; justify-content: center; gap: 8px; }
  .room-name { font-family: var(--font-body); font-size: clamp(14px, 1.6vw, 17px); font-weight: 700; letter-spacing: -0.01em; }

  /* ── 아래 목록 ── */
  .nf-more { padding-top: 28px; }
  .nf-more ul { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 0 24px; margin-top: 12px; }
  .nf-more li { border-bottom: 1px solid var(--color-rule); }
  .nf-more a {
    display: flex; align-items: baseline; gap: 10px; min-height: 48px; padding: 12px 0;
    font-family: var(--font-display); font-size: 17px; font-weight: 600; color: var(--color-text-primary); text-decoration: none;
  }
  .nf-more a:hover { color: var(--yeonji-600); }

  @media (prefers-reduced-motion: reduce) {
    .leaf { transition: none; }
    .room-key, .leaf.poke { animation: none; }
  }
</style>
