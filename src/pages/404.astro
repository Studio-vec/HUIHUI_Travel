---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import type { TripData } from '../lib/tripData';

const tripModules = import.meta.glob('/trips/data/*.json', { eager: true }) as Record<
  string,
  { default: TripData }
>;
const trips = Object.values(tripModules)
  .map((mod) => mod.default)
  .filter((t) => !t.secretCode)
  .sort((a, b) => (a.no ?? 0) - (b.no ?? 0))
  .map((t) => ({
    id: t.id,
    no: String(t.no ?? 0).padStart(2, '0'),
    name: t.shortNameKo || t.title,
    nights: t.tags[t.tags.length - 1],
  }));
---
<BaseLayout
  title="404 — 없는 객실이에요 | HUIHUI Travel"
  description="찾으시는 페이지를 찾을 수 없습니다. 키카드를 태그하고 다른 여행지 객실로 이동해 보세요."
  noindex
  ads={false}
>
  <Navbar />

  <main class="nf" id="main" data-state="locked">
    <!-- ───────── 호텔 복도 장면 ───────── -->
    <section class="stage" id="stage" role="group"
      aria-label="호텔 객실 문 일러스트. 키카드를 문 옆 리더기에 태그하면 문이 열립니다.">
      <div class="far" aria-hidden="true">
        <div class="wall"></div>
        <div class="wainscot"></div>
        <div class="floor"><div class="runner"></div></div>
        <div class="sconce sc-l"></div>
        <div class="sconce sc-r"></div>
      </div>

      <div class="near">
        <!-- 객실 문 -->
        <div class="door" aria-hidden="true">
          <div class="plate"><span>404</span></div>
          <div class="frame">
            <div class="room">
              <div class="window">
                <div class="cloud c1"></div>
                <div class="cloud c2"></div>
                <svg class="plane" viewBox="0 0 48 24" aria-hidden="true">
                  <path d="M2 14 L20 12 L34 2 L38 3 L30 12 L44 11 C47 11 47 14 44 14 L30 14 L38 22 L34 23 L20 14 Z" fill="#7B5CC4"/>
                </svg>
              </div>
              <div class="suitcase"><i></i><b></b></div>
              <div class="room-floor"></div>
            </div>
            <div class="leaf">
              <span class="panel p1"></span>
              <span class="panel p2"></span>
              <span class="peep"></span>
              <span class="handle"></span>
              <span class="dnd"><i></i>💤</span>
            </div>
          </div>
          <div class="spill"></div>
        </div>

        <!-- 카드 리더기 -->
        <div class="reader" id="reader" aria-hidden="true">
          <i class="led"></i>
          <span class="slot" id="slot"></span>
          <em>TAP</em>
        </div>

        <!-- 탁자 두 개 -->
        <div class="table tb-l" aria-hidden="true"></div>
        <div class="table tb-r" aria-hidden="true"></div>

        <button class="bell" id="bell" type="button" aria-label="프런트 데스크 벨 누르기">
          <svg viewBox="0 0 40 32" aria-hidden="true">
            <path d="M6 26 C6 14 12 6 20 6 C28 6 34 14 34 26 Z" fill="#F0C060" stroke="#B0842A" stroke-width="1.6"/>
            <rect x="3" y="26" width="34" height="4" rx="2" fill="#B0842A"/>
            <circle cx="20" cy="4.5" r="2.6" fill="#B0842A"/>
            <path d="M12 13 C13 10 15 9 17 8.6" stroke="#fff" stroke-opacity=".7" stroke-width="1.6" fill="none" stroke-linecap="round"/>
          </svg>
        </button>

        <p class="hint" id="hint" aria-hidden="true"><span>키카드를</span> 드래그하거나 탭!</p>

        <!-- 키카드 -->
        <button class="card" id="card" type="button" aria-label="키카드를 리더기에 태그해서 문 열기">
          <span class="card-body">
            <span class="card-chip"></span>
            <span class="card-name">HUIHUI Travel</span>
            <span class="card-sub">KEY · 다른 여행지</span>
            <span class="card-stripe"></span>
          </span>
        </button>
      </div>
    </section>

    <!-- ───────── 안내 영역 ───────── -->
    <section class="info">
      <p class="eyebrow"><span data-locked>Room 404 · Not Found</span><span data-open>Check-in complete</span></p>
      <h1>
        <span data-locked>404호 객실은<br><em>없는 방</em>이에요</span>
        <span data-open>체크인 완료!<br><em>어느 객실</em>로 갈까요?</span>
      </h1>
      <p class="lead">
        <span data-locked>찾으시는 페이지가 옮겨졌거나 삭제됐어요. 문 옆 리더기에 키카드를 태그하면 다른 여행지 객실로 안내해 드릴게요.</span>
        <span data-open>아래 열쇠 중에서 마음에 드는 객실을 골라 보세요. 키 번호는 여행 기록 순서예요.</span>
      </p>

      <div class="folio">
        <div class="folio-h"><span>ROOM FOLIO</span><span>No. 404</span></div>
        <dl>
          <div><dt>요청한 객실</dt><dd class="path" id="req-path">/</dd></div>
          <div><dt>상태</dt><dd>객실 없음 · Not Found</dd></div>
          <div>
            <dt>안내</dt>
            <dd><span data-locked>키카드로 문을 열어 주세요</span><span data-open>체크인 완료 ✓</span></dd>
          </div>
        </dl>
        <div class="barcode" aria-hidden="true"></div>
      </div>

      <p class="say" id="say" aria-live="polite"></p>

      <div class="rack-wrap">
        <p class="rack-label"><span data-locked>🔒 잠긴 열쇠 걸이</span><span data-open>🔑 여행지 열쇠 걸이</span></p>
        <ul class="rack" id="rack">
          {trips.map((t, i) => (
            <li>
              <a class="tag" href={`/trips/${t.id}`} style={`--i:${i}`}>
                <span class="hole" aria-hidden="true"></span>
                <span class="tno">No.{t.no}</span>
                <span class="tname">{t.name}</span>
                <span class="tmeta">{t.nights}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="actions">
        <a class="btn primary" href="/">홈으로 체크인</a>
        <a class="btn ghost" href="/gallery">키 갤러리 보기</a>
        <button class="btn text" id="reset" type="button" hidden>다시 잠그기</button>
      </div>
    </section>
  </main>

  <Footer />

  <noscript>
    <style>
      .nf .tag { filter: none !important; opacity: 1 !important; }
      .nf [data-open] { display: none !important; }
    </style>
  </noscript>
</BaseLayout>

<style is:global>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: var(--color-bg); color: var(--color-text-primary); font-family: var(--font-body); }
  button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
  ul { list-style: none; }

  /* ── 레이아웃: 모바일(세로) 기본 → PC(가로 2단) ── */
  .nf {
    max-width: 1240px; margin: 0 auto;
    padding: clamp(16px, 3vw, 40px) clamp(16px, 5vw, 48px) clamp(32px, 6vw, 64px);
    display: grid; grid-template-columns: minmax(0, 1fr);
    gap: clamp(20px, 4vw, 56px); align-items: center;
    min-height: calc(100vh - 56px - 96px);
  }
  @media (min-width: 900px) {
    .nf { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: start; padding-top: clamp(20px, 3vw, 44px); }
  }

  /* 상태별 문구 전환 */
  .nf[data-state="locked"] [data-open],
  .nf[data-state="open"] [data-locked] { display: none; }

  /* ── 장면(stage) ── */
  .stage {
    position: relative; overflow: hidden; isolation: isolate;
    container-type: inline-size;
    width: 100%; max-width: 560px; margin: 0 auto;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-xl);
    background: var(--lavender-50);
    user-select: none; -webkit-user-select: none;
    /* 모바일(세로) 구도 */
    --floor-t: 83%; --wains-h: 22%;
    --door-l: 20%; --door-t: 19%; --door-w: 46%; --door-h: 64%;
    --rd-l: 71%; --rd-t: 33%; --rd-w: 24%; --rd-h: 22%;
    --tb-t: 76%; --tb-h: 14%;
    --tl-l: 3%; --tl-w: 15%; --tr-l: 68%; --tr-w: 28%;
    --card-l: 71%; --card-t: 65%; --card-w: 22%;
    --bell-l: 7.5%; --bell-t: 70%; --bell-w: 9%;
    --sl-l: 8%; --sl-t: 30%; --sr-l: 91%; --sr-t: 21%;
    --fs-plate: 8cqw; --fs-card: 3.1cqw; --fs-rd: 2.6cqw;
  }
  @media (min-width: 900px) {
    .stage {
      max-width: none; aspect-ratio: 5 / 4;
      /* 안내 영역이 길어도 장면은 첫 화면에 고정 */
      position: sticky; top: 76px; align-self: start;
      /* PC(가로) 구도 */
      --floor-t: 89%; --wains-h: 24%;
      --door-l: 27%; --door-t: 15%; --door-w: 34%; --door-h: 74%;
      --rd-l: 68%; --rd-t: 34%; --rd-w: 16%; --rd-h: 26%;
      --tb-t: 79%; --tb-h: 15%;
      --tl-l: 5%; --tl-w: 16%; --tr-l: 68%; --tr-w: 18%;
      --card-l: 70.5%; --card-t: 69%; --card-w: 13%;
      --bell-l: 9.5%; --bell-t: 72%; --bell-w: 7%;
      --sl-l: 17%; --sl-t: 30%; --sr-l: 92%; --sr-t: 30%;
      --fs-plate: 5.4cqw; --fs-card: 1.5cqw; --fs-rd: 1.3cqw;
    }
  }

  .far, .near { position: absolute; inset: 0; transition: transform .25s ease-out; }
  .far  { transform: translate3d(calc(var(--px, 0) * -6px), calc(var(--py, 0) * -4px), 0); }
  .near { transform: translate3d(calc(var(--px, 0) * 6px),  calc(var(--py, 0) * 4px), 0); }
  .stage.dragging .near { transition: none; }

  .wall {
    position: absolute; inset: -4%;
    background:
      radial-gradient(circle at 20px 20px, rgba(192,168,255,.20) 2px, transparent 3px) 0 0 / 40px 40px,
      linear-gradient(180deg, var(--lavender-50), #F9F3FF);
  }
  .wainscot {
    position: absolute; left: -4%; right: -4%;
    top: calc(var(--floor-t) - var(--wains-h)); height: var(--wains-h);
    background: linear-gradient(180deg, var(--lavender-100), var(--lavender-200));
    border-top: 3px solid var(--lavender-200);
  }
  .floor {
    position: absolute; left: -4%; right: -4%; top: var(--floor-t); bottom: -4%;
    background: linear-gradient(180deg, var(--lavender-300), var(--lavender-400));
  }
  .runner {
    position: absolute; left: calc(var(--door-l) + 4%); width: calc(var(--door-w) - 8%); top: 0; bottom: 0;
    background: repeating-linear-gradient(90deg, rgba(255,255,255,.25) 0 6px, transparent 6px 18px), var(--lavender-200);
    border-left: 4px solid var(--lime-300); border-right: 4px solid var(--lime-300);
  }

  /* 벽등 */
  .sconce {
    position: absolute; width: 5%; aspect-ratio: 1 / 1.5;
    background: linear-gradient(180deg, var(--sand-200), var(--sand-300));
    clip-path: polygon(22% 0, 78% 0, 100% 100%, 0 100%);
    transform: translate(-50%, 0);
  }
  .sc-l { left: var(--sl-l); top: var(--sl-t); }
  .sc-r { left: var(--sr-l); top: var(--sr-t); }
  .sconce::after {
    content: ''; position: absolute; left: 50%; top: 50%; width: 380%; aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(255,226,140,.65), rgba(255,226,140,0) 68%);
    animation: glow 4.2s ease-in-out infinite;
  }
  .sc-r::after { animation-delay: -1.7s; }
  @keyframes glow { 0%,100% { opacity: .85; } 40% { opacity: 1; } 55% { opacity: .62; } 70% { opacity: .95; } }

  /* ── 문 ── */
  .door {
    position: absolute; left: var(--door-l); top: var(--door-t); width: var(--door-w); height: var(--door-h);
  }
  .plate {
    position: absolute; left: 50%; bottom: 100%; margin-bottom: 1.2cqw; transform: translateX(-50%);
    padding: .15em .7em; border-radius: 8px;
    background: var(--sand-100); border: 2px solid var(--sand-400);
    box-shadow: 0 2px 0 var(--sand-500), 0 6px 14px rgba(42,31,72,.14);
  }
  .plate span {
    font-family: var(--font-display); font-style: italic; font-weight: 600;
    font-size: var(--fs-plate); line-height: 1.1; color: var(--lavender-700); letter-spacing: .04em;
  }
  .frame {
    position: absolute; inset: 0; perspective: 1400px;
    border: max(3px, .8cqw) solid var(--sand-400); border-bottom: 0;
    border-radius: 6px 6px 0 0; background: #2A1F48;
  }
  .room {
    position: absolute; inset: 0; overflow: hidden;
    background: linear-gradient(180deg, #FFF3D6, #FFE2A6);
  }
  .window {
    position: absolute; left: 14%; right: 14%; top: 12%; height: 38%; overflow: hidden;
    border: max(2px, .5cqw) solid var(--sand-400); border-radius: 4px;
    background: linear-gradient(180deg, #CFE3FF, var(--lime-50));
  }
  .cloud {
    position: absolute; height: 22%; width: 30%; border-radius: 99px; background: #fff; opacity: .9;
    animation: drift 26s linear infinite;
  }
  .cloud::before { content: ''; position: absolute; left: 18%; top: -45%; width: 46%; height: 150%; border-radius: 50%; background: inherit; }
  .c1 { top: 55%; left: -35%; }
  .c2 { top: 22%; left: -35%; width: 22%; animation-duration: 38s; animation-delay: -14s; opacity: .75; }
  @keyframes drift { to { transform: translateX(520%); } }
  .plane { position: absolute; left: -20%; top: 26%; width: 22%; animation: fly 9s ease-in-out infinite; }
  @keyframes fly {
    0% { transform: translate(0, 0) rotate(-4deg); }
    50% { transform: translate(300%, -22%) rotate(-8deg); }
    100% { transform: translate(600%, 8%) rotate(-2deg); }
  }
  .suitcase {
    position: absolute; left: 12%; bottom: 8%; width: 40%; height: 22%;
    background: var(--lavender-500); border-radius: 6px; box-shadow: inset 0 -4px 0 rgba(42,31,72,.2);
  }
  .suitcase::before { content: ''; position: absolute; left: 30%; right: 30%; top: -24%; height: 28%; border: 3px solid var(--lavender-700); border-bottom: 0; border-radius: 6px 6px 0 0; }
  .suitcase i { position: absolute; left: 14%; top: 22%; width: 22%; aspect-ratio: 1; border-radius: 50%; background: var(--lime-300); }
  .suitcase b { position: absolute; right: 14%; bottom: 18%; width: 26%; height: 18%; border-radius: 3px; background: var(--sand-100); transform: rotate(-8deg); }
  .room-floor { position: absolute; left: 0; right: 0; bottom: 0; height: 9%; background: var(--sand-300); }

  .leaf {
    position: absolute; inset: 0; transform-origin: left center; backface-visibility: hidden;
    background: linear-gradient(135deg, var(--lavender-400), var(--lavender-500));
    border-radius: 3px 3px 0 0;
    box-shadow: inset 0 0 0 max(2px, .4cqw) rgba(255,255,255,.18);
    transition: transform .95s var(--ease-in-out), filter .95s var(--ease-in-out);
  }
  .panel { position: absolute; left: 13%; right: 13%; border-radius: 3px; border: 1.5px solid rgba(255,255,255,.3); box-shadow: inset 0 0 0 3px rgba(78,52,144,.16); }
  .p1 { top: 7%; height: 36%; }
  .p2 { top: 52%; height: 38%; }
  .peep {
    position: absolute; left: 50%; top: 46%; width: 5%; aspect-ratio: 1; transform: translate(-50%, -50%);
    border-radius: 50%; background: radial-gradient(circle at 35% 35%, #fff, var(--sand-300) 40%, var(--sand-500));
    box-shadow: 0 0 0 max(1.5px, .3cqw) var(--sand-400);
  }
  .handle {
    position: absolute; right: 9%; top: 49%; width: 15%; height: 2.6%; border-radius: 99px;
    background: var(--lime-300); box-shadow: 0 2px 0 var(--lime-500);
  }
  .dnd {
    position: absolute; right: 8%; top: 52.5%; width: 17%; aspect-ratio: 1 / 1.7; transform-origin: 50% 0;
    display: flex; align-items: flex-end; justify-content: center; padding-bottom: 12%;
    background: var(--lime-200); border-radius: 3px 3px 6px 6px; font-size: 2.6cqw; line-height: 1;
    box-shadow: 0 3px 8px rgba(42,31,72,.2); animation: sway 3.4s ease-in-out infinite;
  }
  .dnd i { position: absolute; left: 50%; top: -2%; width: 30%; aspect-ratio: 1; border: 2px solid var(--lime-500); border-radius: 50%; transform: translateX(-50%); }
  @keyframes sway { 0%,100% { transform: rotate(-6deg); } 50% { transform: rotate(6deg); } }

  .stage.is-open .leaf { transform: rotateY(-74deg); filter: brightness(.82); }
  .stage.is-open .dnd { animation-play-state: paused; }

  .spill {
    position: absolute; left: 6%; right: 6%; top: 100%; height: 26%;
    background: linear-gradient(180deg, rgba(255,226,140,.85), rgba(255,226,140,0));
    clip-path: polygon(0 0, 100% 0, 128% 100%, -28% 100%);
    opacity: 0; transform-origin: top; transform: scaleY(.3);
    transition: opacity .9s var(--ease-out), transform .9s var(--ease-out);
  }
  .stage.is-open .spill { opacity: 1; transform: scaleY(1); }

  /* ── 카드 리더기 ── */
  .reader {
    position: absolute; left: var(--rd-l); top: var(--rd-t); width: var(--rd-w); height: var(--rd-h);
    display: flex; flex-direction: column; align-items: center; justify-content: space-between;
    padding: 9% 8% 7%; border-radius: 10px;
    background: linear-gradient(180deg, #3B2C63, var(--lavender-700));
    box-shadow: 0 6px 16px rgba(42,31,72,.28), inset 0 0 0 2px rgba(255,255,255,.08);
  }
  .led { width: 13%; aspect-ratio: 1; border-radius: 50%; background: var(--color-error); box-shadow: 0 0 10px var(--color-error); animation: blink 1.6s steps(2, end) infinite; }
  .reader.is-near .led { background: var(--color-warning); box-shadow: 0 0 12px var(--color-warning); animation: none; }
  .reader.ok .led { background: var(--lime-300); box-shadow: 0 0 14px 3px var(--lime-300); animation: none; }
  @keyframes blink { 50% { opacity: .25; } }
  .slot { width: 78%; height: 32%; border-radius: 6px; background: #1c1436; box-shadow: inset 0 2px 5px rgba(0,0,0,.6); transition: box-shadow .2s; }
  .reader.is-near .slot { box-shadow: inset 0 2px 5px rgba(0,0,0,.6), 0 0 0 2px var(--color-warning); }
  .reader em { font-family: var(--font-heading); font-style: normal; font-weight: 600; font-size: var(--fs-rd); letter-spacing: .2em; color: rgba(255,255,255,.55); }

  /* ── 탁자·벨 ── */
  .table {
    position: absolute; top: var(--tb-t); height: var(--tb-h);
    background:
      linear-gradient(var(--sand-500), var(--sand-500)) 0 0 / 100% 22% no-repeat,
      linear-gradient(var(--sand-600), var(--sand-600)) 10% 100% / 6% 78% no-repeat,
      linear-gradient(var(--sand-600), var(--sand-600)) 90% 100% / 6% 78% no-repeat;
    border-radius: 4px 4px 0 0;
    filter: drop-shadow(0 4px 4px rgba(42,31,72,.18));
  }
  .tb-l { left: var(--tl-l); width: var(--tl-w); }
  .tb-r { left: var(--tr-l); width: var(--tr-w); }

  .bell {
    position: absolute; left: var(--bell-l); top: var(--bell-t); width: var(--bell-w); aspect-ratio: 40 / 32;
    transform-origin: 50% 100%; border-radius: 8px;
  }
  .bell svg { width: 100%; height: 100%; display: block; overflow: visible; }
  .bell:focus-visible, .card:focus-visible, .tag:focus-visible, .btn:focus-visible {
    outline: 3px solid var(--lavender-500); outline-offset: 3px;
  }
  .bell.ring { animation: ring .7s ease-in-out; }
  @keyframes ring {
    0%,100% { transform: rotate(0) translateY(0); } 15% { transform: rotate(-14deg) translateY(-4px); }
    35% { transform: rotate(12deg) translateY(-2px); } 55% { transform: rotate(-8deg); } 75% { transform: rotate(5deg); }
  }

  /* ── 키카드 ── */
  .card {
    position: absolute; left: var(--card-l); top: var(--card-t); width: var(--card-w); aspect-ratio: 1.586;
    cursor: grab; touch-action: none; z-index: 5; border-radius: 8px;
    transform: translate(var(--dx, 0px), var(--dy, 0px)) rotate(var(--rot, -6deg)) scale(var(--sc, 1));
  }
  .card.grab { cursor: grabbing; --rot: 2deg; --sc: 1.08; }
  .card.snap { transition: transform .5s var(--ease-spring); }
  .stage.is-open .card { cursor: default; --rot: 0deg; --sc: .84; pointer-events: none; }
  .card-body {
    position: relative; display: block; width: 100%; height: 100%; border-radius: 8px; overflow: hidden;
    background: linear-gradient(135deg, var(--lavender-300), var(--lime-300));
    box-shadow: 0 8px 18px rgba(42,31,72,.28), inset 0 0 0 1.5px rgba(255,255,255,.5);
    animation: bob 3.2s ease-in-out infinite;
  }
  .card.grab .card-body, .stage.is-open .card-body { animation: none; }
  @keyframes bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5%); } }
  .card-chip { position: absolute; left: 9%; top: 26%; width: 17%; height: 20%; border-radius: 3px; background: linear-gradient(135deg, #F0D890, #C9A24A); }
  .card-name { position: absolute; left: 9%; bottom: 30%; font-family: 'DM Serif Display', var(--font-display); font-style: italic; font-size: var(--fs-card); color: #fff; text-shadow: 0 1px 2px rgba(42,31,72,.4); white-space: nowrap; }
  .card-sub { position: absolute; left: 9%; bottom: 14%; font-family: var(--font-heading); font-weight: 600; font-size: calc(var(--fs-card) * .7); letter-spacing: .08em; color: rgba(42,31,72,.7); white-space: nowrap; }
  .card-stripe { position: absolute; left: 0; right: 0; top: 8%; height: 12%; background: rgba(42,31,72,.55); }

  .hint {
    position: absolute; right: calc(100% - var(--card-l) + 1.5%); top: calc(var(--card-t) + 2%);
    padding: .5em .9em; border-radius: 99px; white-space: nowrap;
    background: #fff; box-shadow: var(--shadow-md);
    font-family: var(--font-heading); font-weight: 600; font-size: max(11px, calc(var(--fs-card) * .95)); color: var(--lavender-600);
    animation: nudge 1.8s ease-in-out infinite; transition: opacity .25s;
  }
  .hint span { color: var(--lavender-500); }
  .hint::after { content: ''; position: absolute; right: -5px; top: 50%; width: 10px; height: 10px; background: #fff; transform: translateY(-50%) rotate(45deg); }
  .hint.gone { opacity: 0; pointer-events: none; }
  @keyframes nudge { 0%,100% { transform: translateX(0); } 50% { transform: translateX(6px); } }

  /* ── 안내 영역 ── */
  .info { min-width: 0; }
  .eyebrow {
    font-family: var(--font-heading); font-size: var(--text-xs); font-weight: 600;
    letter-spacing: var(--tracking-widest); text-transform: uppercase; color: var(--lavender-500); margin-bottom: 12px;
  }
  .info h1 {
    font-family: var(--font-heading); font-weight: 600; letter-spacing: -0.03em; line-height: 1.16;
    font-size: clamp(30px, 5.4vw, 52px); color: var(--color-text-primary);
  }
  .info h1 em { font-style: normal; color: var(--lavender-500); background: linear-gradient(transparent 62%, var(--lime-200) 62%); }
  .lead { margin-top: 16px; max-width: 34em; font-size: var(--text-base); line-height: var(--leading-loose); color: var(--color-text-secondary); }

  .folio {
    margin-top: 24px; max-width: 460px; background: var(--color-surface);
    border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .folio-h {
    display: flex; justify-content: space-between; padding: 10px 16px;
    background: var(--lavender-100); color: var(--lavender-600);
    font-family: var(--font-heading); font-weight: 600; font-size: var(--text-xs); letter-spacing: var(--tracking-widest);
  }
  .folio dl { padding: 8px 16px 4px; }
  .folio dl > div { display: flex; justify-content: space-between; gap: 16px; padding: 8px 0; border-bottom: 1px dashed var(--sand-300); font-size: var(--text-sm); }
  .folio dl > div:last-child { border-bottom: 0; }
  .folio dt { color: var(--color-text-tertiary); flex-shrink: 0; }
  .folio dd { text-align: right; color: var(--color-text-primary); font-weight: 500; min-width: 0; }
  .folio .path { font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; font-size: 12px; word-break: break-all; color: var(--lavender-600); }
  .barcode { height: 22px; margin: 4px 16px 14px; background: repeating-linear-gradient(90deg, var(--color-text-primary) 0 2px, transparent 2px 4px, var(--color-text-primary) 4px 5px, transparent 5px 9px); opacity: .55; }

  .say {
    min-height: 1.6em; margin-top: 14px; font-size: var(--text-sm); color: var(--lavender-600); font-weight: 500;
  }
  .say.pop { animation: pop .35s var(--ease-spring); }
  @keyframes pop { from { transform: translateY(6px); opacity: 0; } to { transform: none; opacity: 1; } }

  /* ── 열쇠 걸이 ── */
  .rack-wrap { margin-top: 12px; }
  .rack-label { font-family: var(--font-heading); font-size: var(--text-xs); font-weight: 600; letter-spacing: var(--tracking-wider); color: var(--color-text-tertiary); margin-bottom: 10px; }
  .rack { display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 14px 10px; padding-top: 6px; }
  .tag {
    position: relative; display: block; padding: 22px 12px 12px; text-align: center; text-decoration: none;
    background: var(--color-surface); border: 1px solid var(--color-border-brand); border-radius: 6px 6px 14px 14px;
    color: var(--color-text-primary); box-shadow: var(--shadow-sm); transform-origin: 50% 0;
    transition: box-shadow .2s, background .2s, filter .4s, opacity .4s;
  }
  .tag::before { content: ''; position: absolute; left: 50%; top: -10px; width: 2px; height: 14px; background: var(--sand-500); transform: translateX(-50%); }
  .hole { position: absolute; left: 50%; top: 6px; width: 9px; height: 9px; border-radius: 50%; background: var(--sand-100); border: 2px solid var(--lavender-300); transform: translateX(-50%); }
  .tno { display: block; font-family: var(--font-heading); font-size: 12px; font-weight: 600; letter-spacing: .12em; color: var(--lavender-500); }
  .tname { display: block; margin-top: 3px; font-size: var(--text-md); font-weight: 500; }
  .tmeta { display: block; margin-top: 4px; font-size: 12px; color: var(--color-text-tertiary); }
  .rack:not(.is-open) .tag { filter: grayscale(1); opacity: .45; }
  .rack.is-open .tag:hover { background: var(--lime-50); box-shadow: var(--shadow-lime); }
  .rack.is-open .tag {
    animation:
      drop .75s var(--ease-spring) both calc(var(--i) * 70ms),
      swing 5s ease-in-out infinite calc(var(--i) * 70ms + .75s);
  }
  @keyframes drop { from { transform: translateY(-46px) rotate(-8deg); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes swing { 0%,100% { transform: rotate(-1.6deg); } 50% { transform: rotate(1.6deg); } }

  /* ── 버튼 ── */
  .actions { margin-top: 24px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 22px;
    border-radius: var(--radius-full); text-decoration: none; font-family: var(--font-heading); font-size: var(--text-sm); font-weight: 600;
    transition: transform .15s var(--ease-out), box-shadow .2s, background .2s, color .2s;
  }
  .btn:active { transform: scale(.97); }
  .btn.primary { background: var(--lavender-500); color: #fff; box-shadow: var(--shadow-brand); }
  .btn.primary:hover { background: var(--lavender-600); }
  .btn.ghost { border: 1.5px solid var(--lavender-300); color: var(--lavender-600); background: rgba(255,255,255,.6); }
  .btn.ghost:hover { background: var(--lavender-50); }
  .btn.text { color: var(--color-text-tertiary); padding: 0 10px; }
  .btn.text:hover { color: var(--lavender-600); }

  @media (max-width: 899px) {
    .info { text-align: left; }
    .rack { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sconce::after, .cloud, .plane, .dnd, .led, .card-body, .hint, .bell.ring, .say.pop,
    .rack.is-open .tag { animation: none !important; }
    .leaf, .spill, .far, .near, .card.snap { transition-duration: .01ms !important; }
  }
</style>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const nf = $('main'), stage = $('stage'), card = $('card') as HTMLButtonElement, reader = $('reader'), slot = $('slot');
  const rack = $('rack') as HTMLElement & { inert: boolean };
  const bell = $('bell'), say = $('say'), hint = $('hint'), reset = $('reset') as HTMLButtonElement, pathEl = $('req-path');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 요청한 경로 표시 (textContent로만 삽입)
  try { pathEl.textContent = decodeURIComponent(location.pathname + location.search).slice(0, 120) || '/'; }
  catch { pathEl.textContent = (location.pathname || '/').slice(0, 120); }

  rack.inert = true;

  let dx = 0, dy = 0, sx = 0, sy = 0, ox = 0, oy = 0, moved = 0;
  let dragging = false, opened = false, busy = false;

  const setPos = (x: number, y: number) => {
    dx = x; dy = y;
    card.style.setProperty('--dx', x + 'px');
    card.style.setProperty('--dy', y + 'px');
  };
  const center = (el: Element) => { const r = el.getBoundingClientRect(); return { x: r.left + r.width / 2, y: r.top + r.height / 2, w: r.width }; };
  const isNear = () => {
    const c = center(card), s = center(slot);
    return Math.hypot(c.x - s.x, c.y - s.y) < Math.max(s.w, c.w) * 0.9;
  };
  const snapToSlot = () => {
    const c = center(card), s = center(slot);
    setPos(dx + (s.x - c.x), dy + (s.y - c.y));
  };
  const withSnap = (fn: () => void) => {
    card.classList.add('snap'); fn();
    window.setTimeout(() => card.classList.remove('snap'), 560);
  };
  const speak = (msg: string) => {
    say.textContent = msg; say.classList.remove('pop'); void say.offsetWidth; say.classList.add('pop');
  };

  function unlock() {
    if (opened || busy) return;
    busy = true; hint.classList.add('gone');
    withSnap(snapToSlot);
    window.setTimeout(() => {
      opened = true; busy = false;
      reader.classList.add('ok');
      stage.classList.add('is-open');
      nf.dataset.state = 'open';
      rack.classList.add('is-open'); rack.inert = false;
      reset.hidden = false;
      speak('삑— 문이 열렸어요. 열쇠가 걸이에 내려왔습니다.');
      if (window.matchMedia('(max-width: 899px)').matches) {
        window.setTimeout(() => rack.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' }), 900);
      }
    }, reduce ? 0 : 430);
  }

  function relock() {
    opened = false;
    reader.classList.remove('ok');
    stage.classList.remove('is-open');
    nf.dataset.state = 'locked';
    rack.classList.remove('is-open'); rack.inert = true;
    reset.hidden = true; hint.classList.remove('gone');
    withSnap(() => setPos(0, 0));
    speak('다시 잠갔어요. 키카드를 한 번 더 태그해 보세요.');
  }

  card.addEventListener('pointerdown', (e) => {
    if (opened || busy) return;
    dragging = true; moved = 0; sx = e.clientX; sy = e.clientY; ox = dx; oy = dy;
    card.setPointerCapture(e.pointerId);
    card.classList.add('grab'); stage.classList.add('dragging'); hint.classList.add('gone');
  });
  card.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    const x = e.clientX - sx, y = e.clientY - sy;
    moved = Math.max(moved, Math.hypot(x, y));
    setPos(ox + x, oy + y);
    reader.classList.toggle('is-near', isNear());
  });
  const endDrag = (cancelled: boolean) => {
    if (!dragging) return;
    dragging = false;
    card.classList.remove('grab'); stage.classList.remove('dragging'); reader.classList.remove('is-near');
    if (!cancelled && (moved < 6 || isNear())) unlock();
    else { withSnap(() => setPos(0, 0)); hint.classList.remove('gone'); }
  };
  card.addEventListener('pointerup', () => endDrag(false));
  card.addEventListener('pointercancel', () => endDrag(true));
  // 키보드(Enter/Space)로 눌렀을 때만 (마우스·터치는 pointerup에서 처리)
  card.addEventListener('click', (e) => { if ((e as MouseEvent).detail === 0) unlock(); });
  reset.addEventListener('click', relock);

  // 프런트 데스크 벨
  const lines = [
    '딩동! 프런트: 그 객실 번호는 저희 호텔에 없어요.',
    '딩동! 프런트: 문 옆 리더기에 키카드를 대 보시겠어요?',
    '딩동! 프런트: 열쇠는 걸이에 있어요. 마음에 드는 방을 골라 보세요.',
  ];
  let bellN = 0;
  bell.addEventListener('click', () => {
    bell.classList.remove('ring'); void bell.offsetWidth; bell.classList.add('ring');
    speak(opened ? lines[2] : lines[bellN++ % 2]);
  });

  // 마우스 시차(패럴랙스)
  if (!reduce && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let raf = 0;
    const setP = (px: number, py: number) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => { stage.style.setProperty('--px', px.toFixed(3)); stage.style.setProperty('--py', py.toFixed(3)); });
    };
    stage.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || dragging) return;
      const r = stage.getBoundingClientRect();
      setP(((e.clientX - r.left) / r.width - 0.5) * 2, ((e.clientY - r.top) / r.height - 0.5) * 2);
    });
    stage.addEventListener('pointerleave', () => setP(0, 0));
  }

  // 열린 뒤 리사이즈(모바일↔PC 구도 전환)에도 카드를 리더기에 맞춰 둔다
  new ResizeObserver(() => {
    if (opened) { card.classList.remove('snap'); snapToSlot(); }
    else if (!dragging) setPos(0, 0);
  }).observe(stage);
</script>
