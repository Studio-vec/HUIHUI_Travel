---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';

---
<BaseLayout title="짐 싸기 — HUIHUI Travel">
  <Fragment slot="head">
  <link rel="stylesheet" href="/assets/css/tokens.css"/>
  </Fragment>
  <Navbar />


<!-- NAVBAR -->

<!-- ══ START ══ -->
<div class="screen active" id="screen-start">
  <div class="start-icon">🧳</div>
  <h1 class="start-title">짐 싸기</h1>
  <p class="start-sub">90초 안에 여행 가방을 최대한 꽉 채워보세요!</p>
  <div class="rules-card">
    <div class="rule"><span class="rule-ic">☝️</span><span>아이템을 드래그해서 가방 안에 놓으세요</span></div>
    <div class="rule"><span class="rule-ic">📐</span><span>아이템끼리 겹칠 수 없어요</span></div>
    <div class="rule"><span class="rule-ic">⏱</span><span>90초 안에 최대한 많이 채우세요</span></div>
    <div class="rule"><span class="rule-ic">🏆</span><span>빈 공간 없이 채울수록 고득점!</span></div>
  </div>

  <!-- 나만의 아이템 -->
  <div class="my-items-section">
    <div class="my-items-header">
      <span class="my-items-title">📷 나만의 여행 아이템</span>
      <button class="btn-add-item" onclick="openModal()">
        <span>+</span> 사진 추가
      </button>
    </div>
    <div class="my-items-grid" id="myItemsGrid">
      <p class="my-items-empty">여행지에서 찍은 사진을 누끼 따서<br>나만의 짐으로 만들어 보세요!</p>
    </div>
  </div>

  <div class="best-badge" id="bestBadge" style="display:none">🏆 최고 기록: <span id="bestTxt"></span>%</div>
  <button class="btn-primary" onclick="startGame()">짐 싸기 시작 →</button>
</div>

<!-- ══ GAME ══ -->
<div class="screen" id="screen-game">
  <div class="stats-bar">
    <div class="stat-box">
      <span class="stat-lbl">남은 시간</span>
      <span class="stat-val" id="timerVal">90</span>
    </div>
    <div class="timer-track"><div class="timer-fill" id="timerFill"></div></div>
    <div class="stat-box">
      <span class="stat-lbl">아이템</span>
      <span class="stat-val" id="itemVal">0/10</span>
    </div>
  </div>
  <div class="suitcase-scene">
    <div class="handle"></div>
    <div class="suitcase-body">
      <div class="clasp clasp-tl"></div><div class="clasp clasp-tr"></div>
      <div class="clasp clasp-bl"></div><div class="clasp clasp-br"></div>
      <div class="clasp clasp-mc"></div>
      <div class="grid-wrap">
        <div class="grid-inner">
          <div class="suitcase-grid" id="suitcaseGrid"></div>
          <div class="placed-layer" id="placedLayer"></div>
        </div>
      </div>
    </div>
  </div>
  <p class="tray-lbl">아래 짐을 드래그해서 가방에 넣으세요</p>
  <div class="item-tray" id="itemTray"></div>
  <button class="close-btn" onclick="endGame()">🔒 가방 닫기</button>
</div>

<!-- ══ RESULT ══ -->
<div class="screen" id="screen-result">
  <div class="result-emoji" id="resEmoji">🎉</div>
  <h2 class="result-title" id="resTitle">잘 했어요!</h2>
  <div class="result-score">
    채운 공간 <strong id="resPct">0%</strong>
    <span id="resItems"></span>
  </div>
  <div class="fill-bar-wrap">
    <div class="fill-bar-track"><div class="fill-bar-fill" id="resFill" style="width:0%"></div></div>
    <div class="fill-label"><span>0%</span><span>100%</span></div>
  </div>
  <div class="result-btns">
    <button class="btn-outline" onclick="location.href="/"">🏠 홈으로</button>
    <button class="btn-primary" onclick="startGame()">다시 도전 →</button>
  </div>
</div>

<!-- DRAG GHOST -->
<div id="ghost"></div>

<!-- ══ CUSTOM ITEM MODAL ══ -->
<div class="modal-backdrop" id="modal">
  <div class="modal-box">
    <div class="modal-title">📷 나만의 아이템 추가</div>

    <!-- STEP 1: Upload -->
    <div class="modal-step active" id="step-upload">
      <div class="drop-zone" id="dropZone" onclick="$('fileInput').click()">
        <div class="drop-zone-icon">🖼️</div>
        <div class="drop-zone-title">사진을 올려주세요</div>
        <div class="drop-zone-sub">클릭 또는 드래그 &amp; 드롭<br>JPG · PNG · WEBP</div>
      </div>
      <input type="file" id="fileInput" accept="image/*"/>
      <div class="modal-btns">
        <button class="btn-modal-cancel" onclick="closeModal()">취소</button>
      </div>
    </div>

    <!-- STEP 2: Processing -->
    <div class="modal-step" id="step-processing">
      <div class="processing-wrap active">
        <div class="spinner"></div>
        <div class="processing-label" id="processingLabel">AI가 배경을 지우는 중...</div>
        <div class="processing-sub">처음 사용 시 모델 로딩으로<br>약 10~20초 걸릴 수 있어요</div>
      </div>
    </div>

    <!-- STEP 3: Preview & name -->
    <div class="modal-step" id="step-preview">
      <div class="preview-wrap active">
        <div class="preview-canvas-wrap">
          <img id="previewImg" alt="누끼 결과" style="max-width:100%;max-height:200px;display:block;object-fit:contain;"/>
        </div>
        <div class="preview-label">배경이 자동으로 제거됐어요 ✨</div>
      </div>
      <div class="modal-field">
        <label>아이템 이름</label>
        <input class="modal-input" id="itemNameInput" type="text" maxlength="10" placeholder="예: 여수 거북선 기념품"/>
      </div>
      <div class="modal-field">
        <label>가방 안 크기 선택</label>
        <div class="size-picker">
          <div class="size-opt selected" data-w="1" data-h="1" onclick="selectSize(this)">
            <span class="size-opt-icon">🟫</span>
            <span class="size-opt-lbl">1 × 1</span>
            <span class="size-opt-sub">소형</span>
          </div>
          <div class="size-opt" data-w="2" data-h="1" onclick="selectSize(this)">
            <span class="size-opt-icon">🟫🟫</span>
            <span class="size-opt-lbl">2 × 1</span>
            <span class="size-opt-sub">가로형</span>
          </div>
          <div class="size-opt" data-w="1" data-h="2" onclick="selectSize(this)">
            <span class="size-opt-icon">📏</span>
            <span class="size-opt-lbl">1 × 2</span>
            <span class="size-opt-sub">세로형</span>
          </div>
          <div class="size-opt" data-w="2" data-h="2" onclick="selectSize(this)">
            <span class="size-opt-icon">⬛</span>
            <span class="size-opt-lbl">2 × 2</span>
            <span class="size-opt-sub">대형</span>
          </div>
        </div>
      </div>
      <div class="modal-btns">
        <button class="btn-modal-cancel" onclick="closeModal()">취소</button>
        <button class="btn-modal-confirm" id="confirmBtn" onclick="confirmCustomItem()">아이템으로 추가 →</button>
      </div>
    </div>
  </div>
</div>

<!-- ── ES MODULE: background removal ── -->
<script type="module">
  try {
    const { removeBackground } = await import('https://cdn.jsdelivr.net/npm/@imgly/background-removal@1.4.5/dist/browser.mjs');
    window._removeBackground = removeBackground;
    window._bgRemoveReady = true;
  } catch(e) {
    console.warn('background-removal 모듈 로드 실패:', e);
    window._bgRemoveReady = false;
  }
</script>

