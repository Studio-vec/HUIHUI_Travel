// ══════════════════════════════════════
//  CUSTOM ITEMS
// ══════════════════════════════════════
let customItems = [];
const LS_KEY = 'hh_custom_items';

function loadCustomItems() {
  try { customItems = JSON.parse(localStorage.getItem(LS_KEY) || '[]'); } catch { customItems = []; }
}
function saveCustomItems() {
  try { localStorage.setItem(LS_KEY, JSON.stringify(customItems)); } catch {}
}
function makeCustomRender(dataUrl) {
  return (W, H) => `<img class="custom-item-img" src="${dataUrl}" width="${W}" height="${H}" style="width:${W}px;height:${H}px"/>`;
}
function renderMyItemsGrid() {
  const grid = $('myItemsGrid');
  if (!customItems.length) {
    grid.innerHTML = '<p class="my-items-empty">여행지에서 찍은 사진을 누끼 따서<br>나만의 짐으로 만들어 보세요!</p>';
    return;
  }
  grid.innerHTML = '';
  customItems.forEach((ci, idx) => {
    const chip = document.createElement('div');
    chip.className = 'my-item-chip';
    chip.innerHTML = `<img class="my-item-thumb" src="${ci.dataUrl}" alt="${ci.name}"/><span>${ci.name}</span><span style="font-size:10px;color:var(--color-text-tertiary)">(${ci.w}×${ci.h})</span><button class="my-item-del" onclick="deleteCustomItem(${idx})" title="삭제">✕</button>`;
    grid.appendChild(chip);
  });
}
function deleteCustomItem(idx) {
  customItems.splice(idx, 1);
  saveCustomItems();
  renderMyItemsGrid();
}
function getAllItems() {
  const customs = customItems.map(ci => ({
    id:ci.id, name:ci.name, w:ci.w, h:ci.h,
    cells:rc(ci.w, ci.h),
    isCustom:true,
    render:makeCustomRender(ci.dataUrl)
  }));
  return [...BASE_ITEMS, ...customs];
}

// ══════════════════════════════════════
//  GAME STATE
// ══════════════════════════════════════
const COLS = 8, ROWS = 6, TOTAL_SEC = 90, GAP = 2;
let CS = 52;
let grid = [], placedCount = 0, timeLeft = 0, timerID = null;
let dragSt = null, gameOn = false;
let activeItems = [], currentScenario = null, placedItemIds = new Set();

function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  $(id).classList.add('active');
}
function cellSize() {
  const vw = window.innerWidth;
  if (vw < 400) return 34; if (vw < 520) return 40;
  if (vw < 640) return 46; return 52;
}

// ── SCENARIO GRID ──
function renderScenarioGrid() {
  $('scenarioGrid').innerHTML = SCENARIOS.map((s, i) => `
    <div class="scenario-card" onclick="selectScenario(${i})" style="--sc-bg:${s.color}">
      <div class="sc-key-wrap">
        <img class="sc-key-img" src="${s.keyImg}" alt="${s.title}" onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
        <div class="sc-emoji-fallback" style="display:none">${s.emoji}</div>
      </div>
      <div class="sc-info">
        <div class="sc-title">${s.title}</div>
        <div class="sc-detail">${s.detail}</div>
        <div class="sc-season">${s.season}</div>
      </div>
    </div>
  `).join('');
}

function selectScenario(idx) {
  currentScenario = SCENARIOS[idx];
  $('detailEmoji').innerHTML = `<img class="detail-key-img" src="${currentScenario.keyImg}" alt="${currentScenario.title}" onerror="this.outerHTML='<span>${currentScenario.emoji}</span>'">`;
  $('detailTitle').textContent = currentScenario.title;
  $('detailSub').textContent   = currentScenario.detail;
  $('detailSeason').textContent = currentScenario.season;
  $('detailHints').innerHTML   = currentScenario.hints.map(h=>`<div class="detail-hint">${h}</div>`).join('');
  showScreen('screen-detail');
}

// ── START ──
function startGame() {
  if (!currentScenario) return;
  CS = cellSize();

  const allItems = getAllItems();
  const poolIds  = currentScenario.itemPool;
  const poolItems = poolIds.map(id => allItems.find(i => i.id === id)).filter(Boolean);
  const customs   = allItems.filter(i => i.isCustom);
  activeItems = [...poolItems, ...customs];

  grid         = Array.from({length:ROWS}, () => Array(COLS).fill(null));
  placedCount  = 0;
  placedItemIds = new Set();
  timeLeft     = TOTAL_SEC;
  gameOn       = true;

  $('ghbEmoji').textContent  = currentScenario.emoji;
  $('ghbTitle').textContent  = currentScenario.title + ' · ' + currentScenario.detail;
  $('ghbChips').innerHTML    = currentScenario.hints.map(h=>`<span class="ghb-chip">${h}</span>`).join('');
  $('timerVal').textContent  = TOTAL_SEC;
  $('timerVal').classList.remove('urgent');
  $('timerFill').style.width = '100%';
  $('timerFill').style.background = 'var(--lavender-400)';
  $('itemVal').textContent   = `0/${activeItems.length}`;
  $('fmPct').textContent     = '0%';
  $('fmFill').style.width    = '0%';

  buildGrid(); buildTray();
  showScreen('screen-game');
  startTimer();
}

function buildGrid() {
  const g = $('suitcaseGrid');
  g.style.gridTemplateColumns = `repeat(${COLS},${CS}px)`;
  g.style.gridTemplateRows    = `repeat(${ROWS},${CS}px)`;
  g.style.gap = GAP+'px'; g.innerHTML = '';
  for (let r=0;r<ROWS;r++) for (let c=0;c<COLS;c++) {
    const cell = document.createElement('div');
    cell.className = 'grid-cell';
    cell.style.width = CS+'px'; cell.style.height = CS+'px';
    g.appendChild(cell);
  }
  const pl = $('placedLayer'); pl.innerHTML = '';
  pl.style.width  = (COLS*CS+(COLS-1)*GAP)+'px';
  pl.style.height = (ROWS*CS+(ROWS-1)*GAP)+'px';
}

function buildTray() {
  const tray = $('itemTray'); tray.innerHTML = '';
  activeItems.forEach(item => {
    const maxR = Math.max(...item.cells.map(c=>c[0]));
    const maxC = Math.max(...item.cells.map(c=>c[1]));
    const iW = (maxC+1)*CS + maxC*GAP;
    const iH = (maxR+1)*CS + maxR*GAP;
    const el = document.createElement('div');
    el.className = 'tray-item'; el.id = 'ti-'+item.id;
    el.style.width = iW+'px'; el.style.height = iH+'px';
    el.innerHTML = renderItemDisplay(item, item.cells, CS, GAP, 0) + `<div class="item-lbl">${item.name}</div>`;
    el.addEventListener('mousedown', e => beginDrag(e, item));
    el.addEventListener('touchstart', e => beginDrag(e, item), {passive:false});
    tray.appendChild(el);
  });
}

// ── TIMER ──
function startTimer() {
  clearInterval(timerID);
  timerID = setInterval(() => {
    timeLeft--;
    $('timerVal').textContent = timeLeft;
    $('timerFill').style.width = (timeLeft/TOTAL_SEC*100)+'%';
    if (timeLeft<=15) { $('timerVal').classList.add('urgent'); $('timerFill').style.background='#D94040'; }
    else if (timeLeft<=35) { $('timerFill').style.background='#E0A020'; }
    if (timeLeft<=0) endGame();
  }, 1000);
}

// ── FILL METER ──
function updateFillMeter() {
  let used = 0;
  for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++) if(grid[r][c]) used++;
  const pct = Math.round(used/(COLS*ROWS)*100);
  $('fmPct').textContent = pct+'%';
  $('fmFill').style.width = pct+'%';
  const color = pct < 40 ? 'var(--lavender-400)' : pct < 70 ? '#4CAF90' : '#F5A020';
  $('fmFill').style.background = color;
}

// ── END ──
function endGame() {
  clearInterval(timerID); gameOn = false;

  let usedCells = 0;
  for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++) if(grid[r][c]) usedCells++;
  const fillPct = Math.round(usedCells/(COLS*ROWS)*100);

  const basePoints = placedCount * 5;
  const effBonus   = Math.round(fillPct * 0.2);

  const allItems = getAllItems();
  let bonusPoints = 0;
  const bonusResults = [];
  for(const [itemId, info] of Object.entries(currentScenario.bonus)) {
    const packed = placedItemIds.has(itemId);
    const pts    = packed ? info.points : 0;
    bonusResults.push({ packed, pts, reason:info.reason, name:allItems.find(i=>i.id===itemId)?.name||itemId });
    bonusPoints += pts;
  }

  const total = basePoints + effBonus + bonusPoints;

  const bestKey = 'hh_pack_best_v2';
  const prev = parseInt(localStorage.getItem(bestKey)||'0');
  if(total > prev) localStorage.setItem(bestKey, total);
  $('bestTxt').textContent = Math.max(prev,total);
  $('bestBadge').style.display = '';

  let emoji='😅', title='아직 연습이 필요해요!';
  if(total>=180){emoji='🏆';title='짐 싸기 달인!';}
  else if(total>=120){emoji='🎉';title='훌륭한 짐 싸기!';}
  else if(total>=70) {emoji='👍';title='잘 했어요!';}

  $('resScenarioTag').innerHTML = `<span>${currentScenario.emoji}</span>&nbsp;${currentScenario.title} · ${currentScenario.detail}`;
  $('resEmoji').textContent   = emoji;
  $('resTitle').textContent   = title;
  $('resItemCount').textContent = placedCount;
  $('resBase').textContent    = `+${basePoints}점`;
  $('resPct').textContent     = fillPct;
  $('resEff').textContent     = `+${effBonus}점`;
  $('bonusHeader').textContent = `${currentScenario.emoji} 이 여행이라서 특별 점수!`;
  $('bonusList').innerHTML    = bonusResults.map((b, i) => `
    <div class="bonus-item ${b.packed?'packed':'missed'}" style="animation-delay:${0.35+i*0.10}s">
      <span class="bi-icon">${b.packed?'✅':'❌'}</span>
      <div class="bi-main"><span class="bi-name">${b.name}</span><span class="bi-reason">${b.packed?b.reason:'못 챙겼어요...'}</span></div>
      <span class="bi-pts">${b.packed?'+'+b.pts+'점':'+0점'}</span>
    </div>
  `).join('');
  $('resBonusTotal').textContent = `+${bonusPoints}점`;
  $('resFinalScore').textContent = '0점';
  $('resPctLbl').textContent  = fillPct+'% 채움';
  $('resItemsLbl').textContent = placedCount+'개 아이템';

  // 못 챙긴 보너스 아이템 → 여행 팁 섹션
  const missedItems = bonusResults.filter(b => !b.packed);
  if(missedItems.length > 0) {
    $('ttpList').innerHTML = missedItems.map(b =>
      `<div class="ttp-item"><span class="ttp-name">${b.name}</span><span class="ttp-reason">${b.reason}</span></div>`
    ).join('');
    $('travelTipSection').style.display = '';
  } else {
    $('travelTipSection').style.display = 'none';
  }

  // 여행 코스 페이지 링크
  const tripLink = $('resTripLink');
  tripLink.href = '/trips/' + currentScenario.id;
  tripLink.style.display = '';

  showScreen('screen-result');
  requestAnimationFrame(()=>{ $('resFill').style.width = fillPct+'%'; });
  setTimeout(() => animateScore(total), 300);
}

// ── SCORE ANIMATION ──
function animateScore(target) {
  const el = $('resFinalScore');
  const start = Date.now(), dur = 900;
  function tick() {
    const t = Math.min((Date.now()-start)/dur, 1);
    const eased = 1 - Math.pow(1-t, 3);
    el.textContent = Math.round(eased*target)+'점';
    if (t < 1) requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
}

// ── DRAG ──
function beginDrag(e, item) {
  if(!gameOn) return;
  const tEl = $('ti-'+item.id);
  if(tEl.classList.contains('placed')) return;
  e.preventDefault();
  const touch = e.type==='touchstart';
  const cx = touch?e.touches[0].clientX:e.clientX;
  const cy = touch?e.touches[0].clientY:e.clientY;

  const maxR = Math.max(...item.cells.map(c=>c[0]));
  const maxC = Math.max(...item.cells.map(c=>c[1]));
  const iW = (maxC+1)*CS + maxC*GAP;
  const iH = (maxR+1)*CS + maxR*GAP;

  const ghost = $('ghost');
  ghost.style.display='block'; ghost.style.width=iW+'px'; ghost.style.height=iH+'px';
  ghost.innerHTML = renderItemDisplay(item, item.cells, CS, GAP, 0);
  const ox = iW/2, oy = touch?iH+20:iH/2;
  ghost.style.left=(cx-ox)+'px'; ghost.style.top=(cy-oy)+'px';
  tEl.classList.add('dragging');

  dragSt = {
    item, tEl, ghost, ox, oy,
    currentCells: item.cells.map(c=>[...c]),
    rotation: 0
  };

  $('rotateBtnMobile').style.display = '';

  if(touch) { document.addEventListener('touchmove',onMove,{passive:false}); document.addEventListener('touchend',onDrop); }
  else { document.addEventListener('mousemove',onMove); document.addEventListener('mouseup',onDrop); }
}

function onMove(e) {
  if(!dragSt) return; e.preventDefault();
  const touch = e.type==='touchmove';
  const cx = touch?e.touches[0].clientX:e.clientX;
  const cy = touch?e.touches[0].clientY:e.clientY;
  dragSt.ghost.style.left=(cx-dragSt.ox)+'px';
  dragSt.ghost.style.top=(cy-dragSt.oy)+'px';
  highlightAt(cx,cy);
}

function onDrop(e) {
  if(!dragSt) return;
  const touch = e.type==='touchend';
  const cx = touch?e.changedTouches[0].clientX:e.clientX;
  const cy = touch?e.changedTouches[0].clientY:e.clientY;
  const placed = tryPlace(cx,cy);
  dragSt.ghost.style.display='none'; clearHL();
  if(!placed) dragSt.tEl.classList.remove('dragging');
  $('rotateBtnMobile').style.display='none';
  dragSt = null;
  document.removeEventListener('touchmove',onMove); document.removeEventListener('touchend',onDrop);
  document.removeEventListener('mousemove',onMove); document.removeEventListener('mouseup',onDrop);
}

// ── ROTATION ──
function rotateItem() {
  if(!dragSt) return;
  dragSt.rotation = (dragSt.rotation+1) % 4;

  const cells = dragSt.currentCells;
  const maxR  = Math.max(...cells.map(c=>c[0]));
  const rotated = cells.map(([r,c]) => [c, maxR-r]);
  const minR = Math.min(...rotated.map(c=>c[0]));
  const minC = Math.min(...rotated.map(c=>c[1]));
  dragSt.currentCells = rotated.map(([r,c]) => [r-minR, c-minC]);

  const maxRC = Math.max(...dragSt.currentCells.map(c=>c[0]));
  const maxCC = Math.max(...dragSt.currentCells.map(c=>c[1]));
  const iW = (maxCC+1)*CS + maxCC*GAP;
  const iH = (maxRC+1)*CS + maxRC*GAP;
  dragSt.ox = iW/2; dragSt.oy = iH/2;

  dragSt.ghost.style.width=iW+'px'; dragSt.ghost.style.height=iH+'px';
  dragSt.ghost.innerHTML = renderItemDisplay(dragSt.item, dragSt.currentCells, CS, GAP, dragSt.rotation);
}

document.addEventListener('keydown', e => {
  if((e.key==='r'||e.key==='R') && dragSt && gameOn) rotateItem();
});

function getSnap(cx,cy) {
  const rect = $('suitcaseGrid').getBoundingClientRect();
  const col = Math.round((cx-dragSt.ox-rect.left)/(CS+GAP));
  const row = Math.round((cy-dragSt.oy-rect.top)/(CS+GAP));
  return {row,col};
}
function canPlace(row, col, cells) {
  for(const [dr,dc] of cells) {
    const r=row+dr, c=col+dc;
    if(r<0||c<0||r>=ROWS||c>=COLS) return false;
    if(grid[r][c]) return false;
  }
  return true;
}
function highlightAt(cx,cy) {
  clearHL(); if(!dragSt) return;
  const {row,col} = getSnap(cx,cy);
  const cells = dragSt.currentCells;
  const valid = canPlace(row,col,cells);
  const gridCells = $('suitcaseGrid').querySelectorAll('.grid-cell');
  for(const [dr,dc] of cells) {
    const r=row+dr, c=col+dc;
    if(r>=0&&r<ROWS&&c>=0&&c<COLS) {
      const el = gridCells[r*COLS+c];
      if(el) el.classList.add(valid?'hv':'hi');
    }
  }
}
function clearHL() { $('suitcaseGrid').querySelectorAll('.grid-cell').forEach(c=>c.classList.remove('hv','hi')); }
function tryPlace(cx,cy) {
  const {item,tEl,currentCells,rotation} = dragSt;
  const {row,col} = getSnap(cx,cy);
  if(!canPlace(row,col,currentCells)) return false;

  for(const [dr,dc] of currentCells) grid[row+dr][col+dc] = item.id;

  const maxR = Math.max(...currentCells.map(c=>c[0]));
  const maxC = Math.max(...currentCells.map(c=>c[1]));
  const iW = (maxC+1)*CS+maxC*GAP;
  const iH = (maxR+1)*CS+maxR*GAP;

  const div = document.createElement('div');
  div.className = 'placed-item';
  div.style.left   = (col*(CS+GAP))+'px';
  div.style.top    = (row*(CS+GAP))+'px';
  div.style.width  = iW+'px';
  div.style.height = iH+'px';
  div.innerHTML    = renderItemDisplay(item, currentCells, CS, GAP, rotation);
  $('placedLayer').appendChild(div);

  tEl.classList.remove('dragging'); tEl.classList.add('placed');
  placedItemIds.add(item.id);
  placedCount++;
  $('itemVal').textContent = `${placedCount}/${activeItems.length}`;
  updateFillMeter();
  if(placedCount===activeItems.length) setTimeout(endGame,300);
  return true;
}

// ══════════════════════════════════════
//  CUSTOM ITEM MODAL
// ══════════════════════════════════════
let pendingDataUrl = null, selectedW = 1, selectedH = 1;
function openModal() {
  pendingDataUrl=null; selectedW=1; selectedH=1;
  goStep('upload'); $('itemNameInput').value=''; $('previewImg').removeAttribute('src');
  document.querySelectorAll('.size-opt').forEach(o=>o.classList.remove('selected'));
  document.querySelector('.size-opt[data-w="1"][data-h="1"]').classList.add('selected');
  $('modal').classList.add('open');
}
function closeModal() { $('modal').classList.remove('open'); }
function goStep(name) { document.querySelectorAll('.modal-step').forEach(s=>s.classList.remove('active')); $('step-'+name).classList.add('active'); }
function selectSize(el) {
  document.querySelectorAll('.size-opt').forEach(o=>o.classList.remove('selected'));
  el.classList.add('selected');
  selectedW=parseInt(el.dataset.w); selectedH=parseInt(el.dataset.h);
}
$('fileInput').addEventListener('change', e=>{const f=e.target.files[0];if(!f)return;$('fileInput').value='';processImage(f);});
const dz=$('dropZone');
dz.addEventListener('dragover',e=>{e.preventDefault();dz.classList.add('dragover');});
dz.addEventListener('dragleave',()=>dz.classList.remove('dragover'));
dz.addEventListener('drop',e=>{e.preventDefault();dz.classList.remove('dragover');const f=e.dataTransfer.files[0];if(f&&f.type.startsWith('image/'))processImage(f);});
async function processImage(file) {
  goStep('processing'); $('processingLabel').textContent='AI 모듈 로딩 중...';
  try {
    const resized=await resizeImage(file,800);
    const removeBg=await waitForRemoveBg();
    $('processingLabel').textContent='누끼 따는 중... ✂️';
    const resultBlob=await removeBg(resized,{publicPath:'https://cdn.jsdelivr.net/npm/@imgly/background-removal@1.4.5/dist/'});
    const dataUrl=await blobToDataUrl(resultBlob);
    const smallUrl=await compactDataUrl(dataUrl,240);
    pendingDataUrl=smallUrl; $('previewImg').src=smallUrl;
    $('step-preview').querySelector('.preview-label').textContent='배경이 자동으로 제거됐어요 ✨';
    goStep('preview');
  } catch(err) {
    console.warn('배경 제거 실패:',err.message);
    const reader=new FileReader();
    reader.onload=async ev=>{const small=await compactDataUrl(ev.target.result,240);pendingDataUrl=small;$('previewImg').src=small;$('step-preview').querySelector('.preview-label').textContent='📌 원본 이미지로 추가됩니다';goStep('preview');};
    reader.readAsDataURL(file);
  }
}
function waitForRemoveBg(timeout=12000){return new Promise((resolve,reject)=>{if(window._bgRemoveReady===true){resolve(window._removeBackground);return;}if(window._bgRemoveReady===false){reject(new Error('모듈 로드 실패'));return;}const start=Date.now();const check=()=>{if(window._bgRemoveReady===true){resolve(window._removeBackground);return;}if(window._bgRemoveReady===false){reject(new Error('모듈 로드 실패'));return;}if(Date.now()-start>timeout){reject(new Error('시간 초과'));return;}setTimeout(check,300);};setTimeout(check,300);});}
function resizeImage(file,maxPx){return new Promise(resolve=>{const url=URL.createObjectURL(file);const img=new Image();img.onload=()=>{const scale=Math.min(1,maxPx/Math.max(img.width,img.height));const canvas=document.createElement('canvas');canvas.width=Math.round(img.width*scale);canvas.height=Math.round(img.height*scale);canvas.getContext('2d').drawImage(img,0,0,canvas.width,canvas.height);URL.revokeObjectURL(url);canvas.toBlob(resolve,'image/jpeg',0.9);};img.src=url;});}
function blobToDataUrl(blob){return new Promise(resolve=>{const r=new FileReader();r.onload=e=>resolve(e.target.result);r.readAsDataURL(blob);});}
function compactDataUrl(dataUrl,maxPx){return new Promise(resolve=>{const img=new Image();img.onload=()=>{const scale=Math.min(1,maxPx/Math.max(img.width,img.height));const canvas=document.createElement('canvas');canvas.width=Math.round(img.width*scale);canvas.height=Math.round(img.height*scale);const ctx=canvas.getContext('2d');ctx.clearRect(0,0,canvas.width,canvas.height);ctx.drawImage(img,0,0,canvas.width,canvas.height);resolve(canvas.toDataURL('image/png'));};img.src=dataUrl;});}
function confirmCustomItem(){if(!pendingDataUrl)return;const name=$('itemNameInput').value.trim()||'내 아이템';const id='custom_'+Date.now();customItems.push({id,name,w:selectedW,h:selectedH,dataUrl:pendingDataUrl});saveCustomItems();renderMyItemsGrid();closeModal();}

// ══════════════════════════════════════
//  INIT
// ══════════════════════════════════════
(function init() {
  loadCustomItems();
  renderMyItemsGrid();
  renderScenarioGrid();
  const best = localStorage.getItem('hh_pack_best_v2');
  if(best){ $('bestTxt').textContent=best; $('bestBadge').style.display=''; }

  // URL 파라미터로 여행지 직접 진입 (?trip=gangneung)
  const params = new URLSearchParams(location.search);
  const tripId = params.get('trip');
  if(tripId) {
    const idx = SCENARIOS.findIndex(s => s.id === tripId);
    if(idx >= 0) selectScenario(idx);
  }
})();
</script>


