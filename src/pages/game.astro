    /* TRAY */
    .tray-lbl {
      font-size:11px; font-weight:600; letter-spacing:.1em; text-transform:uppercase;
      color:var(--color-text-tertiary);
    }
    .item-tray { display:flex; flex-wrap:wrap; justify-content:center; gap:10px; max-width:620px; width:100%; }
    .tray-item {
      cursor:grab; border-radius:9px; overflow:hidden; flex-shrink:0;
      box-shadow:0 4px 16px rgba(0,0,0,.16);
      transition:transform .15s, box-shadow .15s, opacity .2s; position:relative;
