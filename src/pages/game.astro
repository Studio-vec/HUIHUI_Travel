// ══════════════════════════════════════
//  CUSTOM ITEMS (from localStorage)
// ══════════════════════════════════════
let customItems = [];
const LS_KEY = 'hh_custom_items';

function loadCustomItems() {
  try {
    customItems = JSON.parse(localStorage.getItem(LS_KEY) || '[]');
  } catch { customItems = []; }
}
function saveCustomItems() {
  try { localStorage.setItem(LS_KEY, JSON.stringify(customItems)); } catch {}
}
function makeCustomRender(dataUrl) {
  return (W, H) =>
    `<img class="custom-item-img" src="${dataUrl}" width="${W}" height="${H}" style="width:${W}px;height:${H}px"/>`;
}
function renderMyItemsGrid() {
  const grid = $('myItemsGrid');
  if (!customItems.length) {
    grid.innerHTML = '<p class="my-items-empty">여행지에서 찍은 사진을 누끼 따서<br>나만의 짐으로 만들어 보세요!</p>';
    return;
  }
  grid.innerHTML = '';
  customItems.forEach((ci, idx) => {
    const chip = document.createElement('div');
    chip.className = 'my-item-chip';
    chip.innerHTML = `
      <img class="my-item-thumb" src="${ci.dataUrl}" alt="${ci.name}"/>
      <span>${ci.name}</span>
      <span style="font-size:10px;color:var(--color-text-tertiary)">(${ci.w}×${ci.h})</span>
      <button class="my-item-del" onclick="deleteCustomItem(${idx})" title="삭제">✕</button>
    `;
    grid.appendChild(chip);
  });
}
function deleteCustomItem(idx) {
  customItems.splice(idx, 1);
  saveCustomItems();
  renderMyItemsGrid();
}

// ══════════════════════════════════════
//  ALL ITEMS = base + custom
// ══════════════════════════════════════
function getAllItems() {
  const customs = customItems.map(ci => ({
    id: ci.id, name: ci.name, w: ci.w, h: ci.h,
    isCustom: true,
    render: makeCustomRender(ci.dataUrl)
  }));
  return [...BASE_ITEMS, ...customs];
}

// ══════════════════════════════════════
//  GAME STATE
// ══════════════════════════════════════
const COLS = 8, ROWS = 6, TOTAL_SEC = 90, GAP = 2;
let CS = 52;
let grid = [], placedCount = 0, timeLeft = 0, timerID = null;
let dragSt = null, gameOn = false;
let activeItems = [];

const $ = id => document.getElementById(id);
function showScreen(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  $(id).classList.add('active');
}
function cellSize() {
  const vw = window.innerWidth;
  if (vw < 400) return 34; if (vw < 520) return 40;
  if (vw < 640) return 46; return 52;
}

// ── START ──
function startGame() {
  CS = cellSize();
  activeItems = getAllItems();
  grid = Array.from({length:ROWS}, ()=>Array(COLS).fill(null));
  placedCount = 0; timeLeft = TOTAL_SEC; gameOn = true;
  $('timerVal').textContent = TOTAL_SEC;
  $('timerVal').classList.remove('urgent');
  $('timerFill').style.width = '100%';
  $('timerFill').style.background = 'var(--lavender-400)';
  $('itemVal').textContent = `0/${activeItems.length}`;
  buildGrid(); buildTray();
  showScreen('screen-game');
  startTimer();
}

function buildGrid() {
  const g = $('suitcaseGrid');
  g.style.gridTemplateColumns = `repeat(${COLS},${CS}px)`;
  g.style.gridTemplateRows    = `repeat(${ROWS},${CS}px)`;
  g.style.gap = GAP+'px'; g.innerHTML = '';
  for (let r=0;r<ROWS;r++) for (let c=0;c<COLS;c++) {
    const cell = document.createElement('div');
    cell.className='grid-cell'; cell.style.width=CS+'px'; cell.style.height=CS+'px';
    g.appendChild(cell);
  }
  const pl = $('placedLayer'); pl.innerHTML = '';
  pl.style.width  = (COLS*CS+(COLS-1)*GAP)+'px';
  pl.style.height = (ROWS*CS+(ROWS-1)*GAP)+'px';
}

function buildTray() {
  const tray = $('itemTray'); tray.innerHTML = '';
  activeItems.forEach(item => {
    const iW = item.w*CS+(item.w-1)*GAP;
    const iH = item.h*CS+(item.h-1)*GAP;
    const el = document.createElement('div');
    el.className='tray-item'; el.id='ti-'+item.id;
    el.style.width=iW+'px'; el.style.height=iH+'px';
    el.innerHTML = item.render(iW,iH) + `<div class="item-lbl">${item.name}</div>`;
    el.addEventListener('mousedown', e=>beginDrag(e,item));
    el.addEventListener('touchstart', e=>beginDrag(e,item), {passive:false});
    tray.appendChild(el);
  });
}

// ── TIMER ──
function startTimer() {
  clearInterval(timerID);
  timerID = setInterval(()=>{
    timeLeft--;
    $('timerVal').textContent = timeLeft;
    $('timerFill').style.width = (timeLeft/TOTAL_SEC*100)+'%';
    if (timeLeft<=15){ $('timerVal').classList.add('urgent'); $('timerFill').style.background='#D94040'; }
    else if (timeLeft<=35){ $('timerFill').style.background='#E0A020'; }
    if (timeLeft<=0) endGame();
  }, 1000);
}

// ── END ──
function endGame() {
  clearInterval(timerID); gameOn = false;
  let used=0;
  for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++) if(grid[r][c]) used++;
  const pct = Math.round(used/(COLS*ROWS)*100);
  const prev = parseInt(localStorage.getItem('hh_pack_best')||'0');
  const best = Math.max(prev,pct);
  localStorage.setItem('hh_pack_best', best);
  $('bestTxt').textContent=best; $('bestBadge').style.display='';
  let emoji='😅', title='아직 연습이 필요해요!';
  if(pct>=85){emoji='🏆';title='완벽한 짐싸기!';}
  else if(pct>=65){emoji='🎉';title='잘 했어요!';}
  else if(pct>=45){emoji='👍';title='꽤 잘 쌌네요!';}
  $('resEmoji').textContent=emoji; $('resTitle').textContent=title;
  $('resPct').textContent=pct+'%';
  $('resItems').textContent=`(${placedCount}개 아이템 완료)`;
  showScreen('screen-result');
  requestAnimationFrame(()=>{ $('resFill').style.width=pct+'%'; });
}

// ── DRAG ──
function beginDrag(e,item) {
  if(!gameOn) return;
  const tEl=$('ti-'+item.id);
  if(tEl.classList.contains('placed')) return;
  e.preventDefault();
  const touch=e.type==='touchstart';
  const cx=touch?e.touches[0].clientX:e.clientX;
  const cy=touch?e.touches[0].clientY:e.clientY;
  const iW=item.w*CS+(item.w-1)*GAP, iH=item.h*CS+(item.h-1)*GAP;
  const ghost=$('ghost');
  ghost.style.display='block'; ghost.style.width=iW+'px'; ghost.style.height=iH+'px';
  ghost.innerHTML = item.render(iW,iH);
  const ox=iW/2, oy=touch?iH+20:iH/2;
  ghost.style.left=(cx-ox)+'px'; ghost.style.top=(cy-oy)+'px';
  tEl.classList.add('dragging');
  dragSt={item,tEl,ghost,ox,oy};
  if(touch){ document.addEventListener('touchmove',onMove,{passive:false}); document.addEventListener('touchend',onDrop); }
  else { document.addEventListener('mousemove',onMove); document.addEventListener('mouseup',onDrop); }
}
function onMove(e) {
  if(!dragSt) return; e.preventDefault();
  const touch=e.type==='touchmove';
  const cx=touch?e.touches[0].clientX:e.clientX;
  const cy=touch?e.touches[0].clientY:e.clientY;
  dragSt.ghost.style.left=(cx-dragSt.ox)+'px';
  dragSt.ghost.style.top=(cy-dragSt.oy)+'px';
  highlightAt(cx,cy);
}
function onDrop(e) {
  if(!dragSt) return;
  const touch=e.type==='touchend';
  const cx=touch?e.changedTouches[0].clientX:e.clientX;
  const cy=touch?e.changedTouches[0].clientY:e.clientY;
  const placed=tryPlace(cx,cy);
  dragSt.ghost.style.display='none'; clearHL();
  if(!placed) dragSt.tEl.classList.remove('dragging');
  dragSt=null;
  document.removeEventListener('touchmove',onMove); document.removeEventListener('touchend',onDrop);
  document.removeEventListener('mousemove',onMove); document.removeEventListener('mouseup',onDrop);
}
function getSnap(cx,cy) {
  const rect=$('suitcaseGrid').getBoundingClientRect();
  const {item,ox,oy}=dragSt;
  const col=Math.round((cx-ox-rect.left)/(CS+GAP));
  const row=Math.round((cy-oy-rect.top)/(CS+GAP));
  return {row,col};
}
function canPlace(row,col,w,h) {
  if(row<0||col<0||row+h>ROWS||col+w>COLS) return false;
  for(let r=row;r<row+h;r++) for(let c=col;c<col+w;c++) if(grid[r][c]) return false;
  return true;
}
function highlightAt(cx,cy) {
  clearHL(); if(!dragSt) return;
  const {row,col}=getSnap(cx,cy); const {item}=dragSt;
  const valid=canPlace(row,col,item.w,item.h);
  const cells=$('suitcaseGrid').querySelectorAll('.grid-cell');
  for(let r=row;r<row+item.h;r++) for(let c=col;c<col+item.w;c++) {
    if(r>=0&&r<ROWS&&c>=0&&c<COLS) { const idx=r*COLS+c; if(cells[idx]) cells[idx].classList.add(valid?'hv':'hi'); }
  }
}
function clearHL() { $('suitcaseGrid').querySelectorAll('.grid-cell').forEach(c=>c.classList.remove('hv','hi')); }
function tryPlace(cx,cy) {
  const {item,tEl}=dragSt; const {row,col}=getSnap(cx,cy);
  if(!canPlace(row,col,item.w,item.h)) return false;
  for(let r=row;r<row+item.h;r++) for(let c=col;c<col+item.w;c++) grid[r][c]=item.id;
  const iW=item.w*CS+(item.w-1)*GAP, iH=item.h*CS+(item.h-1)*GAP;
  const div=document.createElement('div');
  div.className='placed-item';
  div.style.left=(col*(CS+GAP))+'px'; div.style.top=(row*(CS+GAP))+'px';
  div.style.width=iW+'px'; div.style.height=iH+'px';
  div.innerHTML=item.render(iW,iH);
  $('placedLayer').appendChild(div);
  tEl.classList.remove('dragging'); tEl.classList.add('placed');
  placedCount++;
  $('itemVal').textContent=`${placedCount}/${activeItems.length}`;
  if(placedCount===activeItems.length) setTimeout(endGame,300);
  return true;
}

// ══════════════════════════════════════
//  CUSTOM ITEM MODAL
// ══════════════════════════════════════
let pendingDataUrl = null;
let selectedW = 1, selectedH = 1;

function openModal() {
  pendingDataUrl = null; selectedW=1; selectedH=1;
  goStep('upload');
  $('itemNameInput').value = '';
  $('previewImg').removeAttribute('src');
  document.querySelectorAll('.size-opt').forEach(o=>o.classList.remove('selected'));
  document.querySelector('.size-opt[data-w="1"][data-h="1"]').classList.add('selected');
  $('modal').classList.add('open');
}
function closeModal() { $('modal').classList.remove('open'); }
function goStep(name) {
  document.querySelectorAll('.modal-step').forEach(s=>s.classList.remove('active'));
  $('step-'+name).classList.add('active');
}
function selectSize(el) {
  document.querySelectorAll('.size-opt').forEach(o=>o.classList.remove('selected'));
  el.classList.add('selected');
  selectedW = parseInt(el.dataset.w);
  selectedH = parseInt(el.dataset.h);
}

// file input
$('fileInput').addEventListener('change', e => {
  const file = e.target.files[0]; if (!file) return;
  $('fileInput').value = '';
  processImage(file);
});

// drag-drop onto drop zone
const dz = $('dropZone');
dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('dragover'); });
dz.addEventListener('dragleave', () => dz.classList.remove('dragover'));
dz.addEventListener('drop', e => {
  e.preventDefault(); dz.classList.remove('dragover');
  const file = e.dataTransfer.files[0];
  if (file && file.type.startsWith('image/')) processImage(file);
});

async function processImage(file) {
  goStep('processing');
  $('processingLabel').textContent = 'AI 모듈 로딩 중...';

  try {
    // 1. resize to max 800px for speed
    const resized = await resizeImage(file, 800);

    // 2. wait for module, then remove background
    const removeBg = await waitForRemoveBg();
    $('processingLabel').textContent = '누끼 따는 중... ✂️';

    const resultBlob = await removeBg(resized, {
      publicPath: 'https://cdn.jsdelivr.net/npm/@imgly/background-removal@1.4.5/dist/'
    });

    // 3. compact for storage
    const dataUrl = await blobToDataUrl(resultBlob);
    const smallUrl = await compactDataUrl(dataUrl, 240);

    pendingDataUrl = smallUrl;
    $('previewImg').src = smallUrl;
    $('step-preview').querySelector('.preview-label').textContent = '배경이 자동으로 제거됐어요 ✨';
    goStep('preview');

  } catch (err) {
    console.warn('배경 제거 실패, 원본 사용:', err.message);
    // fallback: original image, no bg removal
    $('processingLabel').textContent = '원본 이미지로 진행합니다...';
    const reader = new FileReader();
    reader.onload = async (ev) => {
      const small = await compactDataUrl(ev.target.result, 240);
      pendingDataUrl = small;
      $('previewImg').src = small;
      $('step-preview').querySelector('.preview-label').textContent = '📌 배경 제거 없이 원본 이미지로 추가됩니다';
      goStep('preview');
    };
    reader.readAsDataURL(file);
  }
}

function waitForRemoveBg(timeout=12000) {
  return new Promise((resolve, reject) => {
    // 모듈이 이미 로드됐거나 실패 확정된 경우
    if (window._bgRemoveReady === true)  { resolve(window._removeBackground); return; }
    if (window._bgRemoveReady === false) { reject(new Error('모듈 로드 실패')); return; }
    const start = Date.now();
    const check = () => {
      if (window._bgRemoveReady === true)  { resolve(window._removeBackground); return; }
      if (window._bgRemoveReady === false) { reject(new Error('모듈 로드 실패')); return; }
      if (Date.now()-start > timeout) { reject(new Error('모듈 로드 시간 초과')); return; }
      setTimeout(check, 300);
    };
    setTimeout(check, 300);
  });
}

function resizeImage(file, maxPx) {
  return new Promise(resolve => {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      const scale = Math.min(1, maxPx/Math.max(img.width, img.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(img.width*scale);
      canvas.height= Math.round(img.height*scale);
      canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
      URL.revokeObjectURL(url);
      canvas.toBlob(resolve, 'image/jpeg', 0.9);
    };
    img.src = url;
  });
}

function blobToDataUrl(blob) {
  return new Promise(resolve => {
    const r = new FileReader(); r.onload = e => resolve(e.target.result); r.readAsDataURL(blob);
  });
}

function compactDataUrl(dataUrl, maxPx) {
  return new Promise(resolve => {
    const img = new Image();
    img.onload = () => {
      const scale = Math.min(1, maxPx/Math.max(img.width, img.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(img.width*scale);
      canvas.height= Math.round(img.height*scale);
      const ctx = canvas.getContext('2d');
      ctx.clearRect(0,0,canvas.width,canvas.height);
      ctx.drawImage(img,0,0,canvas.width,canvas.height);
      resolve(canvas.toDataURL('image/png'));
    };
    img.src = dataUrl;
  });
}

function confirmCustomItem() {
  if (!pendingDataUrl) return;
  const name = $('itemNameInput').value.trim() || '내 아이템';
  const id = 'custom_' + Date.now();
  customItems.push({ id, name, w:selectedW, h:selectedH, dataUrl:pendingDataUrl });
  saveCustomItems();
  renderMyItemsGrid();
  closeModal();
}

// ══════════════════════════════════════
//  INIT
// ══════════════════════════════════════
(function init() {
  loadCustomItems();
  renderMyItemsGrid();
  const best = localStorage.getItem('hh_pack_best');
  if (best) { $('bestTxt').textContent=best; $('bestBadge').style.display=''; }
})();

</script>


