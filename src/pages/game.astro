---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
---
<BaseLayout title="짐 싸기 — HUIHUI Travel">
  <Fragment slot="head">
  <link rel="stylesheet" href="/assets/css/tokens.css"/>
  </Fragment>
  <Navbar />

<!-- ══ START: SCENARIO SELECTION ══ -->
<div class="screen active" id="screen-start">
  <h1 class="start-title">짐 싸기</h1>
  <p class="start-sub">어떤 여행을 떠나시나요?<br>힌트를 보고 딱 맞는 짐을 골라보세요!</p>
  <div class="scenario-grid" id="scenarioGrid"></div>
  <div class="my-items-section">
    <div class="my-items-header">
      <span class="my-items-title">📷 나만의 여행 아이템</span>
      <button class="btn-add-item" onclick="openModal()"><span>+</span> 사진 추가</button>
    </div>
    <div class="my-items-grid" id="myItemsGrid">
      <p class="my-items-empty">여행지에서 찍은 사진을 누끼 따서<br>나만의 짐으로 만들어 보세요!</p>
    </div>
  </div>
  <div class="best-badge" id="bestBadge" style="display:none">🏆 최고 기록: <span id="bestTxt"></span>점</div>
</div>

<!-- ══ DETAIL: SCENARIO PREVIEW ══ -->
<div class="screen" id="screen-detail">
  <div class="detail-card">
    <div class="detail-emoji" id="detailEmoji"></div>
    <div class="detail-title" id="detailTitle"></div>
    <div class="detail-sub" id="detailSub"></div>
    <div class="detail-season-tag" id="detailSeason"></div>
    <div class="detail-section-lbl">✈️ 여행 힌트</div>
    <div class="detail-hints" id="detailHints"></div>
    <div class="detail-notice">
      💡 힌트를 잘 읽고, 이 여행에 꼭 필요한 짐을 골라보세요!<br>
      <span>나중에 어떤 아이템이 추가 점수였는지 공개됩니다 😏</span>
    </div>
  </div>
  <div class="detail-btns">
    <button class="btn-outline" onclick="showScreen('screen-start')">← 돌아가기</button>
    <button class="btn-primary" onclick="startGame()">짐 싸기 시작 →</button>
  </div>
</div>

<!-- ══ GAME ══ -->
<div class="screen" id="screen-game">
  <div class="game-hint-bar">
    <span class="ghb-emoji" id="ghbEmoji"></span>
    <div class="ghb-info">
      <span class="ghb-title" id="ghbTitle"></span>
      <div class="ghb-chips" id="ghbChips"></div>
    </div>
  </div>

  <div class="stats-bar">
    <div class="stat-box">
      <span class="stat-lbl">남은 시간</span>
      <span class="stat-val" id="timerVal">90</span>
    </div>
    <div class="timer-track"><div class="timer-fill" id="timerFill"></div></div>
    <div class="stat-box">
      <span class="stat-lbl">아이템</span>
      <span class="stat-val" id="itemVal">0/20</span>
    </div>
  </div>

  <!-- 실시간 채움 게이지 -->
  <div class="fill-meter">
    <span class="fm-lbl">채움</span>
    <div class="fm-track"><div class="fm-fill" id="fmFill"></div></div>
    <span class="fm-pct" id="fmPct">0%</span>
  </div>

  <div class="suitcase-scene">
    <div class="handle"></div>
    <div class="suitcase-body">
      <div class="clasp clasp-tl"></div><div class="clasp clasp-tr"></div>
      <div class="clasp clasp-bl"></div><div class="clasp clasp-br"></div>
      <div class="clasp clasp-mc"></div>
      <div class="grid-wrap">
        <div class="grid-inner">
          <div class="suitcase-grid" id="suitcaseGrid"></div>
          <div class="placed-layer" id="placedLayer"></div>
        </div>
      </div>
    </div>
  </div>

  <p class="tray-lbl">아래 짐을 드래그해서 가방에 넣으세요</p>
  <div class="item-tray" id="itemTray"></div>

  <div class="game-bottom-row">
    <button class="close-btn" onclick="endGame()">🔒 가방 닫기</button>
    <button class="rotate-mobile-btn" id="rotateBtnMobile" style="display:none" onclick="rotateItem()">🔄 회전</button>
    <span class="rotate-hint-desk">R키로 회전</span>
  </div>
</div>

<!-- ══ RESULT ══ -->
<div class="screen" id="screen-result">
  <div class="res-scenario-tag" id="resScenarioTag"></div>
  <div class="result-emoji" id="resEmoji">🎉</div>
  <h2 class="result-title" id="resTitle">잘 했어요!</h2>

  <div class="score-breakdown">
    <div class="score-row">
      <span>아이템 <span id="resItemCount">0</span>개 담기</span>
      <span class="sb-val" id="resBase">+0점</span>
    </div>
    <div class="score-row">
      <span>효율 보너스 (<span id="resPct">0</span>% 채움)</span>
      <span class="sb-val" id="resEff">+0점</span>
    </div>
  </div>

  <div class="bonus-reveal">
    <div class="bonus-header" id="bonusHeader"></div>
    <div class="bonus-list" id="bonusList"></div>
    <div class="bonus-footer">
      <span>여행 보너스 합계</span>
      <span class="bonus-total" id="resBonusTotal">+0점</span>
    </div>
  </div>

  <div class="final-score-block">
    <div class="fs-label">최종 점수</div>
    <div class="fs-val" id="resFinalScore">0점</div>
  </div>

  <div class="fill-bar-wrap">
    <div class="fill-bar-track"><div class="fill-bar-fill" id="resFill" style="width:0%"></div></div>
    <div class="fill-label"><span id="resPctLbl">0% 채움</span><span id="resItemsLbl"></span></div>
  </div>

  <div class="travel-tip-section" id="travelTipSection" style="display:none">
    <div class="ttp-header">💡 다음엔 이것도 챙겨봐요!</div>
    <div class="ttp-list" id="ttpList"></div>
  </div>

  <div class="result-btns">
    <button class="btn-outline" onclick="showScreen('screen-start')">🗺️ 다른 여행 도전</button>
    <button class="btn-primary" onclick="startGame()">↺ 같은 여행 다시</button>
  </div>
  <a class="btn-trip-link" id="resTripLink" href="#">📖 여행 코스 보기</a>
</div>

<div id="ghost"></div>

<!-- ══ CUSTOM ITEM MODAL ══ -->
<div class="modal-backdrop" id="modal">
  <div class="modal-box">
    <div class="modal-title">📷 나만의 아이템 추가</div>
    <div class="modal-step active" id="step-upload">
      <div class="drop-zone" id="dropZone" onclick="$('fileInput').click()">
        <div class="drop-zone-icon">🖼️</div>
        <div class="drop-zone-title">사진을 올려주세요</div>
        <div class="drop-zone-sub">클릭 또는 드래그 &amp; 드롭<br>JPG · PNG · WEBP</div>
      </div>
      <input type="file" id="fileInput" accept="image/*"/>
      <div class="modal-btns">
        <button class="btn-modal-cancel" onclick="closeModal()">취소</button>
      </div>
    </div>
    <div class="modal-step" id="step-processing">
      <div class="processing-wrap active">
        <div class="spinner"></div>
        <div class="processing-label" id="processingLabel">AI가 배경을 지우는 중...</div>
        <div class="processing-sub">처음 사용 시 약 10~20초 걸릴 수 있어요</div>
      </div>
    </div>
    <div class="modal-step" id="step-preview">
      <div class="preview-wrap active">
        <div class="preview-canvas-wrap">
          <img id="previewImg" alt="누끼 결과" style="max-width:100%;max-height:200px;display:block;object-fit:contain;"/>
        </div>
        <div class="preview-label">배경이 자동으로 제거됐어요 ✨</div>
      </div>
      <div class="modal-field">
        <label>아이템 이름</label>
        <input class="modal-input" id="itemNameInput" type="text" maxlength="10" placeholder="예: 여수 거북선 기념품"/>
      </div>
      <div class="modal-field">
        <label>가방 안 크기 선택</label>
        <div class="size-picker">
          <div class="size-opt selected" data-w="1" data-h="1" onclick="selectSize(this)"><span class="size-opt-icon">🟫</span><span class="size-opt-lbl">1×1</span><span class="size-opt-sub">소형</span></div>
          <div class="size-opt" data-w="2" data-h="1" onclick="selectSize(this)"><span class="size-opt-icon">🟫🟫</span><span class="size-opt-lbl">2×1</span><span class="size-opt-sub">가로형</span></div>
          <div class="size-opt" data-w="1" data-h="2" onclick="selectSize(this)"><span class="size-opt-icon">📏</span><span class="size-opt-lbl">1×2</span><span class="size-opt-sub">세로형</span></div>
          <div class="size-opt" data-w="2" data-h="2" onclick="selectSize(this)"><span class="size-opt-icon">⬛</span><span class="size-opt-lbl">2×2</span><span class="size-opt-sub">대형</span></div>
        </div>
      </div>
      <div class="modal-btns">
        <button class="btn-modal-cancel" onclick="closeModal()">취소</button>
        <button class="btn-modal-confirm" id="confirmBtn" onclick="confirmCustomItem()">아이템으로 추가 →</button>
      </div>
    </div>
  </div>
</div>

<!-- ── ES MODULE: background removal ── -->
<script type="module">
  try {
    const { removeBackground } = await import('https://cdn.jsdelivr.net/npm/@imgly/background-removal@1.4.5/dist/browser.mjs');
    window._removeBackground = removeBackground;
    window._bgRemoveReady = true;
  } catch(e) {
    console.warn('background-removal 로드 실패:', e);
    window._bgRemoveReady = false;
  }
</script>

<script is:inline>
// ══════════════════════════════════════
//  HELPERS
// ══════════════════════════════════════
const $ = id => document.getElementById(id);

// rect cells helper (used inline)
const rc = (w, h) => {
  const c = [];
  for (let r = 0; r < h; r++) for (let col = 0; col < w; col++) c.push([r, col]);
  return c;
};

// cell-based item renderer
function renderCells(cells, color, lightColor, icon, cs, gap) {
  const maxR = Math.max(...cells.map(c => c[0]));
  const maxC = Math.max(...cells.map(c => c[1]));
  const W = (maxC+1)*cs + maxC*gap;
  const H = (maxR+1)*cs + maxR*gap;
  const cellSet = new Set(cells.map(([r,c]) => `${r},${c}`));
  let out = `<div style="position:relative;width:${W}px;height:${H}px">`;
  for (let r = 0; r <= maxR; r++) {
    for (let c = 0; c <= maxC; c++) {
      if (!cellSet.has(`${r},${c}`)) continue;
      const x = c*(cs+gap), y = r*(cs+gap);
      const isFirst = cells[0][0]===r && cells[0][1]===c;
      out += `<div style="position:absolute;left:${x}px;top:${y}px;width:${cs}px;height:${cs}px;background:${color};border-radius:5px;box-shadow:inset 2px 2px 5px ${lightColor},inset -2px -2px 4px rgba(0,0,0,0.22);display:flex;align-items:center;justify-content:center">${isFirst ? `<span style="font-size:${Math.max(11,Math.floor(cs*0.44))}px;line-height:1">${icon}</span>` : ''}</div>`;
    }
  }
  out += '</div>';
  return out;
}

// Render item for display (tray, ghost, placed)
function renderItemDisplay(item, cells, cs, gap, rotation) {
  if (item.color) return renderCells(cells, item.color, item.lightColor, item.icon, cs, gap);
  const maxR = Math.max(...cells.map(c=>c[0]));
  const maxC = Math.max(...cells.map(c=>c[1]));
  const W = (maxC+1)*cs + maxC*gap;
  const H = (maxR+1)*cs + maxR*gap;
  if (!rotation) return item.render(W, H);
  // SVG with CSS rotation
  const origW = item.w*cs + (item.w-1)*gap;
  const origH = item.h*cs + (item.h-1)*gap;
  const deg = rotation * 90;
  return `<div style="width:${W}px;height:${H}px;overflow:hidden;display:flex;align-items:center;justify-content:center"><div style="transform:rotate(${deg}deg);transform-origin:center;width:${origW}px;height:${origH}px;flex-shrink:0">${item.render(origW, origH)}</div></div>`;
}

