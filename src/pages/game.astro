    .tray-item:hover { transform:translateY(-3px) scale(1.04); box-shadow:0 8px 22px rgba(0,0,0,.22); }
    .tray-item.dragging { opacity:.18; transform:none !important; box-shadow:none; }
    .tray-item.placed   { display:none; }
    .tray-item svg, .tray-item img { display:block; }
    .item-lbl {
      position:absolute; bottom:0; left:0; right:0;
      background:rgba(0,0,0,.36); color:#fff;
      font-size:9px; font-weight:600; text-align:center;
      padding:3px 4px; letter-spacing:.05em;
