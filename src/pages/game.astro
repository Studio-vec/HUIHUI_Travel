    .handle {
      position:absolute; top:-22px; left:50%; transform:translateX(-50%);
      width:60px; height:20px;
      border:6px solid #5A2D0C; border-bottom:none; border-radius:14px 14px 0 0;
    }
    .clasp {
      position:absolute; z-index:2; width:22px; height:15px;
      background:linear-gradient(135deg,#E8CC4A,#B89010);
      border-radius:4px; box-shadow:0 2px 4px rgba(0,0,0,.3);
    }
    .clasp::after {
      content:''; position:absolute; inset:3px;
      border:1.5px solid rgba(255,220,80,.5); border-radius:2px;
    }
    .clasp-tl { top:-5px; left:28px; }
    .clasp-tr { top:-5px; right:28px; }
    .clasp-bl { bottom:-5px; left:28px; }
    .clasp-br { bottom:-5px; right:28px; }
    .clasp-mc { bottom:-5px; left:50%; transform:translateX(-50%); width:30px; height:17px; }
    .suitcase-body {
      background:linear-gradient(160deg,#7B4A2D 0%,#5A2D0C 100%);
      border-radius:18px; padding:10px; position:relative;
      border:1px solid rgba(255,255,255,.08);
    }
    .suitcase-body::before {
      content:''; position:absolute; inset:0; border-radius:18px;
      background:repeating-linear-gradient(45deg,transparent,transparent 8px,rgba(255,255,255,.015) 8px,rgba(255,255,255,.015) 16px);
      pointer-events:none;
    }
    .grid-wrap {
      background:linear-gradient(160deg,#CFA870 0%,#B89050 100%);
      border-radius:10px; padding:6px; position:relative;
    }
    .grid-wrap::before {
      content:''; position:absolute; inset:0; border-radius:10px;
      box-shadow:inset 0 2px 8px rgba(0,0,0,.3); pointer-events:none;
    }
    .grid-inner { position:relative; }
    .suitcase-grid { display:grid; gap:2px; position:relative; }
    .grid-cell { background:rgba(255,248,225,.42); border-radius:3px; transition:background .07s; }
    .grid-cell.hv { background:rgba(90,180,90,.55); }
    .grid-cell.hi { background:rgba(210,70,70,.45); }
    .placed-layer { position:absolute; top:0; left:0; pointer-events:none; }
    .placed-item {
      position:absolute; border-radius:7px; overflow:hidden;
      box-shadow:0 3px 12px rgba(0,0,0,.22);
      animation:pop .18s cubic-bezier(.175,.885,.32,1.275);
    }
