---
import { asset } from '../lib/asset';
import { CONTACT_EMAIL, KAKAO_CHANNEL_URL } from '../lib/contact';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="문의하기 — Travel HUIHUI"
  description="Travel HUIHUI 운영자에게 연락하는 방법입니다. 코스 정보 수정 요청, 제휴·협찬 문의, 저작권·개인정보 관련 요청을 이메일이나 카카오톡 채널로 보내 주세요."
>
  <Fragment slot="head">
  <link rel="stylesheet" href={asset('/assets/css/tokens.css')}/>
  </Fragment>
  <Navbar />
  <main id="main">

  <div class="pp-page">
    <div class="pp-header">
      <h1 class="pp-title">문의하기</h1>
      <p class="pp-updated">운영: Studio.Vec · 담당 태희</p>
    </div>

    <div class="pp-body">
      <p class="pp-lead">
        Travel HUIHUI는 Studio.Vec이 운영하는 개인 여행 기록 사이트입니다. 코스 내용에 대한 질문이나
        잘못된 정보 제보, 제휴 제안 등은 아래 채널로 보내 주세요. 영업일 기준 3일 안에 답변드립니다.
      </p>

      <section class="pp-section">
        <h2>연락처</h2>
        <ul>
          <li><strong>이메일</strong> — <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
          <li><strong>카카오톡 채널</strong> — <a href={KAKAO_CHANNEL_URL} target="_blank" rel="noopener">Travel HUIHUI 채널로 채팅하기</a></li>
        </ul>
      </section>

      <section class="pp-section">
        <h2>이런 내용을 받습니다</h2>
        <ul>
          <li><strong>정보 수정 요청</strong> — 운영시간·가격·휴무일이 바뀌었거나 폐업한 곳. 코스 이름과 장소 이름을 함께 적어 주시면 빨리 확인할 수 있습니다.</li>
          <li><strong>제휴·협찬 문의</strong> — 협찬을 받아 쓰는 글은 해당 글에 반드시 표기하며, 직접 방문하지 않은 곳은 소개하지 않습니다.</li>
          <li><strong>저작권 문의</strong> — 사이트 콘텐츠 이용 허락 요청, 또는 사이트에 권리 침해 소지가 있는 내용이 있다고 보시는 경우.</li>
          <li><strong>개인정보·회원 탈퇴</strong> — 회원 정보 열람·정정·삭제와 탈퇴 요청. 가입한 이메일 주소로 보내 주시면 본인 확인이 빠릅니다. 자세한 내용은 <a href="/privacy/">개인정보처리방침</a>을 참고해 주세요.</li>
        </ul>
      </section>

      <section class="pp-section">
        <h2>함께 보면 좋은 페이지</h2>
        <ul>
          <li><a href="/about/">사이트 소개</a> — 누가, 어떤 기준으로 코스를 만드는지</li>
          <li><a href="/terms/">이용약관</a></li>
          <li><a href="/privacy/">개인정보처리방침</a></li>
        </ul>
      </section>
    </div>
  </div>

  </main>
  <Footer />
</BaseLayout>

<style is:global>
  /* 문서 지면 스타일은 public/assets/css/hanok.css 의 .pp-* 를 함께 쓴다 */
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { font-family: var(--font-body); min-height: 100vh; }
</style>
