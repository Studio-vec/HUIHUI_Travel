---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';

---
<BaseLayout title="비밀번호 찾기 – Travel HUIHUI" noindex ads={false}>
  <Fragment slot="head"><link rel="stylesheet" href="/assets/css/auth.css" /></Fragment>

  <Navbar />
  <main id="main">

<div class="login-stage">
<div class="receipt">
  <div class="receipt-top"></div>
  <div class="receipt-body">

    <div class="logo-wrap">
      <div class="logo-circle"><span>HH</span></div>
      <h1 class="receipt-title">비밀번호 찾기</h1>
      <p class="receipt-sub">방명록에 적어 두신 이메일로 새 길을 보내 드려요</p>
    </div>

    <hr class="divider-solid"/>

    <!-- 비밀번호 찾기 패널 -->
    <div class="panel active" id="panelPw">
      <div class="field">
        <label class="field-label">이메일</label>
        <input class="input-box" type="email" id="findPwEmail" placeholder="가입한 이메일 주소"/>
      </div>
      <div class="result-box" id="findPwResult"></div>
      <button class="btn-submit" id="findPwBtn" onclick="findPw()">재설정 메일 보내기</button>
    </div>

    <hr class="divider"/>
    <div class="receipt-links">
      <a href="/auth/login">← 로그인으로</a>
      <span>·</span>
      <a href="/auth/register">회원가입</a>
    </div>

  </div>
  <div class="receipt-bottom"></div>
</div>
</div>

<script>
  function showResult(id, msg, type) {
    const el = document.getElementById(id);
    el.textContent = msg;
    el.className = 'result-box ' + type + ' show';
  }

  /* 비밀번호 재설정 메일 */
  async function findPw() {
    const email = document.getElementById('findPwEmail').value.trim();
    const btn   = document.getElementById('findPwBtn');
    if (!email) { showResult('findPwResult','이메일을 입력해주세요','error'); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showResult('findPwResult','이메일 형식을 확인해주세요','error'); return; }
    if (!window._sb) { showResult('findPwResult','서버 연결을 확인해주세요','error'); return; }

    btn.disabled = true;
    btn.innerHTML = '<span class="loading-spinner"></span>전송 중…';

    try {
      const { error } = await window._sb.auth.resetPasswordForEmail(email, {
        redirectTo: location.origin + '/auth/reset-password'
      });
      if (error) throw error;
      /* 가입 여부와 관계없이 같은 문구를 보여 계정 존재 여부를 드러내지 않는다 */
      showResult('findPwResult',
        '가입된 이메일이라면 재설정 링크를 보냈어요. 이메일함(스팸함 포함)을 확인해 주세요.',
        'ok'
      );
    } catch (e) {
      showResult('findPwResult', '메일을 보내지 못했어요. 잠시 후 다시 시도해주세요.', 'error');
    }

    btn.disabled = false;
    btn.textContent = '재설정 메일 보내기';
  }

  document.addEventListener('keydown', e => { if (e.key === 'Enter') findPw(); });

  window.findPw = findPw;
</script>


<style is:global>

    :root {
      --purple:       #EF4D6D;
      --purple-light: #F7A1B2;
      --purple-pale:  #F8E1DF;
      --cream:        #F7F0E5;
      --green:        #8F9D68;
      --text:         #202943;
      --text-mid:     #74272D;
      --text-dim:     #9D8F83;
      --error:        #c04040;
      --ok:           #4a9a6a;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      min-height: 100vh;
      display: flex; flex-direction: column; align-items: stretch;
      font-family: 'Pretendard Variable', Pretendard, -apple-system, sans-serif;
    }
    .login-stage {
      flex: 1; display: flex; align-items: center; justify-content: center;
      padding: 32px 16px 48px;
    }
    .receipt {
      width: min(320px, 92vw);
      position: relative;
    }
    .receipt-top { width:100%; height:14px; background:var(--cream); position:relative; }
    .receipt-top::before {
      content:''; position:absolute; top:0; left:0; right:0; height:14px;
      background: radial-gradient(circle at 50% -1px, transparent 7px, var(--cream) 7px) -7px 0 / 14px 14px repeat-x;
    }
    .receipt-body { padding:10px 24px 24px; }
    .receipt-bottom { width:100%; height:14px; background:var(--cream); position:relative; }
    .receipt-bottom::after {
      content:''; position:absolute; bottom:0; left:0; right:0; height:14px;
      background: radial-gradient(circle at 50% calc(100% + 1px), transparent 7px, var(--cream) 7px) -7px 0 / 14px 14px repeat-x;
    }
    .logo-wrap { display:flex; flex-direction:column; align-items:center; padding:18px 0 14px; }
    .logo-circle {
      display:flex; align-items:center; justify-content:center; margin-bottom:8px;
    }
    .logo-circle span { font-family:'Pretendard Variable', Pretendard, -apple-system, sans-serif; font-size:0.85rem; font-weight:900; color:white; letter-spacing:0.05em; }

    .receipt-sub { margin-top:2px; }
    .divider { margin:12px 0; }
    .divider-solid { margin:10px 0; }

    /* 탭 */
    .panel { display:none; }
    .panel.active { display:block; }

    .field { margin-bottom:12px; }
    .field-label { margin-bottom:5px; display:block; }
    .input-box {
      width:100%; height:40px; font-size:0.82rem;
      font-family:'Pretendard Variable', Pretendard, -apple-system, sans-serif; outline:none;
      transition: border-color .2s;
    }

    .input-box::placeholder { font-size:0.75rem; }

    /* 결과 박스 */
    .result-box {
      display:none;
      padding:14px 16px; margin:8px 0;
      font-size:0.8rem; line-height:1.6;
    }
    .result-box.ok    { background:rgba(74,154,106,0.1); border:1px solid rgba(74,154,106,0.3); color:#2a6a40; }
    .result-box.error { background:rgba(192,64,64,0.08); border:1px solid rgba(192,64,64,0.25); color:var(--error); }
    .result-box.show  { display:block; }
    .result-id {
      font-family:'Pretendard Variable', Pretendard, -apple-system, sans-serif; font-size:1.1rem;
      font-weight:700; color:var(--purple); margin-top:4px;
      letter-spacing:0.04em;
    }

    .btn-submit {
      width:100%; height:42px;
      border:none;
      font-size:0.75rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase;
      cursor:pointer; font-family:'Pretendard Variable', Pretendard, -apple-system, sans-serif;
      transition:transform .15s, box-shadow .15s; margin-top:4px;
    }
    .btn-submit:hover { transform:translateY(-2px); box-shadow:0 8px 22px rgba(239,77,109,0.4); }
    .btn-submit:disabled { opacity:.6; cursor:not-allowed; transform:none !important; }

    .receipt-links { display:flex; justify-content:center; gap:14px; margin-top:14px; }
    .receipt-links a { font-size:0.75rem; text-decoration:none; }
    .receipt-links a:hover { text-decoration:underline; }


    .loading-spinner {
      display:inline-block; width:12px; height:12px;
      border:2px solid rgba(255,255,255,0.4); border-top-color:white;
      border-radius:50%; animation:spin .6s linear infinite; margin-right:6px;
    }
    @keyframes spin { to { transform:rotate(360deg); } }
  
</style>

</main>
</BaseLayout>
