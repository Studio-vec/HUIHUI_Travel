---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';

---
<BaseLayout title="비밀번호 찾기 – Travel HUIHUI" noindex ads={false}>

  <Navbar />
  <main id="main">

<div class="login-stage">
<div class="receipt">
  <div class="receipt-top"></div>
  <div class="receipt-body">

    <div class="logo-wrap">
      <div class="logo-circle"><span>HH</span></div>
      <div class="receipt-title">HELP DESK</div>
      <div class="receipt-sub">ACCOUNT RECOVERY</div>
    </div>

    <hr class="divider-solid"/>

    <!-- 비밀번호 찾기 패널 -->
    <div class="panel active" id="panelPw">
      <p style="font-size:0.75rem;color:var(--text-dim);margin-bottom:12px;line-height:1.5;">
        가입한 이메일로 비밀번호 재설정<br>링크를 보내드려요.
      </p>
      <div class="field">
        <label class="field-label">이메일</label>
        <input class="input-box" type="email" id="findPwEmail" placeholder="가입한 이메일 주소"/>
      </div>
      <div class="result-box" id="findPwResult"></div>
      <button class="btn-submit" id="findPwBtn" onclick="findPw()">재설정 메일 보내기</button>
    </div>

    <hr class="divider"/>
    <div class="receipt-links">
      <a href="/auth/login">← 로그인으로</a>
      <span>·</span>
      <a href="/auth/register">회원가입</a>
    </div>

  </div>
  <div class="receipt-bottom"></div>
</div>
</div>

<script>
  function showResult(id, msg, type) {
    const el = document.getElementById(id);
    el.textContent = msg;
    el.className = 'result-box ' + type + ' show';
  }

  /* 비밀번호 재설정 메일 */
  async function findPw() {
    const email = document.getElementById('findPwEmail').value.trim();
    const btn   = document.getElementById('findPwBtn');
    if (!email) { showResult('findPwResult','이메일을 입력해주세요','error'); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showResult('findPwResult','이메일 형식을 확인해주세요','error'); return; }
    if (!window._sb) { showResult('findPwResult','서버 연결을 확인해주세요','error'); return; }

    btn.disabled = true;
    btn.innerHTML = '<span class="loading-spinner"></span>전송 중…';

    try {
      const { error } = await window._sb.auth.resetPasswordForEmail(email, {
        redirectTo: 'https://travel-huihui.com/auth/reset-password'
      });
      if (error) throw error;
      /* 가입 여부와 관계없이 같은 문구를 보여 계정 존재 여부를 드러내지 않는다 */
      showResult('findPwResult',
        '가입된 이메일이라면 재설정 링크를 보냈어요. 이메일함(스팸함 포함)을 확인해주세요. 📬',
        'ok'
      );
    } catch (e) {
      showResult('findPwResult', '메일을 보내지 못했어요. 잠시 후 다시 시도해주세요.', 'error');
    }

    btn.disabled = false;
    btn.textContent = '재설정 메일 보내기';
  }

  document.addEventListener('keydown', e => { if (e.key === 'Enter') findPw(); });

  window.findPw = findPw;
</script>


<style is:global>

    :root {
      --purple:       #7A57CD;
      --purple-light: #C8B1FF;
      --purple-pale:  #EDE5FF;
      --cream:        #FFF8EB;
      --green:        #8F9D68;
      --text:         #2a1a4a;
      --text-mid:     #5a3e8a;
      --text-dim:     #9a8ab0;
      --error:        #c04040;
      --ok:           #4a9a6a;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      min-height: 100vh;
      display: flex; flex-direction: column; align-items: stretch;
      font-family: 'Noto Sans KR', sans-serif;
      background: linear-gradient(160deg, var(--cream) 0%, #e8dcff 50%, #c8b1ff 100%);
    }
    .login-stage {
      flex: 1; display: flex; align-items: center; justify-content: center;
      padding: 32px 16px 48px;
    }
    .receipt {
      width: min(320px, 92vw); background: var(--cream);
      position: relative;
      filter: drop-shadow(0 20px 40px rgba(122,87,205,0.22));
    }
    .receipt-top { width:100%; height:14px; background:var(--cream); position:relative; }
    .receipt-top::before {
      content:''; position:absolute; top:0; left:0; right:0; height:14px;
      background: radial-gradient(circle at 50% -1px, transparent 7px, var(--cream) 7px) -7px 0 / 14px 14px repeat-x;
    }
    .receipt-body { background:var(--cream); padding:10px 24px 24px; }
    .receipt-bottom { width:100%; height:14px; background:var(--cream); position:relative; }
    .receipt-bottom::after {
      content:''; position:absolute; bottom:0; left:0; right:0; height:14px;
      background: radial-gradient(circle at 50% calc(100% + 1px), transparent 7px, var(--cream) 7px) -7px 0 / 14px 14px repeat-x;
    }
    .logo-wrap { display:flex; flex-direction:column; align-items:center; padding:18px 0 14px; }
    .logo-circle {
      width:52px; height:52px; border-radius:50%;
      background: radial-gradient(circle at 38% 32%, #C8B1FF, #AB88FF 55%, #7A57CD);
      box-shadow: 2px 4px 8px rgba(0,0,0,0.12), inset -2px -4px 8px rgba(80,0,200,0.25);
      display:flex; align-items:center; justify-content:center; margin-bottom:8px;
    }
    .logo-circle span { font-family:'Playfair Display',serif; font-size:0.85rem; font-weight:900; color:white; letter-spacing:0.05em; }
    .receipt-title { font-family:'Playfair Display',serif; font-size:1.2rem; font-weight:900; color:var(--purple); }
    .receipt-sub { font-family:'Cormorant Garamond',serif; font-style:italic; font-size:0.75rem; color:var(--text-dim); letter-spacing:0.15em; margin-top:2px; }
    .divider { border:none; border-top:1.5px dashed var(--purple-light); margin:12px 0; }
    .divider-solid { border:none; border-top:1px solid var(--purple-light); margin:10px 0; }

    /* 탭 */
    .panel { display:none; }
    .panel.active { display:block; }

    .field { margin-bottom:12px; }
    .field-label { font-size:0.75rem; font-weight:700; color:var(--green); letter-spacing:0.14em; margin-bottom:5px; display:block; }
    .input-box {
      width:100%; height:40px; background:white;
      border:1.5px solid var(--purple-light); border-radius:999px;
      padding:0 14px; font-size:0.82rem;
      font-family:'Noto Sans KR',sans-serif; color:var(--text); outline:none;
      transition: border-color .2s;
    }
    .input-box:focus { border-color:var(--purple); }
    .input-box::placeholder { color:var(--text-dim); font-size:0.75rem; }

    /* 결과 박스 */
    .result-box {
      display:none; border-radius:14px;
      padding:14px 16px; margin:8px 0;
      font-size:0.8rem; line-height:1.6;
    }
    .result-box.ok    { background:rgba(74,154,106,0.1); border:1px solid rgba(74,154,106,0.3); color:#2a6a40; }
    .result-box.error { background:rgba(192,64,64,0.08); border:1px solid rgba(192,64,64,0.25); color:var(--error); }
    .result-box.show  { display:block; }
    .result-id {
      font-family:'Playfair Display',serif; font-size:1.1rem;
      font-weight:700; color:var(--purple); margin-top:4px;
      letter-spacing:0.04em;
    }

    .btn-submit {
      width:100%; height:42px; background:var(--purple);
      border:none; border-radius:999px;
      font-size:0.75rem; font-weight:700; color:white; letter-spacing:0.1em; text-transform:uppercase;
      cursor:pointer; font-family:'Noto Sans KR',sans-serif;
      box-shadow:0 4px 14px rgba(122,87,205,0.3);
      transition:transform .15s, box-shadow .15s; margin-top:4px;
    }
    .btn-submit:hover { transform:translateY(-2px); box-shadow:0 8px 22px rgba(122,87,205,0.4); }
    .btn-submit:disabled { opacity:.6; cursor:not-allowed; transform:none !important; }

    .receipt-links { display:flex; justify-content:center; gap:14px; margin-top:14px; }
    .receipt-links a { font-size:0.75rem; color:var(--green); text-decoration:none; }
    .receipt-links a:hover { color:var(--purple); text-decoration:underline; }
    .receipt-links span { color:var(--purple-light); }

    .loading-spinner {
      display:inline-block; width:12px; height:12px;
      border:2px solid rgba(255,255,255,0.4); border-top-color:white;
      border-radius:50%; animation:spin .6s linear infinite; margin-right:6px;
    }
    @keyframes spin { to { transform:rotate(360deg); } }
  
</style>

</main>
</BaseLayout>
