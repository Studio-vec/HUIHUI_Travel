---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';

---
<BaseLayout title="회원가입 – Travel HUIHUI" noindex ads={false}>
  <Fragment slot="head"><link rel="stylesheet" href="/assets/css/auth.css" /></Fragment>

  <Navbar />
  <main id="main">

<div class="login-stage">
<div class="receipt">
  <div class="receipt-top"></div>
  <div class="receipt-body">

    <div class="logo-wrap">
      <div class="logo-circle"><span>HH</span></div>
      <div class="receipt-title">CHECK IN</div>
      <div class="receipt-sub">NEW MEMBER REGISTRATION</div>
    </div>

    <hr class="divider-solid"/>

    <!-- 닉네임 -->
    <div class="field">
      <label class="field-label">NICKNAME <span>변경 가능</span></label>
      <input class="input-box" type="text" id="nickname" placeholder="표시될 이름을 입력하세요" maxlength="20" oninput="checkNickname(this)"/>
      <div class="hint" id="nicknameHint"></div>
    </div>

    <!-- 아이디 -->
    <div class="field">
      <label class="field-label">아이디 <span>영문·숫자 4–16자 · 변경 불가</span></label>
      <input class="input-box" type="text" id="username" placeholder="프로필에 표시될 아이디" maxlength="16" oninput="checkUsername(this)" autocomplete="off"/>
      <div class="hint" id="usernameHint"></div>
    </div>

    <!-- 비밀번호 -->
    <div class="field">
      <label class="field-label">PASSWORD</label>
      <div class="pw-wrap">
        <input class="input-box" type="password" id="pw" placeholder="8자 이상 입력하세요" oninput="checkPw(this)" autocomplete="new-password"/>
        <button class="pw-toggle" type="button" onclick="togglePw('pw', this)">보기</button>
      </div>
      <div class="hint" id="pwHint"></div>
    </div>

    <!-- 비밀번호 확인 -->
    <div class="field">
      <label class="field-label">PASSWORD 확인</label>
      <div class="pw-wrap">
        <input class="input-box" type="password" id="pw2" placeholder="비밀번호를 한 번 더 입력하세요" oninput="checkPw2(this)" autocomplete="new-password"/>
        <button class="pw-toggle" type="button" onclick="togglePw('pw2', this)">보기</button>
      </div>
      <div class="hint" id="pw2Hint"></div>
    </div>

    <!-- 이메일 -->
    <div class="field">
      <label class="field-label">EMAIL <span>변경 가능</span></label>
      <input class="input-box" type="email" id="email" placeholder="로그인에 사용할 이메일 주소" oninput="checkEmail(this)" autocomplete="username"/>
      <div class="hint" id="emailHint"></div>
    </div>

    <!-- 전화번호 -->
    <div class="field">
      <label class="field-label">PHONE <span>선택 · 변경 가능</span></label>
      <input class="input-box" type="tel" id="phone" placeholder="010-0000-0000" oninput="checkPhone(this)" autocomplete="tel"/>
      <div class="hint" id="phoneHint"></div>
    </div>

    <hr class="divider"/>

    <!-- 마케팅 동의 -->
    <div class="marketing-section">
      <div class="marketing-title">광고·정보 수신 동의</div>

      <label class="check-row agree-all">
        <input type="checkbox" id="agreeAll" onchange="toggleAll(this)"/>
        <span class="check-box"></span>
        <span class="check-label">전체 동의</span>
      </label>

      <label class="check-row">
        <input type="checkbox" id="mktEmail" onchange="syncAll()"/>
        <span class="check-box"></span>
        <span class="check-label">이메일로 여행 정보 및 광고 수신<span class="check-optional"> (선택)</span></span>
      </label>

      <label class="check-row">
        <input type="checkbox" id="mktSms" onchange="syncAll()"/>
        <span class="check-box"></span>
        <span class="check-label">SMS·카카오로 여행 정보 및 광고 수신<span class="check-optional"> (선택)</span></span>
      </label>
    </div>

    <div class="error-msg" id="errMsg"></div>

    <hr class="divider"/>

    <button class="btn-checkin" id="submitBtn" onclick="doRegister()">
      <span class="btn-checkin-label">회원가입 완료</span>
      <span class="btn-checkin-arrow">→</span>
    </button>

    <div class="receipt-links">
      <a href="/auth/login">이미 계정이 있으신가요? 로그인 →</a>
    </div>

  </div>
  <div class="receipt-bottom"></div>
</div>
</div>

<div class="toast" id="toast">✓ 가입 완료! 어서오세요 🗝️</div>

<script>
  let _usernameOk = false;
  let _usernameTimer = null;

  function togglePw(id, btn) {
    const i = document.getElementById(id);
    i.type = i.type === 'password' ? 'text' : 'password';
    btn.textContent = i.type === 'password' ? '보기' : '숨기기';
  }

  function setHint(id, msg, state) {
    const el = document.getElementById(id);
    const inp = document.getElementById(id.replace('Hint',''));
    el.textContent = msg;
    el.className = 'hint ' + (state || '');
    if (inp) {
      inp.classList.remove('ok','error');
      if (state) inp.classList.add(state);
    }
  }

  function checkNickname(el) {
    const v = el.value.trim();
    if (!v) { setHint('nicknameHint','닉네임을 입력해주세요','error'); return; }
    if (v.length < 2) { setHint('nicknameHint','2자 이상 입력해주세요','error'); return; }
    setHint('nicknameHint','좋아요!','ok');
  }

  function checkUsername(el) {
    const v = el.value.trim();
    _usernameOk = false;
    clearTimeout(_usernameTimer);
    if (!v) { setHint('usernameHint','아이디를 입력해주세요','error'); return; }
    if (!/^[a-zA-Z0-9]{4,16}$/.test(v)) {
      setHint('usernameHint','영문·숫자 4~16자로 입력해주세요','error'); return;
    }
    setHint('usernameHint','중복 확인 중…','');
    _usernameTimer = setTimeout(async () => {
      if (!window._sb) { setHint('usernameHint','',''); _usernameOk = true; return; }
      try {
        const { data: taken } = await window._sb.rpc('is_username_taken', { p_username: v });
        if (taken) {
          setHint('usernameHint','이미 사용 중인 아이디입니다','error');
          _usernameOk = false;
        } else {
          setHint('usernameHint','사용 가능한 아이디입니다','ok');
          _usernameOk = true;
        }
      } catch {
        setHint('usernameHint','확인 중 오류가 발생했습니다','error');
      }
    }, 500);
  }

  function checkPw(el) {
    const v = el.value;
    if (!v) { setHint('pwHint','비밀번호를 입력해주세요','error'); return; }
    if (v.length < 8) { setHint('pwHint','8자 이상 입력해주세요','error'); return; }
    setHint('pwHint','','ok');
    if (document.getElementById('pw2').value) checkPw2(document.getElementById('pw2'));
  }

  function checkPw2(el) {
    const v  = el.value;
    const pw = document.getElementById('pw').value;
    if (!v) { setHint('pw2Hint','비밀번호를 다시 입력해주세요','error'); return; }
    if (v !== pw) { setHint('pw2Hint','비밀번호가 일치하지 않아요','error'); return; }
    setHint('pw2Hint','일치합니다','ok');
  }

  function checkEmail(el) {
    const v = el.value.trim();
    if (!v) { setHint('emailHint','이메일을 입력해주세요','error'); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) { setHint('emailHint','이메일 형식을 확인해주세요','error'); return; }
    setHint('emailHint','','ok');
  }

  function checkPhone(el) {
    const v = el.value.trim();
    if (!v) { setHint('phoneHint','선택 항목입니다',''); return; }
    const digits = v.replace(/\D/g,'');
    if (digits.length < 10 || digits.length > 11) { setHint('phoneHint','올바른 전화번호를 입력해주세요','error'); return; }
    setHint('phoneHint','','ok');
  }

  function toggleAll(el) {
    document.getElementById('mktEmail').checked = el.checked;
    document.getElementById('mktSms').checked   = el.checked;
  }

  function syncAll() {
    const all = document.getElementById('mktEmail').checked && document.getElementById('mktSms').checked;
    document.getElementById('agreeAll').checked = all;
  }

  async function doRegister() {
    const nickname = document.getElementById('nickname').value.trim();
    const username = document.getElementById('username').value.trim();
    const pw       = document.getElementById('pw').value;
    const pw2      = document.getElementById('pw2').value;
    const email    = document.getElementById('email').value.trim();
    const phone    = document.getElementById('phone').value.trim();
    const mktEmail = document.getElementById('mktEmail').checked;
    const mktSms   = document.getElementById('mktSms').checked;
    const err      = document.getElementById('errMsg');
    const btn      = document.getElementById('submitBtn');

    err.classList.remove('show');

    /* 유효성 검사 */
    if (!nickname || nickname.length < 2) { showErr('닉네임을 2자 이상 입력해주세요'); return; }
    if (!username || !/^[a-zA-Z0-9]{4,16}$/.test(username)) { showErr('아이디를 확인해주세요'); return; }
    if (!_usernameOk) { showErr('아이디 중복 확인이 완료되지 않았습니다'); return; }
    if (!pw || pw.length < 8) { showErr('비밀번호를 8자 이상 입력해주세요'); return; }
    if (pw !== pw2) { showErr('비밀번호가 일치하지 않아요'); return; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showErr('이메일을 확인해주세요'); return; }

    if (!window._sb) { showErr('서버 연결을 확인해주세요 (Supabase 설정 필요)'); return; }

    /* 로딩 */
    btn.disabled = true;
    btn.querySelector('.btn-checkin-label').innerHTML = '<span class="loading-spinner"></span>가입 중…';

    try {
      const { data, error } = await window._sb.auth.signUp({
        email,
        password: pw,
        options: {
          data: { username, nickname, phone: phone || null, marketing_email: mktEmail, marketing_sms: mktSms },
          emailRedirectTo: location.origin + '/auth/login'
        }
      });

      if (error) throw error;

      /* 이메일 인증을 켜 두면 세션 없이 돌아온다 → 메일 확인 안내 후 로그인 화면으로 */
      const toast = document.getElementById('toast');
      if (!data.session) toast.textContent = '✓ 인증 메일을 보냈어요. 메일의 링크를 누르면 가입이 끝나요 📬';
      toast.classList.add('show');
      setTimeout(() => window.location.href = data.session ? '/' : '/auth/login', data.session ? 1600 : 3500);
    } catch (e) {
      btn.disabled = false;
      btn.querySelector('.btn-checkin-label').textContent = '회원가입 완료';
      showErr(e.message === 'User already registered' ? '이미 가입된 이메일입니다' : e.message || '오류가 발생했습니다');
    }
  }

  function showErr(msg) {
    const el = document.getElementById('errMsg');
    el.textContent = msg;
    el.classList.add('show');
  }

  window.togglePw       = togglePw;
  window.checkNickname  = checkNickname;
  window.checkUsername  = checkUsername;
  window.checkPw        = checkPw;
  window.checkPw2       = checkPw2;
  window.checkEmail     = checkEmail;
  window.checkPhone     = checkPhone;
  window.toggleAll      = toggleAll;
  window.syncAll        = syncAll;
  window.doRegister     = doRegister;
</script>


<style is:global>

    :root {
      --purple:       #EF4D6D;
      --purple-mid:   #CB636C;
      --purple-light: #F7A1B2;
      --purple-pale:  #F8E1DF;
      --cream:        #F7F0E5;
      --green:        #8F9D68;
      --text:         #202943;
      --text-mid:     #74272D;
      --text-dim:     #9D8F83;
      --error:        #c04040;
      --ok:           #4a9a6a;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      min-height: 100vh;
      display: flex; flex-direction: column; align-items: stretch;
      font-family: 'Pretendard Variable', Pretendard, -apple-system, sans-serif;
      background: linear-gradient(160deg, var(--cream) 0%, #F8E3E4 50%, #F7A1B2 100%);
    }
    .login-stage {
      flex: 1; display: flex; align-items: flex-start; justify-content: center;
      padding: 32px 16px 60px;
    }
    .receipt {
      width: min(360px, 94vw);
      background: var(--cream);
      position: relative;
      filter: drop-shadow(0 20px 40px rgba(239,77,109,0.22));
    }
    .receipt-top {
      width: 100%; height: 14px; background: var(--cream); position: relative;
    }
    .receipt-top::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 14px;
      background: radial-gradient(circle at 50% -1px, transparent 7px, var(--cream) 7px) -7px 0 / 14px 14px repeat-x;
    }
    .receipt-body { background: var(--cream); padding: 10px 24px 24px; }
    .receipt-bottom { width: 100%; height: 14px; background: var(--cream); position: relative; }
    .receipt-bottom::after {
      content: '';
      position: absolute; bottom: 0; left: 0; right: 0; height: 14px;
      background: radial-gradient(circle at 50% calc(100% + 1px), transparent 7px, var(--cream) 7px) -7px 0 / 14px 14px repeat-x;
    }
    .logo-wrap { display: flex; flex-direction: column; align-items: center; padding: 18px 0 12px; }
    .logo-circle {
      width: 56px; height: 56px; border-radius: 50%;
      background: radial-gradient(circle at 38% 32%, #F7A1B2, #E89FA4 55%, #EF4D6D);
      box-shadow: 2px 4px 8px rgba(0,0,0,0.12), inset -2px -4px 8px rgba(116,39,45,0.25);
      display: flex; align-items: center; justify-content: center; margin-bottom: 8px;
    }
    .logo-circle span { font-family: 'Pretendard Variable', Pretendard, -apple-system, sans-serif; font-size: 0.9rem; font-weight: 900; color: white; letter-spacing: 0.05em; }
    .receipt-title { font-family: 'Pretendard Variable', Pretendard, -apple-system, sans-serif; font-size: 1.3rem; font-weight: 900; color: var(--purple); }
    .receipt-sub { font-family: 'Pretendard Variable', Pretendard, -apple-system, sans-serif; font-style: italic; font-size: 0.75rem; color: var(--text-dim); letter-spacing: 0.15em; margin-top: 2px; }
    .divider { border: none; border-top: 1.5px dashed var(--purple-light); margin: 10px 0; }
    .divider-solid { border: none; border-top: 1px solid var(--purple-light); margin: 10px 0; }
    .field { margin-bottom: 10px; }
    .field-label {
      font-size: 0.75rem; font-weight: 700; color: var(--green);
      letter-spacing: 0.14em; margin-bottom: 5px; display: block;
    }
    .field-label span { font-size: 0.75rem; color: var(--text-dim); font-weight: 400; letter-spacing: 0; margin-left: 4px; }
    .input-box {
      width: 100%; height: 40px;
      background: white; border: 1.5px solid var(--purple-light);
      border-radius: 999px; padding: 0 14px;
      font-size: 0.82rem; font-family: 'Pretendard Variable', Pretendard, -apple-system, sans-serif;
      color: var(--text); outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .input-box:focus { border-color: var(--purple); box-shadow: 0 0 0 3px rgba(239,77,109,0.1); }
    .input-box::placeholder { color: var(--text-dim); font-size: 0.75rem; }
    .input-box.ok    { border-color: var(--ok); }
    .input-box.error { border-color: var(--error); }
    .hint {
      font-size: 0.75rem; margin-top: 4px; min-height: 14px;
      padding-left: 4px; color: var(--text-dim); transition: color 0.15s;
    }
    .hint.ok    { color: var(--ok); }
    .hint.error { color: var(--error); }
    .pw-wrap { position: relative; }
    .pw-toggle {
      position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer;
      color: var(--text-dim); font-size: 0.75rem;
      font-family: 'Pretendard Variable', Pretendard, -apple-system, sans-serif; padding: 4px; z-index: 1;
    }
    .pw-toggle:hover { color: var(--purple); }
    /* 마케팅 동의 */
    .marketing-section { margin: 4px 0 6px; }
    .marketing-title { font-size: 0.75rem; font-weight: 700; color: var(--green); letter-spacing: 0.12em; margin-bottom: 8px; }
    .check-row { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; cursor: pointer; }
    .check-box {
      width: 18px; height: 18px; border-radius: 5px;
      border: 1.5px solid var(--purple-light); background: white;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; transition: background .15s, border-color .15s;
    }
    .check-row input[type=checkbox] { display: none; }
    .check-row input[type=checkbox]:checked + .check-box {
      background: var(--purple); border-color: var(--purple);
    }
    .check-row input[type=checkbox]:checked + .check-box::after {
      content: ''; display: block;
      width: 5px; height: 9px;
      border: 2px solid white; border-top: none; border-left: none;
      transform: rotate(45deg) translate(-1px,-1px);
    }
    .check-label { font-size: 0.75rem; color: var(--text-mid); line-height: 1.4; }
    .check-optional { font-size: 0.75rem; color: var(--text-dim); margin-left: 2px; }
    /* 전체 동의 */
    .agree-all { margin-bottom: 6px; }
    .agree-all .check-label { font-weight: 600; color: var(--text); }
    /* 에러 */
    .error-msg {
      font-size: 0.75rem; color: var(--error);
      text-align: center; min-height: 16px;
      opacity: 0; transition: opacity 0.2s; margin: 4px 0 6px;
    }
    .error-msg.show { opacity: 1; }
    /* 버튼 */
    .btn-checkin {
      width: 100%; height: 44px;
      background: var(--purple); border: none; border-radius: 999px;
      display: flex; align-items: center; padding: 0 20px; cursor: pointer;
      box-shadow: 0 4px 14px rgba(239,77,109,0.35);
      transition: transform 0.15s, box-shadow 0.15s; margin-top: 4px;
    }
    .btn-checkin:disabled { opacity: 0.6; cursor: not-allowed; transform: none !important; }
    .btn-checkin:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(239,77,109,0.45); }
    .btn-checkin-label { font-size: 0.75rem; font-weight: 700; color: rgba(255,255,255,0.8); letter-spacing: 0.12em; text-transform: uppercase; flex: 1; font-family: 'Pretendard Variable', Pretendard, -apple-system, sans-serif; }
    .btn-checkin-arrow { font-family: 'Pretendard Variable', Pretendard, -apple-system, sans-serif; font-size: 1rem; color: white; }
    .receipt-links { display: flex; justify-content: center; gap: 14px; margin-top: 12px; }
    .receipt-links a { font-size: 0.75rem; color: var(--green); text-decoration: none; letter-spacing: 0.04em; }
    .receipt-links a:hover { color: var(--purple); text-decoration: underline; }
    .toast {
      position: fixed; top: 24px; left: 50%;
      transform: translateX(-50%) translateY(-80px);
      background: var(--purple); color: white;
      border-radius: 999px; padding: 10px 24px;
      font-size: 0.82rem; font-weight: 500;
      box-shadow: 0 8px 24px rgba(239,77,109,0.3);
      transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1);
      white-space: nowrap; z-index: 999;
    }
    .toast.show { transform: translateX(-50%) translateY(0); }
    .loading-spinner {
      display: inline-block; width: 14px; height: 14px;
      border: 2px solid rgba(255,255,255,0.4); border-top-color: white;
      border-radius: 50%; animation: spin 0.6s linear infinite; margin-right: 8px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
  
</style>

</main>
</BaseLayout>
