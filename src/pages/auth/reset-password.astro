---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';

---
<BaseLayout title="비밀번호 재설정 – Travel HUIHUI" noindex ads={false}>
  <Fragment slot="head"><link rel="stylesheet" href="/assets/css/auth.css" /></Fragment>

  <Navbar />
  <main id="main">

<div class="login-stage">
<div class="receipt">
  <div class="receipt-top"></div>
  <div class="receipt-body" id="receiptBody">

    <div class="logo-wrap">
      <div class="logo-circle"><span>HH</span></div>
      <div class="receipt-title">NEW KEY</div>
      <div class="receipt-sub">PASSWORD RESET</div>
    </div>

    <hr class="divider-solid"/>

    <!-- 로딩 중 -->
    <div id="viewLoading" style="text-align:center;padding:20px 0;color:var(--text-dim);font-size:0.8rem;">
      확인 중…
    </div>

    <!-- 재설정 폼 (기본 숨김) -->
    <div id="viewForm" style="display:none;">
      <p style="font-size:0.75rem;color:var(--text-dim);margin-bottom:14px;line-height:1.5;text-align:center;">
        새로운 비밀번호를 입력해주세요.
      </p>
      <div class="field">
        <label class="field-label">새 비밀번호</label>
        <div class="pw-wrap">
          <input class="input-box" type="password" id="pw1" placeholder="8자 이상 입력하세요" oninput="checkPw1(this)"/>
          <button class="pw-toggle" type="button" onclick="togglePw('pw1',this)">보기</button>
        </div>
        <div class="hint" id="pw1Hint"></div>
      </div>
      <div class="field">
        <label class="field-label">비밀번호 확인</label>
        <div class="pw-wrap">
          <input class="input-box" type="password" id="pw2" placeholder="비밀번호를 다시 입력하세요" oninput="checkPw2(this)"/>
          <button class="pw-toggle" type="button" onclick="togglePw('pw2',this)">보기</button>
        </div>
        <div class="hint" id="pw2Hint"></div>
      </div>
      <div class="error-msg" id="errMsg"></div>
      <hr class="divider"/>
      <button class="btn-submit" id="submitBtn" onclick="doReset()">
        <span class="btn-label">비밀번호 변경</span>
        <span class="btn-arrow">→</span>
      </button>
    </div>

    <!-- 링크 만료 -->
    <div id="viewExpired" style="display:none;">
      <div class="state-card">
        <div class="state-icon">⏱️</div>
        <div class="state-title">링크가 만료됐어요</div>
        <div class="state-sub">재설정 링크는 1시간 동안만 유효해요.<br>다시 요청해주세요.</div>
        <a href="/auth/find-account" class="btn-link">다시 요청하기</a>
      </div>
    </div>

    <!-- 변경 완료 -->
    <div id="viewDone" style="display:none;">
      <div class="state-card">
        <div class="state-icon">🗝️</div>
        <div class="state-title">변경 완료!</div>
        <div class="state-sub">새 비밀번호로 로그인해주세요.</div>
        <a href="/auth/login" class="btn-link">로그인하러 가기</a>
      </div>
    </div>

  </div>
  <div class="receipt-bottom"></div>
</div>
</div>

<script>
  function show(id) {
    ['viewLoading','viewForm','viewExpired','viewDone'].forEach(v => {
      document.getElementById(v).style.display = v === id ? 'block' : 'none';
    });
  }

  function togglePw(id, btn) {
    const i = document.getElementById(id);
    i.type = i.type === 'password' ? 'text' : 'password';
    btn.textContent = i.type === 'password' ? '보기' : '숨기기';
  }

  function checkPw1(el) {
    const h = document.getElementById('pw1Hint');
    if (el.value.length < 8) { h.textContent='8자 이상 입력해주세요'; h.className='hint error'; return; }
    h.textContent=''; h.className='hint ok';
    if (document.getElementById('pw2').value) checkPw2(document.getElementById('pw2'));
  }
  function checkPw2(el) {
    const h = document.getElementById('pw2Hint');
    if (el.value !== document.getElementById('pw1').value) { h.textContent='비밀번호가 일치하지 않아요'; h.className='hint error'; return; }
    h.textContent='일치합니다'; h.className='hint ok';
  }

  async function doReset() {
    const pw  = document.getElementById('pw1').value;
    const pw2 = document.getElementById('pw2').value;
    const err = document.getElementById('errMsg');
    const btn = document.getElementById('submitBtn');

    err.classList.remove('show');
    if (!pw || pw.length < 8) { err.textContent='비밀번호를 8자 이상 입력해주세요'; err.classList.add('show'); return; }
    if (pw !== pw2) { err.textContent='비밀번호가 일치하지 않아요'; err.classList.add('show'); return; }

    btn.disabled = true;
    btn.querySelector('.btn-label').innerHTML = '<span class="loading-spinner"></span>변경 중…';

    try {
      const { error } = await window._sb.auth.updateUser({ password: pw });
      if (error) throw error;
      show('viewDone');
    } catch (e) {
      btn.disabled = false;
      btn.querySelector('.btn-label').textContent = '비밀번호 변경';
      err.textContent = e.message || '오류가 발생했어요';
      err.classList.add('show');
    }
  }

  /* Supabase가 이메일 링크에서 세션을 복원하길 기다림 */
  window.addEventListener('load', async () => {
    if (!window._sb) { show('viewExpired'); return; }

    /* URL 해시에서 토큰 처리 */
    const { data: { session }, error } = await window._sb.auth.getSession();

    if (error || !session) {
      /* 해시 파라미터 직접 확인 */
      const hash = new URLSearchParams(location.hash.replace('#',''));
      const type = hash.get('type');
      if (type === 'recovery') {
        /* Supabase가 자동 처리 중 — 잠시 대기 */
        setTimeout(async () => {
          const { data: { session: s2 } } = await window._sb.auth.getSession();
          if (s2) { show('viewForm'); } else { show('viewExpired'); }
        }, 800);
      } else {
        show('viewExpired');
      }
      return;
    }

    show('viewForm');
  });

  document.addEventListener('keydown', e => { if (e.key === 'Enter') doReset(); });

  window.togglePw = togglePw;
  window.checkPw1 = checkPw1;
  window.checkPw2 = checkPw2;
  window.doReset  = doReset;
</script>


<style is:global>

    :root {
      --purple:       #EF4D6D;
      --purple-light: #F7A1B2;
      --cream:        #F7F0E5;
      --green:        #8F9D68;
      --text:         #202943;
      --text-dim:     #9D8F83;
      --error:        #c04040;
      --ok:           #4a9a6a;
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      min-height:100vh; display:flex; flex-direction:column; align-items:stretch;
      font-family:'Pretendard Variable', Pretendard, -apple-system, sans-serif;
    }
    .login-stage {
      flex:1; display:flex; align-items:center; justify-content:center;
      padding:32px 16px 48px;
    }
    .receipt {
      width:min(299px,92vw); position:relative;
    }
    .receipt-top { width:100%; height:14px; background:var(--cream); position:relative; }
    .receipt-top::before {
      content:''; position:absolute; top:0; left:0; right:0; height:14px;
      background:radial-gradient(circle at 50% -1px, transparent 7px, var(--cream) 7px) -7px 0 / 14px 14px repeat-x;
    }
    .receipt-body { padding:10px 24px 24px; }
    .receipt-bottom { width:100%; height:14px; background:var(--cream); position:relative; }
    .receipt-bottom::after {
      content:''; position:absolute; bottom:0; left:0; right:0; height:14px;
      background:radial-gradient(circle at 50% calc(100% + 1px), transparent 7px, var(--cream) 7px) -7px 0 / 14px 14px repeat-x;
    }
    .logo-wrap { display:flex; flex-direction:column; align-items:center; padding:20px 0 14px; }
    .logo-circle {
      display:flex; align-items:center; justify-content:center; margin-bottom:8px;
    }
    .logo-circle span { font-family:'Pretendard Variable', Pretendard, -apple-system, sans-serif; font-size:0.9rem; font-weight:900; color:white; letter-spacing:0.05em; }

    .receipt-sub { margin-top:2px; }
    .divider { margin:12px 0; }
    .divider-solid { margin:10px 0; }

    .field { margin-bottom:12px; }
    .field-label { margin-bottom:6px; display:block; }
    .pw-wrap { position:relative; }
    .input-box {
      width:100%; height:42px; font-size:0.85rem;
      font-family:'Pretendard Variable', Pretendard, -apple-system, sans-serif; outline:none;
      transition:border-color .2s;
    }

    .input-box::placeholder { font-size:0.78rem; }
    .pw-toggle {
      position:absolute; right:14px; top:50%; transform:translateY(-50%);
      background:none; border:none; cursor:pointer; color:var(--text-dim);
      font-size:0.75rem; font-family:'Pretendard Variable', Pretendard, -apple-system, sans-serif; padding:4px;
    }
    .pw-toggle:hover { color:var(--purple); }
    .hint { font-size:0.75rem; margin-top:4px; min-height:14px; padding-left:4px; color:var(--text-dim); }
    .hint.error { color:var(--error); }
    .hint.ok    { color:var(--ok); }

    .error-msg { font-size:0.75rem; color:var(--error); text-align:center; min-height:16px; opacity:0; transition:opacity .2s; margin:4px 0 6px; }
    .error-msg.show { opacity:1; }

    .btn-submit {
      width:100%; height:46px; border:none;
      display:flex; align-items:center; padding:0 20px; cursor:pointer;
      transition:transform .15s, box-shadow .15s; margin-top:4px;
    }
    .btn-submit:hover { transform:translateY(-2px); box-shadow:0 8px 22px rgba(239,77,109,0.45); }
    .btn-submit:disabled { opacity:.6; cursor:not-allowed; transform:none !important; }
    .btn-label { font-size:0.75rem; font-weight:700; color:rgba(255,255,255,0.8); letter-spacing:0.14em; text-transform:uppercase; flex:1; font-family:'Pretendard Variable', Pretendard, -apple-system, sans-serif; }
    .btn-arrow { font-family:'Pretendard Variable', Pretendard, -apple-system, sans-serif; font-size:1rem; color:white; }

    /* 링크 만료 / 완료 상태 */
    .state-card { text-align:center; padding:10px 0; }
    .state-icon { font-size:2rem; margin-bottom:10px; }
    .state-title { font-family:'Pretendard Variable', Pretendard, -apple-system, sans-serif; font-size:1.1rem; color:var(--purple); margin-bottom:8px; }
    .state-sub { font-size:0.76rem; color:var(--text-dim); line-height:1.6; margin-bottom:16px; }
    .btn-link {
      display:block; width:100%; padding:12px; border-radius:999px;
      background:var(--purple); color:white; text-decoration:none;
      font-size:0.75rem; font-weight:700; letter-spacing:0.08em; text-align:center;
    }

    .loading-spinner {
      display:inline-block; width:12px; height:12px;
      border:2px solid rgba(255,255,255,0.4); border-top-color:white;
      border-radius:50%; animation:spin .6s linear infinite; margin-right:6px;
    }
    @keyframes spin { to { transform:rotate(360deg); } }
  
</style>

</main>
</BaseLayout>
