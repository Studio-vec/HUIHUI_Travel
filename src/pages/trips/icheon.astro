        { id:'i2-4', time:'16:00', name:'티하우스에덴',             theme:'카페',  theme_id:'cafe',  tip:'호텔 정원에서 밀크티와 마카롱으로 당 충전', enjoyTip:'호텔 정원 산책 후 여유로운 오후 휴식', photo:null, h:16,
          transitTo:{ type:'taxi', icon:'🚕', desc:'택시 · 약 8분' },
          details:[ { icon:'🕐', label:'운영 시간', value:'10:00–21:00' }, { icon:'☕', label:'추천 메뉴', value:'밀크티+마카롱 조합' }, { icon:'🌿', label:'팁', value:'호텔 정원 산책 후 티타임 추천' } ] },
        { id:'i2-5', time:'20:30', name:'별빛정원 우주',            theme:'관광',  theme_id:'view',  tip:'야간 조명 테마파크', enjoyTip:'입장 후 분수쇼 시간 먼저 확인! 삼각대 지참 추천', photo:null, h:20.5,
          details:[ { icon:'🕐', label:'운영 시간', value:'일몰 후 입장 (계절마다 상이)' }, { icon:'💰', label:'입장료', value:'성인 15,000원 (네이버 예매 시 할인)' }, { icon:'📷', label:'포토 팁', value:'분수쇼 시간 먼저 확인! 삼각대 지참 강력 추천' } ] }
    ]},
    { places: [
        { id:'i3-1', time:'11:00', name:'호텔 체크아웃',            theme:'이동',  theme_id:'view',  tip:'테르메덴 대형 락커 이용 가능 — 짐 걱정 없음', enjoyTip:'짐 챙겨 체크아웃 후 택시 호출', photo:null, h:11,
          transitTo:{ type:'taxi', icon:'🚕', desc:'택시 · 약 20분 · 약 1.8만원' },
          details:[ { icon:'🕐', label:'체크아웃', value:'11:00 전 완료' }, { icon:'🎒', label:'짐 보관', value:'테르메덴 대형 락커 이용 가능' } ] },
        { id:'i3-2', time:'11:30', name:'테르메덴 스파',            theme:'체험',  theme_id:'spa',   tip:'네이버 예매로 할인. 수영복 필수, 짐은 락커 보관', enjoyTip:'평일 오전이 가장 한산!', photo:null, h:11.5,
          details:[ { icon:'🕐', label:'운영 시간', value:'07:00–22:00 (연중무휴)' }, { icon:'💰', label:'할인', value:'네이버 예매 시 할인' }, { icon:'🩱', label:'준비물', value:'수영복 필수 · 짐은 대형 락커 보관 가능' }, { icon:'💡', label:'팁', value:'평일 오전이 가장 한산' } ] },
