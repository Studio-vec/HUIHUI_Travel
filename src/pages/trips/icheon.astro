        { id:'i1-7', time:'19:10', name:'에덴파라다이스 호텔',     theme:'숙소',  theme_id:'party', tip:'체크인 후 치맥 + 넷플릭스 파티!', enjoyTip:'호텔 근처에 편의점이 없으니 맥주는 장작집 근처에서 반드시 구입', photo:null, h:19.1,
          details:[ { icon:'🕐', label:'체크인/아웃', value:'체크인 15:00 · 체크아웃 11:00' }, { icon:'🎬', label:'시설', value:'객실 내 넷플릭스 이용 가능' }, { icon:'🏪', label:'주의', value:'호텔 근처 편의점 없음 — 맥주는 미리 구입' } ] }
    ]},
    { places: [
        { id:'i2-1', time:'11:00', name:'나츠카페',                theme:'카페',  theme_id:'cafe',  tip:'호텔에서 택시 약 10분', enjoyTip:'시즌 한정 음료 확인. 분위기 좋은 야외 테라스 자리 추천!', photo:null, h:11,
          transitTo:{ type:'choice', icon:'🚕', desc:'도보 약 30분 (설봉공원 산책 코스) 또는 택시 7분' },
          details:[ { icon:'🕐', label:'운영 시간', value:'10:00–21:00' }, { icon:'☕', label:'추천', value:'시즌 한정 음료 확인. 야외 테라스 자리 추천' } ] },
        { id:'i2-2', time:'12:30', name:'이천시립박물관',           theme:'관광',  theme_id:'view',  tip:'2층 도자기 기획전 위주 관람 (무료 입장)', enjoyTip:'설봉공원 코스로 도보 이동도 추천!', photo:null, h:12.5,
          transitTo:{ type:'taxi', icon:'🚕', desc:'택시 · 약 10분' },
          details:[ { icon:'🕐', label:'운영 시간', value:'09:00–18:00 (월요일·공휴일 다음날 휴무)' }, { icon:'💰', label:'입장료', value:'무료' }, { icon:'🏺', label:'추천 코스', value:'2층 도자기 기획전 위주 관람' } ] },
        { id:'i2-3', time:'14:30', name:'부산얼크니샤브칼국수',    theme:'식사',  theme_id:'food',  tip:'칼국수에 미나리·버섯 추가', enjoyTip:'마지막은 볶음밥으로 마무리!', photo:null, h:14.5,
