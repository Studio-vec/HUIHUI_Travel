        { id:'i1-2', time:'13:30', name:'시래마루 이천본점',      theme:'식사',  theme_id:'food',  tip:'시래기 밥상 한정식', enjoyTip:'솥밥에 나물과 된장 소스 넣고 비빔밥 만들어 먹기!', photo:null, h:13.5,
          details:[ { icon:'🕐', label:'운영 시간', value:'11:00–21:00 (브레이크타임 15:00–17:00)' }, { icon:'🍚', label:'추천 메뉴', value:'시래기 밥상 한정식 · 솥밥에 나물+된장 소스 넣어 비빔밥으로' } ] },
        { id:'i1-3', time:'15:00', name:'이천도자예술마을',        theme:'쇼핑',  theme_id:'shop',  tip:'공방 체험은 미리 예약하기', enjoyTip:'쇼핑 강력 추천: 토화담, 우화', photo:null, h:15,
          details:[ { icon:'🕐', label:'운영 시간', value:'10:00–18:00 (월요일 휴무)' }, { icon:'📞', label:'공방 예약', value:'방문 전 온라인 또는 전화 예약 필수' }, { icon:'🛍️', label:'쇼핑 추천', value:'토화담, 우화 — 도자기 쇼핑 강력 추천' } ] },
        { id:'i1-4', time:'16:30', name:'2번 게이트 짐 찾기',      theme:'이동',  theme_id:'view',  tip:'관광안내소에서 짐 찾아 택시 호출', enjoyTip:'나오기 20분 전, 장작집에 미리 전화 포장 주문!', photo:null, h:16.5,
          transitTo:{ type:'taxi', icon:'🚕', desc:'택시 · 약 15분 · 약 1.3만원' },
