    storageKey: 'trip_icheon_v3',
    tipsKey: 'trip_icheon_tips_v1',
    tips: [],
    schedule: [
    { places: [
        { id:'i1-1', time:'13:10', name:'이천역 · 터미널 도착',  theme:'도착',  theme_id:'view',  tip:'택시 승강장에서 바로 탑승', enjoyTip:'이천도자예술마을 2번 게이트 관광안내소로 이동해 짐 맡기기', photo:null, h:13.1,
          transitTo:{ type:'taxi', icon:'🚕', desc:'택시 · 약 15분 · 약 1.2만원' },
