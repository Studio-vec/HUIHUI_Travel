---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { asset } from '../../lib/asset';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import TripArticle from '../../components/TripArticle.astro';
import TripIndex from '../../components/TripIndex.astro';
import Footer from '../../components/Footer.astro';
import { toMobileSchedule, toMobileTips, dayCountOf, tripSlug, nameEnOf, loadTrips, variantsOf } from '../../lib/tripData';
import type { TripData } from '../../lib/tripData';

export async function getStaticPaths() {
  const all = loadTrips();

  return all.map((trip) => ({
    params: { id: tripSlug(trip) },
    props: {
      tripData: trip,
      otherTrips: all.filter((t) => t.id !== trip.id && !t.secretHash),
      variants: variantsOf(trip, all),
    },
  }));
}

interface Props {
  tripData: TripData;
  otherTrips: TripData[];
  variants: TripData[];
}

const { tripData, otherTrips, variants } = Astro.props;

/* 같은 여행지의 다른 버전(커플·가족 등)으로 넘어가는 탭. 버전이 하나뿐이면 그리지 않는다 */
const variantSwitchHtml = variants.length > 1
  ? `
            <nav class="variant-switch" aria-label="여행 버전">${variants
                .map((v) => v.id === tripData.id
                  ? `<span class="variant-tab is-current" aria-current="page">${v.variantLabel}</span>`
                  : `<a class="variant-tab" href="/trips/${tripSlug(v)}">${v.variantLabel}</a>`)
                .join('')}</nav>`
  : '';

const scheduleJson = JSON.stringify(toMobileSchedule(tripData));
const tipsJson = JSON.stringify(toMobileTips(tripData));
const dayCount = dayCountOf(tripData);

/* 사진은 장소 이름·id로 새 일정에 다시 붙이므로 일정이 바뀌어도 키를 바꾸지 않는다 */
const storageKey = `trip_${tripData.id}`;
const tipsKey = `trip_${tripData.id}_tips_v1`;
const tripUrl = `/trips/${tripSlug(tripData)}`;
const momentLabel = nameEnOf(tripData);
/* 우상단에 걸어 두는 이 여행지의 열쇠. 전용 이미지가 없으면 비밀코드 열쇠를 쓴다 (card.json과 같은 규칙) */
const keyFile = existsSync(join(process.cwd(), 'public', 'assets', 'keys', `${tripData.id}.webp`))
  ? `/assets/keys/${tripData.id}.webp`
  : '/assets/keys/secret.webp';

const tripDescription = [
  `${tripData.locationLabel} ${dayCount}일 여행 코스.`,
  `${tripData.places.length}곳의 장소를 일자별 동선으로 정리했습니다.`,
  tripData.places
    .slice(0, 5)
    .map((p) => p.name)
    .join(', ') + ' 등 방문 순서, 운영시간, 이동 방법과 현장 팁을 담았습니다.',
].join(' ').slice(0, 300);

const infoBannerHtml = tripData.infoBanner
  ? `
        <div class="info-banner">
            <div class="info-banner-title">${tripData.infoBanner.title}</div>
            <div class="info-banner-text">${tripData.infoBanner.text}</div>
        </div>`
  : '';

const saveButtonHtml = tripData.downloadName
  ? `
            <button class="nav-btn primary" @click="isArtPlaying = false; showReport = true">저장</button>`
  : '';

const reportModalHtml = tripData.downloadName
  ? `
    <div class="modal-bg" v-if="showReport" @click.self="showReport = false">
        <div id="report-content" class="report-card">
            <div class="report-header">
                <div class="report-title">${momentLabel} Moment</div>
                <div class="report-sub">{{ allPhotos.length }} photos · {{ getFormattedDate(0) }} – {{ getFormattedDate(${dayCount - 1}) }}</div>
            </div>
            <div class="photo-grid">
                <div v-for="n in 9" :key="n" class="photo-grid-cell">
                    <img v-if="allPhotos[n-1]" :src="allPhotos[n-1]" alt="">
                </div>
            </div>
            <div class="report-footer">
                <button class="nav-btn" style="flex:1" @click="showReport = false">닫기</button>
                <button class="nav-btn primary" style="flex:1" @click="saveImage">저장</button>
            </div>
        </div>
    </div>`
  : '';

const _body = `
<div id="app">
    <div class="container">
        <div class="header">
            <div class="header-eyebrow">${tripData.headerEyebrow}</div>
            <h1 class="header-title">${tripData.headerTitleHtml}</h1>${variantSwitchHtml}
            <div class="header-dates">
                <div class="date-item">
                    <span class="date-label">출발</span>
                    <input type="date" v-model="startDate" class="header-date-input">
                </div>
                <span class="date-arrow">→</span>
                <div class="date-item">
                    <span class="date-label">도착</span>
                    <span class="date-static">{{ endDate }}</span>
                </div>
            </div>
            <section class="pre-check" aria-label="출발 전 확인"${tripData.infoBanner ? '' : ' v-if="closedList.length || hasClosedData || closedNotes.length"'}>
            <div class="pre-check-label">출발 전 확인</div>
            <div v-if="closedList.length" class="closed-banner" role="status">
                <div class="closed-banner-title">이 날짜엔 쉬는 곳이 {{ closedList.length }}곳 있어요</div>
                <ul class="closed-banner-list">
                    <li v-for="c in closedList" :key="c.id">Day {{ c.day }} ({{ c.wd }}) · {{ c.name }}</li>
                </ul>
                <div class="closed-banner-hint">출발일을 바꾸면 바로 다시 확인해요.</div>
            </div>
            <div v-else-if="hasClosedData" class="closed-ok" role="status">이 날짜엔 정기 휴무인 곳이 없어요{{ closedNotes.length ? ' · 공휴일인지는 아래를 확인하세요' : '' }}</div>
            <ul v-if="closedNotes.length" class="closed-notes" role="status">
                <li v-for="c in closedNotes" :key="c.id">Day {{ c.day }} · {{ c.name }} · {{ c.note }}에도 쉬어요 — 그날이 해당하는지 달력에서 확인하세요</li>
            </ul>${infoBannerHtml}
            </section>
            <div v-if="currentPlace" class="now-card">
                <div class="now-eyebrow"><span class="now-dot"></span>지금 여기</div>
                <div>
                    <div class="now-name">{{ currentPlace.name }}</div>
                    <div class="now-chips">
                        <span class="now-time">{{ currentPlace.time }}</span>
                        <span class="now-chip">{{ currentPlace.theme }}</span>
                    </div>
                </div>
                <div class="now-divider"></div>
                <div class="now-rows">
                    <div class="now-row">
                        <svg class="now-icon" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        <span class="now-row-text">{{ currentPlace.name }}, ${tripData.locationLabel}</span>
                    </div>
                    <div class="now-row">
                        <svg class="now-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <span class="now-row-text">{{ currentPlace.tip }}</span>
                    </div>
                    <div class="now-row">
                        <svg class="now-icon" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        <span class="now-row-text">{{ currentPlace.enjoyTip }}</span>
                    </div>
                </div>
            </div>
        </div>
        <div v-for="(day, dIdx) in schedule" :key="dIdx" class="day-section">
            <div class="day-label">
                <span class="day-number">Day {{ dIdx + 1 }}</span>
                <span class="day-date">{{ getFormattedDate(dIdx) }}</span>
            </div>
            <template v-for="p in day.places" :key="p.id">
                <div class="place-row" :class="{ active: currentPlace?.id === p.id }">
                    <div class="place-row-inner" @click="toggleExpand(p.id)">
                        <span class="place-time">{{ p.time }}</span>
                        <div class="place-body">
                            <div class="place-name-row">
                                <span class="place-name">{{ p.name }}</span>
                                <span class="place-tag" :class="'tag-' + p.theme_id">{{ p.theme }}</span>
                                <span v-if="isClosed(p, dIdx)" class="closed-badge">휴무일</span>
                            </div>
                            <div class="place-tip">{{ p.tip }}</div>
                        </div>
                        <svg class="expand-chevron" :class="{ open: expandedId === p.id }" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                        <div class="photo-slot" :class="{ 'has-img': p.photo }" @click.stop="p.photo ? null : clickUpload(p.id)">
                            <img v-if="p.photo" :src="p.photo" alt="" @touchstart.passive="startPress(p.id, $event)" @touchmove.passive="movePress($event)" @touchend="endPress()" @touchcancel="endPress()" @mousedown="startPress(p.id)" @mouseup="endPress()" @mouseleave="endPress()" @contextmenu.prevent>
                            <svg v-else class="photo-slot-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                                <circle cx="12" cy="13" r="4"/>
                            </svg>
                            <input type="file" :id="'file-'+p.id" hidden accept="image/*" @change="uploadPhoto($event, p.id)">
                        </div>
                    </div>
                    <div class="place-expand" :class="{ open: expandedId === p.id }">
                        <div v-if="p.enjoyTip" class="expand-enjoy">{{ p.enjoyTip }}</div>
                        <div v-if="p.details && p.details.length" class="expand-details">
                            <div v-for="d in p.details" :key="d.label" class="expand-item">
                                <span class="expand-item-label">{{ d.label }}</span>
                                <span class="expand-item-value">{{ d.value }}</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div v-if="p.transitTo" class="transit-row" :class="p.transitTo.type">
                    <div class="transit-track">
                        <div class="transit-vline"></div>
                        <div class="transit-node"></div>
                        <div class="transit-vline"></div>
                    </div>
                    <div class="transit-info">
                        <span class="transit-icon" :data-k="({'🚶':'walk','🚗':'car','🚕':'taxi','🚌':'bus','⛵':'boat'})[p.transitTo.icon] || 'car'" aria-hidden="true"></span>
                        <span class="transit-desc">{{ p.transitTo.desc }}</span>
                    </div>
                </div>
            </template>
        </div>
        <div class="tips-section">
            <div class="tips-header">
                <span class="tips-eyebrow">여행자 팁 · {{ tips.length }}</span>
                <button class="add-tip-btn" @click="showTipModal = true">+ 팁 남기기</button>
            </div>
            <div v-if="tips.length === 0" class="tips-empty">첫 번째 팁을 남겨보세요 ✦<br>방문 정보, 추천 메뉴, 주차 팁 등 뭐든 좋아요</div>
            <div v-for="tip in tips" :key="tip.id" class="tip-item">
                <div class="tip-avatar">{{ tip.avatar }}</div>
                <div class="tip-content">
                    <div class="tip-meta">
                        <span class="tip-author">{{ tip.author }}</span>
                        <span v-if="tip.isOperator" class="tip-operator-badge">운영자</span>
                        <span class="tip-date">{{ tip.date }}</span>
                    </div>
                    <div class="tip-text">{{ tip.body }}</div>
                    <button class="tip-upvote" :class="{ active: tip.upvoted }" @click="upvoteTip(tip)">↑ {{ tip.upvotes }}</button>
                </div>
            </div>
        </div>
    </div>
    <div class="bottom-nav">
        <a href="/game?trip=${tripData.id}" class="nav-btn game-nav-link">짐 싸기</a>
        <button class="nav-btn" @click="playArt" :disabled="allPhotos.length === 0" :title="allPhotos.length === 0 ? '사진을 한 장 이상 올리면 열려요' : ''">모아보기 <span class="nav-count">{{ allPhotos.length }}장</span></button>
        <button :class="['nav-btn', isVisited ? 'done' : (allPhotos.length > 0 ? 'complete' : '')]"
                @click="toggleVisited">
            {{ isVisited ? '완료됨 ✓' : '여행 완료' }}
        </button>
    </div>
    <div class="art-overlay" :class="{ show: isArtPlaying }">
        <div v-for="(piece, idx) in collagePieces" :key="idx" class="art-piece" :style="piece.style">
            <img :src="piece.src" alt="">
        </div>
        <div class="art-close">
            <button class="nav-btn" @click="isArtPlaying = false">돌아가기</button>${saveButtonHtml}
        </div>
    </div>${reportModalHtml}
    <div class="tip-modal-bg" v-if="showTipModal" @click.self="showTipModal = false">
        <div class="tip-modal-card">
            <div>
                <div class="tip-modal-title">팁 남기기</div>
                <div class="tip-modal-hint">방문 정보, 추천 메뉴, 웨이팅, 주차 등 실용적인 팁을 공유해주세요</div>
            </div>
            <input class="tip-input" v-model="newTipAuthor" placeholder="닉네임" maxlength="20">
            <textarea class="tip-textarea" v-model="newTipText" placeholder="팁 내용을 입력해주세요 (최대 200자)" maxlength="200"></textarea>
            <div class="tip-modal-btns">
                <button class="nav-btn" style="flex:1" @click="showTipModal = false">취소</button>
                <button class="nav-btn primary" style="flex:1" @click="submitTip">등록</button>
            </div>
        </div>
    </div>
    <div class="modal-bg" v-if="deleteConfirmId" @click.self="cancelDelete">
        <div class="tip-modal-card">
            <div class="tip-modal-title">사진 삭제</div>
            <div class="tip-modal-hint">이 사진을 삭제하시겠습니까?</div>
            <div class="tip-modal-btns">
                <button class="nav-btn" style="flex:1" @click="cancelDelete">취소</button>
                <button class="nav-btn primary" style="flex:1" @click="confirmDelete">삭제</button>
            </div>
        </div>
    </div></div>
<script src="${asset('/assets/js/trip-app.js')}"></script>
<script>
/* 아래 버튼 줄: 내려 읽는 동안은 숨기고, 위로 올리거나 맨 끝에 닿으면 다시 보인다 */
(function () {
    var lastY = window.scrollY, ticking = false;
    window.addEventListener('scroll', function () {
        if (ticking) return; ticking = true;
        requestAnimationFrame(function () {
            var nav = document.querySelector('.bottom-nav');
            var y = window.scrollY;
            var atEnd = window.innerHeight + y >= document.documentElement.scrollHeight - 8;
            if (nav) nav.classList.toggle('is-hidden', y > lastY + 4 && y > 120 && !atEnd);
            if (Math.abs(y - lastY) > 4) lastY = y;
            ticking = false;
        });
    }, { passive: true });
})();
createTripApp({
    tripUrl: '${tripUrl}',
    storageKey: '${storageKey}',
    ${tripData.downloadName ? `downloadName: '${tripData.downloadName}',` : ''}
    tipsKey: '${tipsKey}',
    tips: ${tipsJson},
    schedule: ${scheduleJson}
});
</script>
`;
---
<BaseLayout title={`${tripData.title} — Travel HUIHUI`} description={tripDescription} noindex={!!tripData.secretHash} app>
  <Fragment slot="head">
  <link rel="stylesheet" href={asset('/assets/css/trip.css')}>
  <link rel="stylesheet" href={asset('/assets/css/trip-article.css')}>
  </Fragment>
  <Navbar />
  <main id="main" class="trip-main">
  <div class="trip-key" aria-hidden="true">
    <span class="trip-key-rope"></span>
    <span class="trip-key-knot"></span>
    <img src={asset(keyFile)} width="416" height="1077" alt="" />
  </div>
  <TripArticle data={tripData} variantSwitchHtml={variantSwitchHtml} />
  <Fragment set:html={_body} />

  <TripIndex
    trips={otherTrips}
    compact
    title="다른 여행 코스"
    desc={`${tripData.locationLabel} 코스를 보셨다면, 같은 방식으로 정리한 다른 지역 코스도 함께 살펴보세요.`}
  />
  </main>
  <Footer />
  {tripData.secretHash && (
    <script is:inline define:vars={{ tripUrl }}>
      /* 비밀 여행지: 이 페이지를 연 브라우저의 홈 목록에 나오도록 주소만 남긴다.
         카드 정보는 홈이 매번 <주소>/card.json 에서 새로 읽고, 예전 형식 정리·중복 제거도 홈이 한다 */
      try {
        const KEY = 'huihui_unlocked';
        const saved = JSON.parse(localStorage.getItem(KEY) || '[]');
        const urls = Array.isArray(saved) ? saved : [];
        if (!urls.includes(tripUrl)) localStorage.setItem(KEY, JSON.stringify([...urls, tripUrl]));
      } catch (_) {}
    </script>
  )}
</BaseLayout>

<style>
  /* 페이지 우상단: 내비 아래 선(모바일은 머리글 위 굵은 선)에 매달린 열쇠 */
  .trip-main { position: relative; }
  .trip-key {
    position: absolute; z-index: 2; top: 0;
    right: clamp(20px, 5vw, 48px);
    width: clamp(56px, 6vw, 76px);
    display: flex; flex-direction: column; align-items: center;
    pointer-events: none;
    transform-origin: 50% 0; animation: tripKeySway 5.2s ease-in-out infinite;
  }
  .trip-key-rope { width: 1px; height: clamp(20px, 3vw, 40px); background: var(--color-text-primary, #202943); }
  .trip-key-knot { width: 9px; height: 9px; margin: -1px 0 3px; transform: rotate(45deg); border: 1.5px solid var(--color-text-primary, #202943); }
  .trip-key img { width: 100%; height: auto; display: block; filter: drop-shadow(0 6px 10px rgba(32,41,67,0.18)); }
  @keyframes tripKeySway { 0%, 100% { transform: rotate(-2.5deg); } 50% { transform: rotate(2.5deg); } }
  @media (max-width: 767px) {
    .trip-key { top: 18px; right: 28px; width: 44px; }
    .trip-key-rope { height: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .trip-key { animation: none; } }
</style>
