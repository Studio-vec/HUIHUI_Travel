---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';

const _body = `
<div id="app">
    <div class="container">
        <div class="header">
            <div class="header-eyebrow">Travel Log · Dongincheon</div>
            <h1 class="header-title">동인천<br>개항로 산책</h1>
            <div class="header-dates">
                <div class="date-item">
                    <span class="date-label">출발</span>
                    <input type="date" v-model="startDate" class="header-date-input">
                </div>
                <span class="date-arrow">→</span>
                <div class="date-item">
                    <span class="date-label">도착</span>
                    <span class="date-static">{{ endDate }}</span>
                </div>
            </div>
            <div v-if="currentPlace" class="now-card">
                <div class="now-eyebrow"><span class="now-dot"></span>지금 여기</div>
                <div>
                    <div class="now-name">{{ currentPlace.name }}</div>
                    <div class="now-chips">
                        <span class="now-time">{{ currentPlace.time }}</span>
                        <span class="now-chip">{{ currentPlace.theme }}</span>
                    </div>
                </div>
                <div class="now-divider"></div>
                <div class="now-rows">
                    <div class="now-row">
                        <svg class="now-icon" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        <span class="now-row-text">{{ currentPlace.name }}, 인천 중구</span>
                    </div>
                    <div class="now-row">
                        <svg class="now-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        <span class="now-row-text">{{ currentPlace.tip }}</span>
                    </div>
                    <div class="now-row">
                        <svg class="now-icon" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        <span class="now-row-text">{{ currentPlace.enjoyTip }}</span>
                    </div>
                </div>
            </div>
        </div>
        <div v-for="(day, dIdx) in schedule" :key="dIdx" class="day-section">
            <div class="day-label">
                <span class="day-number">Day {{ dIdx + 1 }}</span>
                <span class="day-date">{{ getFormattedDate(dIdx) }}</span>
            </div>
            <div v-for="p in day.places" :key="p.id" class="place-row" :class="{ active: currentPlace?.id === p.id }">
                <div class="place-row-inner" @click="toggleExpand(p.id)">
                    <span class="place-time">{{ p.time }}</span>
                    <div class="place-body">
                        <div class="place-name-row">
                            <span class="place-name">{{ p.name }}</span>
                            <span class="place-tag" :class="'tag-' + p.theme_id">{{ p.theme }}</span>
                        </div>
                        <div class="place-tip">{{ p.tip }}</div>
                    </div>
                    <svg class="expand-chevron" :class="{ open: expandedId === p.id }" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    <div class="photo-slot" :class="{ 'has-img': p.photo }" @click.stop="p.photo ? null : clickUpload(p.id)">
                        <img v-if="p.photo" :src="p.photo" alt="" @touchstart.prevent="startPress(p.id)" @touchend="endPress()" @mousedown="startPress(p.id)" @mouseup="endPress()" @mouseleave="endPress()" @contextmenu.prevent>
                        <svg v-else class="photo-slot-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                            <circle cx="12" cy="13" r="4"/>
                        </svg>
                        <input type="file" :id="'file-'+p.id" hidden accept="image/*" @change="uploadPhoto($event, p.id)">
                    </div>
                </div>
                <div class="place-expand" :class="{ open: expandedId === p.id }">
                    <div v-if="p.enjoyTip" class="expand-enjoy">{{ p.enjoyTip }}</div>
                    <div v-if="p.details && p.details.length" class="expand-details">
                        <div v-for="d in p.details" :key="d.label" class="expand-item">
                            <span class="expand-item-icon">{{ d.icon }}</span>
                            <div class="expand-item-content">
                                <span class="expand-item-label">{{ d.label }}</span>
                                <span class="expand-item-value">{{ d.value }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="tips-section">
            <div class="tips-header">
                <span class="tips-eyebrow">여행자 팁 · {{ tips.length }}</span>
                <button class="add-tip-btn" @click="showTipModal = true">+ 팁 남기기</button>
            </div>
            <div v-if="tips.length === 0" class="tips-empty">첫 번째 팁을 남겨보세요 ✦<br>방문 정보, 추천 메뉴, 주차 팁 등 뭐든 좋아요</div>
            <div v-for="tip in tips" :key="tip.id" class="tip-item">
                <div class="tip-avatar">{{ tip.avatar }}</div>
                <div class="tip-content">
                    <div class="tip-meta">
                        <span class="tip-author">{{ tip.author }}</span>
                        <span v-if="tip.isOperator" class="tip-operator-badge">운영자</span>
                        <span class="tip-date">{{ tip.date }}</span>
                    </div>
                    <div class="tip-text">{{ tip.body }}</div>
                    <button class="tip-upvote" :class="{ active: tip.upvoted }" @click="upvoteTip(tip)">↑ {{ tip.upvotes }}</button>
                </div>
            </div>
        </div>
    </div>
    <div class="bottom-nav">
        <button class="nav-btn" @click="playArt" :disabled="allPhotos.length === 0">모아보기</button>
        <button :class="['nav-btn', isVisited ? 'done' : (allPhotos.length > 0 ? 'complete' : '')]"
                :disabled="!isVisited && allPhotos.length === 0" @click="toggleVisited">
            {{ isVisited ? '완료됨 ✓' : '여행 완료' }}
        </button>
    </div>
    <div class="art-overlay" :class="{ show: isArtPlaying }">
        <div v-for="(piece, idx) in collagePieces" :key="idx" class="art-piece" :style="piece.style">
            <img :src="piece.src" alt="">
        </div>
        <div class="art-close">
            <button class="nav-btn" @click="isArtPlaying = false">돌아가기</button>
        </div>
    </div>
    <div class="tip-modal-bg" v-if="showTipModal" @click.self="showTipModal = false">
        <div class="tip-modal-card">
            <div>
                <div class="tip-modal-title">팁 남기기</div>
                <div class="tip-modal-hint">방문 정보, 추천 메뉴, 웨이팅, 주차 등 실용적인 팁을 공유해주세요</div>
            </div>
            <input class="tip-input" v-model="newTipAuthor" placeholder="닉네임" maxlength="20">
            <textarea class="tip-textarea" v-model="newTipText" placeholder="팁 내용을 입력해주세요 (최대 200자)" maxlength="200"></textarea>
            <div class="tip-modal-btns">
                <button class="nav-btn" style="flex:1" @click="showTipModal = false">취소</button>
                <button class="nav-btn primary" style="flex:1" @click="submitTip">등록</button>
            </div>
        </div>
    </div>
    <div class="modal-bg" v-if="deleteConfirmId" @click.self="cancelDelete">
        <div class="tip-modal-card">
            <div class="tip-modal-title">사진 삭제</div>
            <div class="tip-modal-hint">이 사진을 삭제하시겠습니까?</div>
            <div class="tip-modal-btns">
                <button class="nav-btn" style="flex:1" @click="cancelDelete">취소</button>
                <button class="nav-btn primary" style="flex:1" @click="confirmDelete">삭제</button>
            </div>
        </div>
    </div></div>
<script src="/assets/js/trip-app.js" is:inline></script>
<script>
createTripApp({
    tripUrl: '/trips/dongincheon',
    storageKey: 'trip_dongincheon_v1',
    tipsKey: 'trip_dongincheon_tips_v1',
    tips: [],
    schedule: [
        { places: [
            { id:'d1-1', time:'12:00', name:'잉글랜드 돈까스',         theme:'식사', theme_id:'food', tip:'경양식 돈까스로 추억의 점심. 연중무휴',                  enjoyTip:'오픈 직후 방문하면 대기 없이 여유롭게 시작 가능', photo:null, h:12 },
            { id:'d1-2', time:'13:00', name:'제물포구락부 & 자유공원', theme:'관광', theme_id:'view', tip:'이국적인 건축물 산책 및 인천항 조망. 월요일 휴무',         enjoyTip:'자유공원 맥아더 동상에서 인천항 전경 감상 추천', photo:null, h:13 },
            { id:'d1-3', time:'14:00', name:'근대건축전시관',           theme:'문화', theme_id:'exp',  tip:'개항기 건축물과 역사의 흔적 관람. 월요일 휴무',           enjoyTip:'인근 전시관 통합권 여부 미리 확인하면 동선 절약', photo:null, h:14 },
            { id:'d1-4', time:'14:30', name:'대불호텔 전시관',          theme:'문화', theme_id:'exp',  tip:'국내 최초 서양식 호텔 복원 전시. 월요일 휴무',            enjoyTip:'1층 재현 객실이 포토존. 30분 집중 관람으로 충분', photo:null, h:14.5 },
            { id:'d1-5', time:'15:00', name:'팟알',                    theme:'카페', theme_id:'cafe', tip:'팥빙수와 함께 고즈넉한 휴식. 월요일 휴무',               enjoyTip:'한옥 카페 분위기. 팥빙수는 시즌 한정이니 미리 확인', photo:null, h:15 },
            { id:'d1-6', time:'16:00', name:'짜장면박물관',             theme:'문화', theme_id:'exp',  tip:'짜장면의 역사와 인천 화교 문화 탐방. 월요일 휴무',        enjoyTip:'차이나타운 바로 옆. 관람 후 주변 골목 산책으로 자연스럽게 연결', photo:null, h:16 },
            { id:'d1-7', time:'17:00', name:'일광전구 라이트하우스',    theme:'카페', theme_id:'cafe', tip:'전구 공장 개조 감성 카페. 월요일 휴무',                   enjoyTip:'전구 소품 구매 가능. 조명이 예뻐 사진 잘 나옴', photo:null, h:17 },
            { id:'d1-8', time:'18:00', name:'신포 국제시장',            theme:'식사', theme_id:'food', tip:'닭강정·회 등 맥주 안주 포장. 점포별 상이',               enjoyTip:'신포닭강정이 원조. 회는 시장 안 횟집에서 포장 요청 가능', photo:null, h:18 },
            { id:'d1-9', time:'18:30', name:'인천맥주',                 theme:'식사', theme_id:'food', tip:'포장 음식과 함께 수제 맥주. 월요일 휴무',                 enjoyTip:'외부 음식 반입 가능. 탭 맥주 다양하니 소량씩 여러 종류 시도', photo:null, h:18.5 }
        ]},
        { places: [
            { id:'d2-1', time:'11:00', name:'파랑새방앗간',        theme:'카페', theme_id:'cafe', tip:'정갈한 브런치로 여유로운 시작. 화요일 휴무',          enjoyTip:'방앗간 개조 카페. 인절미 관련 메뉴가 시그니처', photo:null, h:11 },
            { id:'d2-2', time:'12:30', name:'배다리 헌책방 거리',  theme:'관광', theme_id:'view', tip:'아벨서점 등 레트로한 골목 산책. 목요일 휴무',          enjoyTip:'골목 깊숙이 들어갈수록 더 오래된 책방이 나옴', photo:null, h:12.5 },
            { id:'d2-3', time:'14:00', name:'브라운핸즈 개항로',   theme:'카페', theme_id:'cafe', tip:'폐건물의 결을 살린 감성 카페. 연중무휴',               enjoyTip:'2층 창가 자리가 채광 좋고 분위기 최고. 라떼 계열 추천', photo:null, h:14 },
            { id:'d2-4', time:'15:00', name:'포디움126 & 개항백화', theme:'체험', theme_id:'exp',  tip:'감성 소품샵 투어 및 힙한 골목 구경. 영업일 확인 필요', enjoyTip:'개항로 골목 특유의 빈티지 감성. 엽서·소품 구매하기 좋음', photo:null, h:15 },
            { id:'d2-5', time:'16:30', name:'신포 국제시장',        theme:'식사', theme_id:'food', tip:'공갈빵·만두 등 시장 간식으로 여행 마무리. 점포별 상이', enjoyTip:'귀갓길 간식 포장도 가능. 느긋하게 한 바퀴 더 돌아볼 것', photo:null, h:16.5 },
            { id:'d2-6', time:'17:30', name:'개항로 일대',          theme:'관광', theme_id:'view', tip:'저녁 산책 후 동인천역으로 이동',                        enjoyTip:'해질 무렵 개항로 건물들이 황금빛으로 물듦. 천천히 걸어서 역으로', photo:null, h:17.5 }
        ]}
    ]
});
</script>
`;
---
<BaseLayout title="동인천 개항로 여행 로그">
  <Fragment slot="head">
  <link rel="stylesheet" href="/assets/css/trip.css">
  </Fragment>
  <Navbar />
  <Fragment set:html={_body} />



</BaseLayout>
