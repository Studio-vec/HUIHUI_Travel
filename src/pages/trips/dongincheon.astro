              details:[
                { icon:'📍', label:'주소', value:'인천시 중구 송학동 일대' },
                { icon:'🕐', label:'운영시간', value:'제물포구락부 화~일 09:00 - 18:00 (월요일 휴무)' },
                { icon:'💰', label:'입장료', value:'무료' },
