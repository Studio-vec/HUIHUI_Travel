---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';

---
<BaseLayout title="갤러리 — HUIHUI Travel">
  <Fragment slot="head">
  <link rel="stylesheet" href="/assets/css/tokens.css"/>
  </Fragment>
  <Navbar />


<div class="page-header">
  <p class="page-eyebrow">Gallery</p>
  <h1 class="page-title">모든 여행의 장면들</h1>
  <p class="page-desc">열쇠를 눌러 여행의 기억을 열어보세요</p>
  <div class="search-wrap">
    <span class="search-icon">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
    </span>
    <input id="searchInput" type="text" placeholder="여행지 검색하기" oninput="filterBySearch(this.value)"/>
  </div>
</div>

<section class="key-rack-section">
  <button class="mobile-nav-btn mobile-nav-prev" id="mobileNavPrev">
    <svg width="10" height="18" viewBox="0 0 10 18" fill="none"><path d="M9 1L1 9l8 8" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="key-rack" id="keyRack"></div>
  <button class="mobile-nav-btn mobile-nav-next" id="mobileNavNext">
    <svg width="10" height="18" viewBox="0 0 10 18" fill="none"><path d="M1 1l8 8-8 8" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</section>

<!-- Dim overlay -->
<div id="khDim" onclick="closeKeyhole()"></div>

<!-- Keyhole holder (zero-size anchor at viewport center) -->
<div id="khHolder">
  <!-- Circle = keyhole head -->
  <div id="khCircleEl">
    <div id="khSphereLayer"></div>
    <div id="khPhotosEl"></div>
    <div class="kh-glass"></div>
    <button class="kh-arrow prev" id="khPrev">&#8592;</button>
    <button class="kh-arrow next" id="khNext">&#8594;</button>
    <div class="kh-nav-dots" id="khDotsEl"></div>
  </div>
  <!-- Shaft = keyhole body -->
  <div id="khShaftEl"></div>
</div>

<!-- Fixed UI layer -->
<div id="khUiLayer">
  <div id="khDestLbl"></div>
  <a href="#" id="khTripLnk">코스 보기 →</a>
  <button id="khCloseBtn" onclick="closeKeyhole()">✕</button>
</div>

<!-- Unvisited popup -->
<div class="unv-overlay" id="unvOverlay" onclick="if(event.target===this)closeUnvisited()">
  <div class="unv-card">
    <span class="unv-icon">🔒</span>
    <p class="unv-msg" id="unvMsg"></p>
    <div class="unv-btns">
      <a href="#" class="unv-go" id="unvGo">여행하러 가기</a>
      <button class="unv-cancel" onclick="closeUnvisited()">닫기</button>
    </div>
  </div>
</div>

<script is:inline>
const DESTINATIONS = [
  { id:'yeosu',       nameKo:'여수',   tagline:'남해의 빛과 바다',     storageKey:'trip_yeosu_v3',       url:'/trips/yeosu',       particle:'을' },
  { id:'icheon',      nameKo:'이천',   tagline:'도자기와 온천의 고장',  storageKey:'trip_icheon_v3',      url:'/trips/icheon',      particle:'을' },
  { id:'paju',        nameKo:'파주',   tagline:'트렌디 아트 나들이',    storageKey:'trip_paju_v1',        url:'/trips/paju',        particle:'를' },
  { id:'dongincheon', nameKo:'동인천', tagline:'레트로 감성 골목',      storageKey:'trip_dongincheon_v1', url:'/trips/dongincheon', particle:'을' },
  { id:'gangneung',   nameKo:'강릉',   tagline:'커피향 가득한 해변',    storageKey:'trip_gangneung_v1',   url:'/trips/gangneung',   particle:'을' },
  { id:'nowon',       nameKo:'노원',   tagline:'노원 나들이',           storageKey:'trip_nowon_v1',       url:'/trips/nowon',       particle:'을' },
  { id:'suwon',       nameKo:'수원',   tagline:'역사가 살아있는 도시',  storageKey:'trip_suwon_v1',       url:'/trips/suwon',       particle:'을' },
  { id:'daejeon',     nameKo:'대전',   tagline:'대전 여행',             storageKey:'trip_daejeon_v1',     url:'/trips/daejeon',     particle:'을' },
];

/* ── DATA ── */
function getVisitedSet() {
  try { return new Set(JSON.parse(localStorage.getItem('huihui_visited')||'[]')); }
  catch(e) { return new Set(); }
}
function getUserPhotos(storageKey) {
  try {
    const raw = localStorage.getItem(storageKey);
    if (!raw) return [];
    return JSON.parse(raw).flatMap(d=>d.places||[]).filter(p=>p.photo).map(p=>({photo:p.photo,name:p.name}));
  } catch(e) { return []; }
}

/* ── KEY RACK ── */
function _probeImg(src) {
  return new Promise(resolve => {
    const img = new Image();
    img.onload  = () => resolve(true);
    img.onerror = () => resolve(false);
    img.src = src;
  });
}

/* ── PC 드래그: 카드 단위 이동 (터치는 브라우저 네이티브 처리) ── */
let _pDelta = 0;
function _initDragScroll(rack) {
  let active = false, startX = 0, startSL = 0, _delta = 0;

  /* 드래그 방향으로 한 칸 이동 */
  function _stepCard(dir) {
    const rr = rack.getBoundingClientRect();
    const vc = rr.left + rr.width / 2;
    const items = [...rack.querySelectorAll('.key-item')];
    let centerItem = null, minD = Infinity;
    items.forEach(el => {
      const ir = el.getBoundingClientRect();
      const d = Math.abs(ir.left + ir.width / 2 - vc);
      if (d < minD) { minD = d; centerItem = el; }
    });
    if (!centerItem) return _snapNearest(rack);
    const idx = items.indexOf(centerItem);
    const target = items[idx + dir];
    if (!target) return _snapNearest(rack);
    const ir = target.getBoundingClientRect();
    rack.scrollTo({ left: rack.scrollLeft + (ir.left + ir.width / 2 - vc), behavior: 'smooth' });
  }

  function onMove(e) {
    if (!active || e.pointerType === 'touch') return;
    _delta = startX - e.clientX;
    rack.scrollLeft = startSL + _delta;
  }
  function onUp(e) {
    if (!active) return;
    active = false;
    rack.style.cursor = '';
    rack.style.scrollSnapType = '';
    window.removeEventListener('pointermove', onMove);
    window.removeEventListener('pointerup',   onUp);
    _pDelta = _delta;
    if (Math.abs(_delta) > 40) {
      _stepCard(_delta > 0 ? 1 : -1); // 충분히 드래그했으면 한 칸 이동
    } else {
      _snapNearest(rack); // 조금만 움직였으면 현재 카드로 복귀
    }
  }

  rack.addEventListener('pointerdown', e => {
    _pDelta = 0; _delta = 0;
    if (e.pointerType === 'touch') return;
    active = true; startX = e.clientX; startSL = rack.scrollLeft;
    rack.style.scrollSnapType = 'none';
    rack.style.cursor = 'grabbing';
    window.addEventListener('pointermove', onMove);
    window.addEventListener('pointerup',   onUp);
  });
}

function _snapNearest(rack) {
  const rr = rack.getBoundingClientRect();
  const vc = rr.left + rr.width / 2;
  let nearest = null, minD = Infinity;
  rack.querySelectorAll('.key-item').forEach(el => {
    const ir = el.getBoundingClientRect();
    const d  = Math.abs(ir.left + ir.width / 2 - vc);
    if (d < minD) { minD = d; nearest = el; }
  });
  if (nearest) {
    const ir = nearest.getBoundingClientRect();
    rack.scrollTo({ left: rack.scrollLeft + (ir.left + ir.width / 2 - vc), behavior: 'smooth' });
  }
}

/* ── 무한 스크롤 세팅 ── */
function _initInfiniteScroll(rack) {
  rack.addEventListener('scroll', () => {
    const third = rack.scrollWidth / 3;
    if (rack.scrollLeft < third * 0.4) rack.scrollLeft += third;
    else if (rack.scrollLeft > third * 2.4) rack.scrollLeft -= third;
  }, { passive: true });
}

/* ── 클릭인지 드래그인지 판단 ── */
function _wasDrag() { return Math.abs(_pDelta) > 6; }

/* ── 현재 화면에 가장 가까운 키 아이템 찾기 (무한 복사본 중) ── */
function _findBestKey(destId) {
  const rack = document.getElementById('keyRack');
  const rr = rack.getBoundingClientRect();
  const vc = rr.left + rr.width / 2;
  let best = null, minD = Infinity;
  rack.querySelectorAll(`[data-dest-id="${destId}"]`).forEach(el => {
    const ir = el.getBoundingClientRect();
    const d  = Math.abs(ir.left + ir.width / 2 - vc);
    if (d < minD) { minD = d; best = el; }
  });
  return best;
}

async function renderKeyRack() {
  const visited = getVisitedSet();

  /* 키 이미지 존재 여부 병렬 체크 */
  const probeResults = await Promise.all(
    DESTINATIONS.map(dest => _probeImg(`/assets/keys/${dest.id}.png`))
  );

  function makeKeyHtml(dest, i) {
    if (!probeResults[i]) {
      return `<div class="key-item coming-soon" data-dest-id="${dest.id}">
        <div class="key-nametag">${dest.nameKo}</div>
        <div class="key-img-wrap"><div class="key-hook"></div>
          <div style="display:flex;align-items:center;justify-content:center;width:100%;height:100%;opacity:0.2;font-size:48px;">🔑</div>
        </div>
        <div class="key-status-dot"></div>
      </div>`;
    }
    const isVisited = visited.has(dest.url);
    const cls = isVisited ? 'visited' : 'unvisited';
    return `<div class="key-item ${cls}" data-dest-id="${dest.id}" onclick="handleKeyClick('${dest.id}')">
      <div class="key-nametag">${dest.nameKo}</div>
      <div class="key-img-wrap">
        <div class="key-hook"></div>
        <img class="key-img" src="/assets/keys/${dest.id}.png" alt="${dest.nameKo}">
      </div>
      <div class="key-status-dot"></div>
    </div>`;
  }

  /* 3벌 렌더링 (무한 스크롤용: 앞·중간·뒤) */
  const oneSet = DESTINATIONS.map(makeKeyHtml).join('');
  const rack = document.getElementById('keyRack');
  rack.innerHTML = oneSet + oneSet + oneSet;

  /* 중간 세트 위치로 초기 스크롤 */
  requestAnimationFrame(() => {
    rack.scrollLeft = rack.scrollWidth / 3;
  });

  _initInfiniteScroll(rack);
  _initDragScroll(rack);
}

function handleKeyClick(id) {
  if (_wasDrag()) return; // 드래그였으면 클릭 무시
  const dest = DESTINATIONS.find(d=>d.id===id);
  if (!dest) return;
  const visited = getVisitedSet();
  if (visited.has(dest.url)) openKeyhole(dest);
  else showUnvisited(dest);
}

/* ── SOUND ── */
function playClickSound() {
  try {
    const ctx = new (window.AudioContext||window.webkitAudioContext)();
    const t = ctx.currentTime;
    const o1 = ctx.createOscillator(), o2 = ctx.createOscillator(), g = ctx.createGain();
    o1.type='square'; o1.frequency.setValueAtTime(900,t); o1.frequency.exponentialRampToValueAtTime(300,t+0.06);
    o2.type='sawtooth'; o2.frequency.setValueAtTime(1200,t); o2.frequency.exponentialRampToValueAtTime(200,t+0.05);
    g.gain.setValueAtTime(0.18,t); g.gain.exponentialRampToValueAtTime(0.001,t+0.12);
    o1.connect(g); o2.connect(g); g.connect(ctx.destination);
    o1.start(t); o1.stop(t+0.12); o2.start(t); o2.stop(t+0.08);
  } catch(e) {}
}

/* ── NEW KEYHOLE ANIMATION ── */
const delay = ms => new Promise(r => setTimeout(r, ms));
let currentPhotos = [], currentPhotoIdx = 0, khOpen = false;

async function openKeyhole(dest) {
  if (khOpen) return;
  khOpen = true;

  const photos = getUserPhotos(dest.storageKey);
  currentPhotos = photos; currentPhotoIdx = 0;

  const rack    = document.getElementById('keyRack');
  const keyItem = _findBestKey(dest.id);

  /* STEP 1 — 선택한 열쇠를 가로 중앙으로 스크롤 */
  if (keyItem) {
    const rr = rack.getBoundingClientRect();
    const ir = keyItem.getBoundingClientRect();
    rack.scrollTo({ left: rack.scrollLeft + ir.left - rr.left + ir.width/2 - rr.width/2, behavior:'smooth' });
    await delay(620);
  }

  /* 열쇠 헤드 위치 기억 (슬라이드 전) */
  const keyRect = keyItem ? keyItem.getBoundingClientRect() : null;
  const headX   = keyRect ? keyRect.left + keyRect.width / 2 : window.innerWidth  / 2;
  const headY   = keyRect ? keyRect.top  + keyRect.height * 0.14 : window.innerHeight * 0.22;

  /* STEP 2 — 찰칵 소리 */
  playClickSound();
  await delay(60);

  /* STEP 3 — 선택한 열쇠 아래로 슬라이드 */
  if (keyItem) {
    keyItem.style.transition = 'transform 0.65s cubic-bezier(0.4,0,1,1)';
    keyItem.style.transform  = 'translateY(120%)';
    keyItem.style.pointerEvents = 'none';
  }
  await delay(150);

  /* STEP 4 — 열쇠 헤드 자리에 가는 슬릿(세로 틈) 페이드인 */
  const holder = document.getElementById('khHolder');
  const circle = document.getElementById('khCircleEl');
  const shaft  = document.getElementById('khShaftEl');
  circle.style.opacity    = '1';
  shaft.style.opacity     = '1';
  circle.style.transition = 'none';
  shaft.style.transition  = 'none';
  holder.style.transition = 'none';
  holder.style.opacity    = '0';
  holder.style.display    = 'block';
  holder.style.left = headX + 'px';
  holder.style.top  = headY + 'px';
  /* 슬릿: 매우 가늘고 긴 타원 */
  circle.style.width  = '3px';
  circle.style.height = '52px';
  shaft.style.width   = '3px';
  shaft.style.height  = '30px';
  shaft.style.top     = '26px';
  await delay(30); // reflow

  holder.style.transition = 'opacity 0.22s ease';
  holder.style.opacity    = '1';
  await delay(240); // 슬릿 잠깐 보이기

  /* STEP 5 — 슬릿 → 작은 열쇠 구멍 */
  const ease = 'cubic-bezier(0.22,1,0.36,1)';
  circle.style.transition = `width 0.42s ${ease}, height 0.42s ${ease}`;
  shaft.style.transition  = `width 0.42s ${ease}, height 0.42s ${ease}, top 0.42s ${ease}`;
  holder.style.transition = 'none';
  setKeyholeSize(58);
  await delay(460);

  /* STEP 6 — 작은 열쇠 구멍 → 화면 중앙으로 이동하며 확대 */
  const diam     = Math.min(window.innerWidth * 0.78, window.innerHeight * 0.62);
  const finalTop = window.innerHeight * 0.46 + 100;
  circle.style.transition = `width 0.88s ${ease}, height 0.88s ${ease}, box-shadow 0.7s ease`;
  shaft.style.transition  = `width 0.88s ${ease}, height 0.88s ${ease}, top 0.88s ${ease}`;
  holder.style.transition = `top 0.95s ${ease}, left 0.65s ${ease}`;
  holder.style.left = '50%';
  holder.style.top  = finalTop + 'px';
  setKeyholeSize(diam);
  loadSphereContent(photos);
  document.getElementById('khDestLbl').textContent = dest.nameKo;
  document.getElementById('khTripLnk').href = dest.url;

  /* 확대 도중 보라 글로우 시작 */
  await delay(320);
  circle.classList.add('glowing');
  document.getElementById('khDim').classList.add('show');
  await delay(580);

  /* STEP 7 — 샤프트 숨기고 흰 수정구슬로 전환 */
  shaft.style.transition = 'opacity 0.45s ease';
  shaft.style.opacity    = '0';
  circle.classList.add('sphere');
  document.getElementById('khUiLayer').classList.add('show');

  /* STEP 8 — 수정구슬 완성 후 사진 스노우볼 부유 시작 */
  await delay(900);
  document.getElementById('khPhotosEl').classList.add('floating');
}

function setKeyholeSize(diam) {
  const c = document.getElementById('khCircleEl');
  const s = document.getElementById('khShaftEl');
  const r = diam / 2;
  c.style.width  = diam + 'px';
  c.style.height = diam + 'px';
  s.style.width  = (diam * 0.42) + 'px';
  s.style.height = (diam * 0.55) + 'px';
  s.style.top    = r + 'px';
}

function loadSphereContent(photos) {
  const pe = document.getElementById('khPhotosEl');
  // 화살표·점 숨김 (스노우볼 모드에선 한번에 여러 조각 표시)
  document.getElementById('khPrev').style.display  = 'none';
  document.getElementById('khNext').style.display  = 'none';
  document.getElementById('khDotsEl').innerHTML    = '';

  if (photos.length === 0) {
    pe.innerHTML = `<div class="kh-empty"><span>📷</span><span>아직 사진이 없어요</span></div>`;
    return;
  }

  /* 구슬 안에 흩뿌릴 조각 위치 (left·top·width·height: 구슬 지름 기준 %) */
  const SLOTS = [
    { l:'8%',  t:'14%', w:'40%', h:'36%' },
    { l:'52%', t:'8%',  w:'38%', h:'34%' },
    { l:'56%', t:'50%', w:'36%', h:'32%' },
    { l:'6%',  t:'54%', w:'40%', h:'36%' },
    { l:'25%', t:'30%', w:'42%', h:'38%' },
    { l:'18%', t:'6%',  w:'34%', h:'30%' },
  ];

  /* 최대 6장, 사진이 적으면 반복해서 채움 */
  const count = Math.min(6, SLOTS.length);
  const pieces = Array.from({length: count}, (_, i) => photos[i % photos.length]);

  pe.innerHTML = pieces.map((p, i) => {
    const s = SLOTS[i];
    return `<div class="kh-photo" style="left:${s.l};top:${s.t};width:${s.w};height:${s.h};">
      <img src="${p.photo}" alt="${p.name||''}" loading="lazy">
    </div>`;
  }).join('');
}

function goToPhoto(idx) {
  if (!currentPhotos.length) return;
  idx = Math.max(0, Math.min(currentPhotos.length-1, idx));
  document.querySelectorAll('#khPhotosEl .kh-photo').forEach((el,i)=>el.classList.toggle('active',i===idx));
  document.querySelectorAll('#khDotsEl .kh-dot').forEach((el,i)=>el.classList.toggle('active',i===idx));
  currentPhotoIdx = idx; updateArrows();
}
function updateArrows() {
  const p = document.getElementById('khPrev'), n = document.getElementById('khNext');
  if (p) p.disabled = currentPhotoIdx === 0;
  if (n) n.disabled = currentPhotoIdx >= currentPhotos.length-1;
}

function closeKeyhole() {
  if (!khOpen) return;
  khOpen = false;
  const circle = document.getElementById('khCircleEl');
  const shaft  = document.getElementById('khShaftEl');
  const holder = document.getElementById('khHolder');
  circle.classList.remove('sphere');
  circle.classList.remove('glowing');
  document.getElementById('khPhotosEl').classList.remove('floating');
  document.getElementById('khPrev').style.display = '';
  document.getElementById('khNext').style.display = '';
  document.getElementById('khUiLayer').classList.remove('show');
  document.getElementById('khDim').classList.remove('show');
  // 축소
  shaft.style.opacity     = '1'; // 샤프트 복원
  holder.style.opacity    = '1';
  circle.style.transition = 'width 0.4s ease-in, height 0.4s ease-in, box-shadow 0.3s ease';
  shaft.style.transition  = 'width 0.4s ease-in, height 0.4s ease-in, top 0.4s ease-in';
  holder.style.transition = 'opacity 0.35s ease';
  holder.style.opacity    = '0';
  setKeyholeSize(0);
  setTimeout(() => {
    holder.style.display = 'none';
    holder.style.opacity = '1';
    circle.style.boxShadow = '';
    // 열쇠 복원
    document.querySelectorAll('.key-item').forEach(el => {
      el.style.transition = 'transform 0.45s var(--ease-out)';
      el.style.transform  = '';
      el.style.pointerEvents = '';
    });
  }, 500);
}

/* ── TOUCH / KEYBOARD ── */
document.getElementById('khPrev').onclick = () => goToPhoto(currentPhotoIdx-1);
document.getElementById('khNext').onclick = () => goToPhoto(currentPhotoIdx+1);

let _tx = 0;
document.getElementById('khCircleEl').addEventListener('touchstart', e=>{ _tx=e.touches[0].clientX; },{passive:true});
document.getElementById('khCircleEl').addEventListener('touchend', e=>{
  const dx = e.changedTouches[0].clientX - _tx;
  if (Math.abs(dx)>30) goToPhoto(dx<0?currentPhotoIdx+1:currentPhotoIdx-1);
});
document.addEventListener('keydown', e=>{
  if (!khOpen) return;
  if (e.key==='ArrowRight') goToPhoto(currentPhotoIdx+1);
  if (e.key==='ArrowLeft')  goToPhoto(currentPhotoIdx-1);
  if (e.key==='Escape')     closeKeyhole();
});

/* ── UNVISITED POPUP ── */
function showUnvisited(dest) {
  const particle = dest.particle || '을';
  document.getElementById('unvMsg').innerHTML = `아직 <em>${dest.nameKo}</em>${particle}(를) 여행하지 않았어요!`;
  document.getElementById('unvGo').href = dest.url;
  document.getElementById('unvOverlay').classList.add('show');
}
function closeUnvisited() {
  document.getElementById('unvOverlay').classList.remove('show');
}

/* ── SEARCH ── */
function filterBySearch(val) {
  const q = val.trim().toLowerCase();
  document.querySelectorAll('.key-item').forEach(el => {
    const name = el.querySelector('.key-nametag')?.textContent?.replace(/·/g,'').trim().toLowerCase() || '';
    el.style.opacity = (!q || name.includes(q)) ? '' : '0.2';
    el.style.pointerEvents = (!q || name.includes(q)) ? '' : 'none';
  });
}

/* ── MOBILE NAV ARROWS ── */
document.getElementById('mobileNavPrev').onclick = () => {
  document.getElementById('keyRack').scrollBy({ left: -window.innerWidth, behavior: 'smooth' });
};
document.getElementById('mobileNavNext').onclick = () => {
  document.getElementById('keyRack').scrollBy({ left: window.innerWidth, behavior: 'smooth' });
};

/* ── URL PARAM: ?q= 로 갤러리 진입 시 자동 검색 ── */
(function(){
  const q = new URLSearchParams(location.search).get('q');
  if (!q) return;
  ['searchInput','hhNavSearch'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = q;
  });
  filterBySearch(q);
})();

/* ── INIT ── */
renderKeyRack();
</script>


