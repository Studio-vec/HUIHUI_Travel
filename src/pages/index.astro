---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="HUIHUI Travel — 국내 여행 안내서">
  <Navbar />


  <!-- ── NAVBAR ── -->

  <!-- ── HERO ── -->
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-eyebrow fade-up" id="heroEyebrow">Studio.Vec · 국내 여행 큐레이션</p>
      <h1 class="hero-title fade-up" id="heroTitle">
        <em>국내 여행 안내서</em>
      </h1>
      <p class="hero-desc fade-up" id="heroDesc">
        직접 다녀온 국내 여행 코스를 공유합니다.<br>
        소소한 기억들
      </p>
      <div class="hero-meta fade-up">
        <div class="checkout-pill">
          <span class="checkout-pill-dot"></span>
          <span class="checkout-pill-text" id="checkoutStatus">0/8 체크아웃 완료</span>
        </div>
        <div class="checkout-track">
          <div class="checkout-fill" id="checkoutFill" style="width:0%"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SECTION LABEL ── -->
  <div class="section-label">
    <span class="section-label-text" id="sectionLabel">여행 코스</span>
    <div class="section-label-line"></div>
  </div>

  <!-- ── KEY GRID ── -->
  <section class="grid-section">
    <div class="key-grid" id="keyGrid"></div>
  </section>

  <!-- ── BELL ── -->
  <div class="bell-wrapper" id="bellWrapper" onclick="ringBell()" title="프런트 데스크">
    <div class="bell-inner">
      <div class="bell-top" id="bellTop">
        <img class="bell-img" src="/assets/bell-up.svg" alt="bell"/>
      </div>
      <div class="bell-bottom">
        <img class="bell-img bell-img-down" src="/assets/bell-down.svg" alt=""/>
      </div>
    </div>
  </div>

  <!-- ── FOOTER ── -->
  <footer class="footer">
    <div>
      <div class="footer-brand">HUIHUI Travel</div>
      <div class="footer-tagline" style="margin-top:4px">국내 여행 안내서 · Studio.Vec</div>
    </div>
    <div class="footer-right">
      <a href="https://studiovec.framer.website/" target="_blank" rel="noopener" class="footer-link">스튜디오 소개</a>
      <a href="http://pf.kakao.com/_xipUhX/chat" target="_blank" rel="noopener" class="footer-link">기타 문의</a>
      <span class="footer-link">© 2025</span>
    </div>
  </footer>

  <!-- ── RECOMMENDATION POPUP ── -->
  <div class="rec-overlay" id="recOverlay" onclick="hideRecPopup(event)">
    <div class="rec-card" onclick="event.stopPropagation()">
      <button class="rec-close" onclick="hideRecPopup()" aria-label="닫기">×</button>
      <div class="rec-header">
        <div class="rec-icon-wrap">🔔</div>
        <div class="rec-title">프런트 데스크</div>
        <div class="rec-sub">오늘의 여행지 추천</div>
      </div>
      <div id="recContent">
        <div class="rec-loading">
          <span class="rec-loading-dot"></span>
          <span class="rec-loading-dot"></span>
          <span class="rec-loading-dot"></span>
        </div>
      </div>
    </div>
  </div>

  <!-- ── LOGIN REQUIRED POPUP ── -->
  <div class="login-req-overlay" id="loginReqOverlay" onclick="hideLoginReqPopup(event)">
    <div class="login-req-card" onclick="event.stopPropagation()">
      <div class="login-req-icon">🔑</div>
      <div class="login-req-title">로그인이 필요해요</div>
      <p class="login-req-sub">프런트 데스크 서비스는<br>회원만 이용할 수 있어요.<br>지금 바로 가입해보세요!</p>
      <div class="login-req-btns">
        <a href="/HUIHUI_Travel/auth/register.html" class="login-req-btn-primary">회원가입하기</a>
        <a href="/HUIHUI_Travel/auth/login.html" class="login-req-btn-secondary">로그인하기</a>
      </div>
      <button class="login-req-close" onclick="hideLoginReqPopup()">나중에 할게요</button>
    </div>
  </div>

  <!-- ── COMING SOON POPUP ── -->
  <div class="cs-overlay" id="csOverlay" onclick="hideComingSoonPopup(event)">
    <div class="cs-card" onclick="event.stopPropagation()">
      <div class="cs-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="9" stroke="var(--lavender-500)" stroke-width="1.8"/>
          <path d="M12 7v5.5M12 15.5v.5" stroke="var(--lavender-500)" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="cs-title">준비중이에요</div>
      <p class="cs-sub">조금만 기다려주세요.<br>곧 공개될 예정이에요!</p>
      <button class="cs-btn" onclick="hideComingSoonPopup()">확인</button>
    </div>
  </div>

  <!-- ── TOAST CONTAINER ── -->
  <div class="toast-container" id="toastContainer"></div>

  <script>
    /* ════════════════════════════════════════════
       TRIP CONFIG
       키 이미지(assets/keys/[slug].png)가 존재하면 → 오픈
       키 이미지가 없으면 → 자동으로 준비중 처리
    ════════════════════════════════════════════ */
    const TRIP_CONFIG = {
      'yeosu':       { no:1, nameKo:'여수' },
      'icheon':      { no:2, nameKo:'이천' },
      'paju':        { no:3, nameKo:'파주' },
      'dongincheon': { no:4, nameKo:'동인천' },
      'gangneung':   { no:5, nameKo:'강릉' },
      'nowon':       { no:6, nameKo:'노원' },
      'suwon':       { no:7, nameKo:'수원' },
      'daejeon':     { no:8, nameKo:'대전' },
    };

    let TRIPS = [];

    /* ── LANGUAGE ── */
    const CHECKOUT_LABELS = {
      ko: (v,n) => `${v}/${n} 체크아웃 완료`,
      en: (v,n) => `${v}/${n} checkouts complete`,
      ja: (v,n) => `${v}/${n} チェックアウト完了`,
      zh: (v,n) => `${v}/${n} 退房完成`,
    };
    const HERO_TEXTS = {
      ko: {
        eyebrow: 'Studio.Vec · 국내 여행 큐레이션',
        title:   '<em>국내 여행 안내서</em>',
        desc:    '직접 다녀온 국내 여행 코스를 공유합니다.<br>소소한 기억들',
        section: '여행 코스',
      },
      en: {
        eyebrow: 'Studio.Vec · Domestic Travel Curation',
        title:   '<em>Korea Travel Guide</em>',
        desc:    'Curated travel courses from personal visits.<br>Little memories along the way.',
        section: 'Travel Courses',
      },
      ja: {
        eyebrow: 'Studio.Vec · 国内旅行キュレーション',
        title:   '<em>国内旅行ガイド</em>',
        desc:    '実際に旅した国内旅行コースをシェアします。<br>ささやかな思い出とともに。',
        section: '旅行コース',
      },
      zh: {
        eyebrow: 'Studio.Vec · 国内旅游精选',
        title:   '<em>国内旅行指南</em>',
        desc:    '分享亲自探访的国内旅游路线。<br>留下美好的小记忆。',
        section: '旅游路线',
      },
    };
    function _currentLang() { return window.hhLang || 'ko'; }

    function _updateHeroText(code = 'ko') {
      const t = HERO_TEXTS[code];
      document.getElementById('heroEyebrow').textContent = t.eyebrow;
      document.getElementById('heroTitle').innerHTML     = t.title;
      document.getElementById('heroDesc').innerHTML      = t.desc;
      document.getElementById('sectionLabel').textContent = t.section;
    }

    document.addEventListener('hh:langchange', function (e) {
      const code = e.detail.code;
      _updateHeroText(code);
      _updateCheckoutUI(code);
      _renderGrid();
      _attachLongPress();
    });
    function goTo(url) { window.location.href = url; }

    function showComingSoonPopup() {
      document.getElementById('csOverlay').classList.add('show');
    }
    function hideComingSoonPopup(e) {
      document.getElementById('csOverlay').classList.remove('show');
    }
    function ringBell() {
      const top = document.getElementById('bellTop');
      top.classList.add('ringing');
      setTimeout(() => top.classList.remove('ringing'), 500);

      /* 로그인 여부 확인 */
      if (window._hhUser) {
        _showRecPopup();
      } else {
        document.getElementById('loginReqOverlay').classList.add('show');
      }
    }

    /* ── 로그인 유도 팝업 ── */
    function hideLoginReqPopup(e) {
      if (e && e.target !== document.getElementById('loginReqOverlay')) return;
      document.getElementById('loginReqOverlay').classList.remove('show');
    }

    /* ── 여행지 추천 팝업 ── */
    const TRIP_COORDS = {
      yeosu:       { lat: 34.7604, lon: 127.6622 },
      icheon:      { lat: 37.2722, lon: 127.4344 },
      paju:        { lat: 37.7600, lon: 126.7803 },
      dongincheon: { lat: 37.4742, lon: 126.6164 },
      gangneung:   { lat: 37.7519, lon: 128.8761 },
      nowon:       { lat: 37.6543, lon: 127.0568 },
      suwon:       { lat: 37.2636, lon: 127.0286 },
      daejeon:     { lat: 36.3504, lon: 127.3845 },
    };

    function _weatherLabel(code) {
      if (code === 0)        return { emoji: '☀️', label: '맑음' };
      if (code <= 2)         return { emoji: '🌤️', label: '대체로 맑음' };
      if (code === 3)        return { emoji: '☁️', label: '흐림' };
      if (code <= 48)        return { emoji: '🌫️', label: '안개' };
      if (code <= 55)        return { emoji: '🌦️', label: '이슬비' };
      if (code <= 65)        return { emoji: '🌧️', label: '비' };
      if (code <= 75)        return { emoji: '🌨️', label: '눈' };
      if (code <= 82)        return { emoji: '🌦️', label: '소나기' };
      return                        { emoji: '⛈️', label: '뇌우' };
    }

    function _getReason(slug, weatherCode, month) {
      const isGood  = weatherCode <= 2;
      const isRainy = weatherCode >= 51;
      const s = month >= 3 && month <= 5 ? 'sp' :
                month >= 6 && month <= 8 ? 'su' :
                month >= 9 && month <= 11 ? 'fa' : 'wi';
      const R = {
        yeosu: {
          sp: isGood ? '봄 햇살 아래 향일암과 여수 밤바다를 함께 즐기기 딱 좋은 날이에요'
                     : '봄비 내리는 여수, 돌산도 게장 골목에서 따뜻한 한 끼 어떠세요',
          su: isGood ? '시원한 바닷바람과 함께 오동도 일몰을 놓치지 마세요'
                     : '여름 소나기가 지나면 더 선명해지는 여수 밤바다예요',
          fa: isGood ? '해산물 제철인 가을, 맑은 하늘 아래 돌산대교 야경이 특별해요'
                     : '단풍 드는 가을날 게장·낙지로 배 든든히 채워보세요',
          wi: isGood ? '한겨울에도 따뜻한 여수, 오동도 동백꽃이 피기 시작해요'
                     : '추운 날엔 여수 시장 서대회 국밥 한 그릇이 최고예요',
        },
        icheon: {
          sp: isGood ? '봄볕 아래 이천 도자기 축제와 벚꽃길을 함께 즐겨보세요'
                     : '비 내리는 날 도예 체험실에서 직접 도자기를 빚어보는 건 어때요',
          su: isGood ? '설봉공원 연꽃과 이천 쌀밥 정식, 여름 나들이로 제격이에요'
                     : '여름비엔 이천 온천에서 피로를 풀어보세요',
          fa: isGood ? '황금빛 들녘과 함께 이천 쌀 문화 축제를 놓치지 마세요'
                     : '가을비엔 이천 도자 마을 실내 체험으로 특별한 하루를 만들어요',
          wi: isGood ? '맑은 겨울 하늘 아래 이천 온천 여행이 완벽한 힐링이 돼요'
                     : '눈 오는 날 이천 도자 마을에서 특별한 겨울 기억을 만들어보세요',
        },
        paju: {
          sp: isGood ? '봄꽃 가득한 헤이리 마을 산책과 임진각 나들이를 함께해보세요'
                     : '비 내리는 파주, 책방 골목에서 하루 종일 책과 커피를 즐겨보세요',
          su: isGood ? '프로방스 마을 라벤더밭과 파주 아울렛 쇼핑을 함께 즐겨보세요'
                     : '여름비엔 파주 출판도시 카페거리가 더욱 운치 있어요',
          fa: isGood ? '가을 단풍이 물드는 감악산과 헤이리 예술마을 산책을 추천해요'
                     : '흐린 날 파주 갤러리와 북카페에서 감성 충전하기 좋아요',
          wi: isGood ? '맑은 겨울날 임진각에서 역사를 느끼고 아울렛 쇼핑도 해보세요'
                     : '눈 쌓인 헤이리 마을은 그림 같은 겨울 풍경을 선물해요',
        },
        dongincheon: {
          sp: isGood ? '봄볕 아래 개항장 거리와 차이나타운 탐방이 즐거운 계절이에요'
                     : '비 내려도 차이나타운 짜장면 투어는 언제나 즐거워요',
          su: isGood ? '오랜 거리와 복합문화공간이 어우러진 동인천, 선선한 저녁 산책을 즐겨보세요'
                     : '여름비엔 수도국산 달동네 박물관에서 옛 추억을 만나보세요',
          fa: isGood ? '가을 하늘 아래 개항장 레트로 골목과 배다리 헌책방 거리를 걸어보세요'
                     : '흐린 날 동인천 오래된 빵집들을 투어하는 것도 좋아요',
          wi: isGood ? '겨울 맑은 날 차이나타운에서 공갈빵과 월병을 맛봐요'
                     : '눈 내리는 날 동인천 개항장은 더욱 낭만적인 분위기예요',
        },
        gangneung: {
          sp: isGood ? '봄 햇살 아래 경포 해변 자전거 산책과 커피 거리 탐방을 즐겨보세요'
                     : '비 내리는 강릉, 실내 카페에서 창밖 파도 소리를 들어보세요',
          su: isGood ? '에메랄드빛 경포 바다에서 물놀이와 해산물을 마음껏 즐겨보세요'
                     : '소나기 사이로 정동진 암석해안과 커피 박물관을 둘러보세요',
          fa: isGood ? '강릉 커피 축제 시즌, 바다 뷰 카페 투어를 즐겨보세요'
                     : '파도 소리 들으며 강릉 커피 거리에서 분위기 있는 하루를 보내요',
          wi: isGood ? '맑고 시린 겨울 바다, 정동진 해돋이는 인생 사진을 남겨줄 거예요'
                     : '눈 내리는 강릉 해변은 일 년 중 가장 아름다운 풍경 중 하나예요',
        },
        nowon: {
          sp: isGood ? '봄에 수락산 진달래가 만발해요, 가볍게 등산하며 서울 야경을 즐겨보세요'
                     : '봄비 내리는 노원, 불암산 자락 카페 거리에서 느긋하게 쉬어가요',
          su: isGood ? '수락산 계곡에서 발 담그며 더위를 식혀보는 게 어때요'
                     : '비 오는 날 노원 예술의 전당에서 전시와 공연을 즐겨보세요',
          fa: isGood ? '가을 단풍이 물드는 수락산 등산로는 서울 최고의 단풍 코스예요'
                     : '흐린 날 중계동 은행나무 골목에서 황금빛 가을을 만끽해요',
          wi: isGood ? '맑은 겨울 아침, 불암산 설경 산책 후 상계동 국밥 한 그릇 어때요'
                     : '눈 오는 날 수락산 설경은 서울 안에서 만나는 특별한 풍경이에요',
        },
        suwon: {
          sp: isGood ? '봄꽃 가득한 수원화성 성곽길 산책이 이보다 좋을 수 없어요'
                     : '비 내려도 수원화성 박물관과 행궁동 벽화 골목은 볼거리가 넘쳐요',
          su: isGood ? '행궁동 카페 거리와 통닭 골목, 여름 저녁 산책 코스로 딱이에요'
                     : '여름비엔 화성행궁 실내 전시를 천천히 즐겨보세요',
          fa: isGood ? '가을 하늘 아래 수원화성 야간 개장, 조명이 켜진 성벽이 환상적이에요'
                     : '흐린 날 수원 전통시장에서 왕갈비탕 한 그릇으로 몸을 녹여요',
          wi: isGood ? '맑은 겨울날 수원화성 설경 산책과 통닭 골목 투어를 추천해요'
                     : '눈 덮인 수원화성은 드라마 속 한 장면처럼 아름다워요',
        },
        daejeon: {
          sp: isGood ? '봄날 성심당 빵 투어와 엑스포 시민공원 꽃구경을 함께해요'
                     : '비 내리는 날 성심당 본점에서 튀김소보로와 부추빵을 즐겨보세요',
          su: isGood ? '계족산 황톳길 맨발 걷기와 대청호 드라이브를 추천해요'
                     : '여름비엔 국립중앙과학관 실내 탐방과 성심당 빵 투어를 즐겨보세요',
          fa: isGood ? '가을 계룡산 단풍과 유성 온천을 함께 즐겨보세요'
                     : '가을비엔 대전 중앙시장 투어로 배를 든든히 채워요',
          wi: isGood ? '겨울 성심당 빵 투어 후 유성온천에서 피로를 풀어보세요'
                     : '눈 오는 날 뜨끈한 대전 순대국밥과 성심당 빵이 최고의 조합이에요',
        },
      };
      return R[slug]?.[s] || '오늘 하루 특별한 여행을 즐겨보세요';
    }

    async function _showRecPopup() {
      const available = TRIPS.filter(t => t.status !== 'coming-soon');
      if (!available.length) { showToast('아직 공개된 여행지가 없어요'); return; }

      /* 오늘 날짜 기준 고정 픽 (하루 종일 같은 여행지) */
      const today = new Date();
      const dayOfYear = Math.floor((today - new Date(today.getFullYear(), 0, 0)) / 86400000);
      const trip = available[dayOfYear % available.length];
      const slug = trip.url.replace('trips/','').replace('.html','');
      const noStr = String(trip.no).padStart(2,'0');

      /* 팝업 먼저 열기 (로딩 상태) */
      document.getElementById('recOverlay').classList.add('show');

      /* 날씨 API 호출 */
      const coords = TRIP_COORDS[slug];
      let weatherHTML = '<span class="rec-single-weather-loading">날씨 불러오는 중…</span>';
      let reason = _getReason(slug, 3, today.getMonth() + 1); // 기본값 흐림

      if (coords) {
        try {
          const url = `https://api.open-meteo.com/v1/forecast?latitude=${coords.lat}&longitude=${coords.lon}&current=temperature_2m,weather_code&timezone=Asia%2FSeoul&forecast_days=1`;
          const res  = await fetch(url);
          const json = await res.json();
          const code = json.current.weather_code;
          const temp = Math.round(json.current.temperature_2m);
          const { emoji, label } = _weatherLabel(code);
          weatherHTML = `<span class="rec-single-weather">${emoji} ${temp}°C&nbsp;·&nbsp;${label}</span>`;
          reason = _getReason(slug, code, today.getMonth() + 1);
        } catch (_) { /* 날씨 실패 시 기본 문구 유지 */ }
      }

      const imgTag = trip.key
        ? `<img class="rec-single-key" src="${trip.key}" alt="${trip.nameKo}" loading="lazy"/>`
        : `<div class="rec-single-key-placeholder">${trip.nameKo[0]}</div>`;

      document.getElementById('recContent').innerHTML = `
        <div class="rec-single-hero">
          ${imgTag}
          <div class="rec-single-info">
            <div class="rec-single-no">No.${noStr}</div>
            <div class="rec-single-name">${trip.nameKo}</div>
            ${weatherHTML}
          </div>
        </div>
        <p class="rec-reason">"${reason}"</p>
        <a class="rec-goto" href="${trip.url}">바로가기 →</a>`;
    }

    function hideRecPopup(e) {
      if (e && e.target !== document.getElementById('recOverlay')) return;
      document.getElementById('recOverlay').classList.remove('show');
    }

    /* ── TOAST ── */
    function showToast(msg) {
      const c = document.getElementById('toastContainer');
      const t = document.createElement('div');
      t.className = 'toast';
      t.textContent = msg;
      c.appendChild(t);
      setTimeout(() => {
        t.classList.add('removing');
        setTimeout(() => t.remove(), 200);
      }, 2200);
    }

    /* ── CHECKOUT UI ── */
    function _updateCheckoutUI(code = 'ko') {
      const visited = TRIPS.filter((t, i) => _effectiveStatus(t, i) === 'visited').length;
      const total   = TRIPS.length;
      const pct     = total ? Math.round((visited / total) * 100) : 0;
      document.getElementById('checkoutStatus').textContent = CHECKOUT_LABELS[code](visited, total);
      document.getElementById('checkoutFill').style.width = pct + '%';
    }

