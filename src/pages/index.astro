    function _onKeyImgError(img) { img.outerHTML = _placeholderKey; }

    function _visitedKeyHTML(trip) {
      if (trip.key) return `<img src="${trip.key}" style="margin-top:35px" alt="key" onerror="_onKeyImgError(this)" />`;
      return _placeholderKey;
    }

    /* ── STATE (localStorage) ── */
    const VISITED_KEY  = 'huihui_visited';
    const RESERVED_KEY = 'huihui_reserved';
    const HOLD_MS      = 600;

    function _getSet(key) {
      try { return new Set(JSON.parse(localStorage.getItem(key) || '[]')); }
      catch(e) { return new Set(); }
    }
    function _saveSet(key, s) { localStorage.setItem(key, JSON.stringify([...s])); }

    let visitedSet  = _getSet(VISITED_KEY);
    let reservedSet = _getSet(RESERVED_KEY);

    function _effectiveStatus(trip, i) {
      if (visitedSet.has(trip.url)) return 'visited';
      if (reservedSet.has(i))                   return 'reserved';
      return trip.status;
    }

    /* ── RENDER CARD ── */
    function _renderCard(trip, i) {
      const s       = _effectiveStatus(trip, i);
      const cl      = 'key-card' + (s !== 'visited' ? ' ' + s : '');
      const isKo    = _currentLang() === 'ko';
      const label   = isKo ? trip.nameKo : trip.nameEn;
      const nameCls = s === 'coming-soon' ? 'card-name coming-soon' : 'card-name';
      let keyHTML   = '';
      if      (s === 'visited')     keyHTML = `<div class="card-key-img">${_visitedKeyHTML(trip)}</div>`;
      else if (s === 'reserved')    keyHTML = `<div class="card-key-img">${_reservedSVG(trip.no)}</div>`;
      else if (s === 'not-visited') keyHTML = `<div class="card-key-img">${_notVisitedSVG(trip.no, trip.tagline)}</div>`;
      else if (s === 'coming-soon') keyHTML = `<div class="card-key-img">${_comingSoonSVG(trip.no)}</div>`;
      return `<div class="${cl}" data-trip-idx="${i}"><div class="card-3d">${_cardBgSVG(i)}<div class="${nameCls}">${_nameTagSVG(i)}<span>${label}</span></div>${keyHTML}</div></div>`;
    }

    function _attachCardClicks() {
      document.querySelectorAll('[data-trip-idx]').forEach(card => {
        const i = parseInt(card.dataset.tripIdx);
        card.addEventListener('click', () => {
          const trip = TRIPS[i];
          const st   = _effectiveStatus(trip, i);
          if (st === 'coming-soon')                              showComingSoonPopup();
          else if ((st === 'visited' || st === 'not-visited') && trip.url) goTo(trip.url);
        });
      });
    }

    /* ── LONG PRESS → reserved toggle ── */
    function _toggleReserved(i) {
      if (reservedSet.has(i)) reservedSet.delete(i);
      else                    reservedSet.add(i);
      _saveSet(RESERVED_KEY, reservedSet);
      _renderGrid();
    }

    let _longPressReady = false;
    function _attachLongPress() {
      if (_longPressReady) return;
      _longPressReady = true;
      const grid = document.getElementById('keyGrid');
      let timer = null, activeCard = null;
      const cancel = () => {
        clearTimeout(timer); timer = null;
        if (activeCard) { activeCard.classList.remove('pressing'); activeCard = null; }
      };
      grid.addEventListener('pointerdown', e => {
        const card = e.target.closest('[data-trip-idx]');
        if (!card) return;
        const i = parseInt(card.dataset.tripIdx);
        if (_effectiveStatus(TRIPS[i], i) === 'visited') return;
        e.preventDefault();
        activeCard = card;
        card.classList.add('pressing');
        card.setPointerCapture(e.pointerId);
        timer = setTimeout(() => { cancel(); _toggleReserved(i); }, HOLD_MS);
      });
      grid.addEventListener('pointerup',     cancel);
      grid.addEventListener('pointercancel', cancel);
      grid.addEventListener('pointermove', e => {
        if (!timer) return;
        if (e.target.closest('[data-trip-idx]') !== activeCard) cancel();
      });
    }

    /* ── BUILD TRIPS FROM CONFIG ── */
    function _buildTrips() {
      return Object.entries(TRIP_CONFIG).map(([slug, cfg], idx) => ({
        nameEn:  slug.charAt(0).toUpperCase() + slug.slice(1),
        nameKo:  cfg.nameKo  || slug,
        status:  'not-visited',
        url:     `trips/${slug}.html`,
        no:      cfg.no      || (idx + 1),
        key:     `assets/keys/${slug}.png`,
        tagline: cfg.tagline || '',
      }));
    }

    function _renderGrid() {
      document.getElementById('keyGrid').innerHTML =
        TRIPS.map((t, i) => _renderCard(t, i)).join('');
      _updateCheckoutUI(_currentLang());
      _attachCardClicks();
    }

    /* 키 이미지가 실제로 로드되는지 확인 */
    function _probeImg(src) {
      return new Promise(resolve => {
        const img = new Image();
        img.onload  = () => resolve(true);
        img.onerror = () => resolve(false);
        img.src = src;
      });
    }

    async function _init() {
      TRIPS = _buildTrips();
      /* 키 이미지 존재 여부 병렬 체크 → 없으면 coming-soon */
      await Promise.all(TRIPS.map(async trip => {
        if (visitedSet.has(trip.url)) return; // 방문 완료는 스킵
        const exists = await _probeImg(trip.key);
        if (!exists) { trip.status = 'coming-soon'; trip.key = null; }
      }));
      _renderGrid();
      _attachLongPress();
    }

    _init();

    /* bfcache 복원 시 localStorage 재읽기 */
    window.addEventListener('pageshow', e => {
      if (!e.persisted) return;
      visitedSet  = _getSet(VISITED_KEY);
      reservedSet = _getSet(RESERVED_KEY);
      _renderGrid();
    });

  </script>
  <Footer />

<style is:global>

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--color-bg);
      color: var(--color-text-primary);
      font-family: var(--font-body);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ══════════════════════════════
       NAVBAR
    ══════════════════════════════ */
    .navbar {
      position:sticky; top:0; z-index:var(--z-fixed);
      background:rgba(255,248,235,0.82); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px);
      border-bottom:1px solid rgba(139,111,208,0.15);
      padding:0 clamp(20px,5vw,48px); height:56px;
      display:flex; align-items:center; gap:24px;
    }
    .navbar-logo {
      font-family:var(--font-display); font-size:20px;
      font-style:italic; font-weight:600; color:var(--lavender-600);
      text-decoration:none; flex-shrink:0;
    }
    .navbar-links { display:flex; gap:4px; list-style:none; }
    .navbar-links a {
      font-family:var(--font-heading); font-size:13px; font-weight:500;
      color:var(--color-text-secondary); text-decoration:none;
      padding:8px 12px; border-radius:10px;
      transition:color 150ms, background 150ms;
    }
    .navbar-links a:hover, .navbar-links a.active { color:var(--lavender-600); background:var(--lavender-50); }

    /* ── NAVBAR CENTER SEARCH (모바일) ── */
    .navbar-center-search {
      display:none;
      flex:1; justify-content:center; align-items:center;
    }
    .navbar-center-search .cs-inner {
      position:relative; display:inline-flex; align-items:center;
    }
    .navbar-center-search .cs-icon {
      position:absolute; left:13px; pointer-events:none;
      color:var(--lavender-600); display:flex; align-items:center;
    }
    .navbar-center-search input {
      font-family:var(--font-heading); font-size:12px; color:var(--color-text-secondary);
      background:rgba(255,255,255,0.7); backdrop-filter:blur(8px);
      border:1px solid rgba(139,111,208,0.25); border-radius:999px;
      padding:7px 18px 7px 34px; outline:none;
      width:clamp(130px,28vw,180px);
      transition:border-color 0.2s,background 0.2s;
    }
    .navbar-center-search input::placeholder { color:var(--color-text-tertiary); }
    .navbar-center-search input:focus { background:rgba(255,255,255,0.95); border-color:rgba(139,111,208,0.5); }

    /* ── HAMBURGER & MOBILE MENU ── */
    .hamburger-btn {
      display:none; flex-shrink:0; margin-left:auto;
      background:none; border:none; cursor:pointer;
      width:36px; height:36px; border-radius:10px;
      align-items:center; justify-content:center;
      color:var(--lavender-600); transition:background 0.15s;
    }
    .hamburger-btn:hover { background:var(--lavender-50); }
    .mobile-menu {
      position:fixed; top:56px; left:0; right:0; z-index:49;
      background:rgba(255,248,235,0.97); backdrop-filter:blur(20px);
      border-bottom:1px solid rgba(139,111,208,0.12);
      padding:8px 12px 14px; display:none; flex-direction:column;
      box-shadow:0 8px 32px rgba(80,40,160,0.1);
    }
    .mobile-menu.open { display:flex; }
    .mm-item {
      font-family:var(--font-heading); font-size:15px; font-weight:500;
      color:var(--color-text-secondary); text-decoration:none;
      padding:11px 14px; border-radius:12px;
      display:flex; align-items:center; gap:10px;
      transition:color 0.15s,background 0.15s;
      background:none; border:none; cursor:pointer; width:100%; text-align:left;
    }
    .mm-item:hover { color:var(--lavender-600); background:rgba(139,111,208,0.08); }
    .mm-item.active { color:var(--lavender-600); font-weight:600; }
    .mm-sep { height:1px; background:rgba(139,111,208,0.12); margin:4px 0; }
    @media (max-width:767px) {
      .navbar-links { display:none !important; }
      .hamburger-btn { display:flex; }
      .navbar-center-search { display:flex; }
    }

    /* ══════════════════════════════
       HERO
    ══════════════════════════════ */
    .hero {
      position: relative;
      padding: clamp(var(--space-12), 8vw, var(--space-20))
               clamp(var(--space-5), 5vw, var(--space-12))
               clamp(var(--space-10), 6vw, var(--space-16));
      overflow: hidden;
    }
    /* subtle radial glow */
    .hero::before {
      content: '';
      position: absolute;
      top: 0; right: -80px;
      width: 480px; height: 480px;
      background: radial-gradient(circle, rgba(192,168,255,0.22) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero::after {
      content: '';
      position: absolute;
      bottom: -40px; left: -60px;
      width: 320px; height: 320px;
      background: radial-gradient(circle, rgba(180,224,104,0.15) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero-inner {
      position: relative; z-index: 1;
      max-width: 1148px; margin: 0 auto;
      display: flex; flex-direction: column; gap: var(--space-5);
    }
    .hero-eyebrow {
      font-family: var(--font-heading);
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--lavender-500);
      letter-spacing: var(--tracking-widest);
      text-transform: uppercase;
    }
    .hero-title {
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(36px, 7vw, 72px);
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--color-text-primary);
    }
    .hero-title em {
      font-style: italic;
      color: var(--lavender-500);
    }
    .hero-desc {
      font-family: var(--font-body);
      font-size: clamp(var(--text-sm), 2vw, var(--text-base));
      color: var(--color-text-secondary);
      line-height: var(--leading-normal);
      max-width: 480px;
    }
    .hero-meta {
      display: flex; align-items: center; gap: var(--space-6);
      flex-wrap: wrap;
      margin-top: var(--space-2);
    }
    /* checkout pill */
    .checkout-pill {
      display: inline-flex; align-items: center; gap: var(--space-3);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-full);
      padding: var(--space-2) var(--space-4);
      box-shadow: var(--shadow-sm);
    }
    .checkout-pill-dot {
      width: 8px; height: 8px;
      border-radius: var(--radius-full);
      background: var(--lime-300);
      flex-shrink: 0;
    }
    .checkout-pill-text {
      font-family: var(--font-heading);
      font-size: var(--text-xs);
      font-weight: 500;
      color: var(--color-text-secondary);
      letter-spacing: var(--tracking-wide);
      white-space: nowrap;
    }
    /* progress track */
    .checkout-track {
      flex: 1; min-width: 120px; max-width: 200px;
      height: 4px;
      background: var(--sand-200);
      border-radius: var(--radius-full);
      overflow: hidden;
    }
    .checkout-fill {
      height: 100%;
      background: linear-gradient(to right, var(--lavender-300), var(--lime-300));
      border-radius: var(--radius-full);
      transition: width var(--dur-slower) var(--ease-out);
    }

    /* ══════════════════════════════
       SECTION LABEL
    ══════════════════════════════ */
    .section-label {
      max-width: 1148px; margin: 0 auto;
      padding: 0 clamp(var(--space-5), 5vw, var(--space-12));
      display: flex; align-items: center; gap: var(--space-4);
      margin-bottom: var(--space-6);
    }
    .section-label-text {
      font-family: var(--font-heading);
      font-size: var(--text-xs);
      font-weight: 600;
      color: var(--color-text-tertiary);
      letter-spacing: var(--tracking-widest);
      text-transform: uppercase;
      white-space: nowrap;
    }
    .section-label-line {
      flex: 1;
      height: 1px;
      background: linear-gradient(to right, var(--color-border), transparent);
    }

    /* ══════════════════════════════
       KEY GRID
    ══════════════════════════════ */
    .grid-section {
      padding: 0 clamp(var(--space-5), 5vw, var(--space-12))
               clamp(var(--space-16), 14vw, var(--space-24));
    }
    .key-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(var(--space-3), 1.5vw, var(--space-5));
      max-width: 1148px;
      margin: 0 auto;
    }
    @media (min-width: 600px) {
      .key-grid { grid-template-columns: repeat(4, 1fr); }
    }
    @media (min-width: 860px) {
      .key-grid { grid-template-columns: repeat(5, 1fr); }
    }

    /* ── Key Card ── */
    .key-card {
      position: relative; cursor: pointer;
      transition: transform var(--dur-base) var(--ease-out),
                  filter var(--dur-base) var(--ease-out);
      border-radius: var(--radius-lg);
    }
    .key-card:hover { transform: translateY(-3px); filter: brightness(1.04); }
    .key-card.coming-soon { cursor: pointer; }
    .key-card.reserved,
    .key-card.not-visited { cursor: default; }
    .key-card.coming-soon:hover,
    .key-card.reserved:hover,
    .key-card.not-visited:hover { transform: none; filter: none; }
    .key-card.reserved .card-key-img { align-items: flex-end; overflow: visible; bottom: 2%; }

    .card-3d {
      position: relative; width: 100%;
      padding-bottom: 138%;
    }
    .card-slot-img {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      display: block;
    }
    .card-name {
      position: absolute;
      top: 3%; left: 8%; right: 8%;
      z-index: 3;
    }
    .card-name-img { display: block; width: 100%; height: auto; }
    .card-name span {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-display);
      font-style: italic;
      font-size: clamp(14px, 3vw, 22px);
      font-weight: 400;
      color: var(--lavender-700);
      letter-spacing: 0.03em;
      white-space: nowrap;
    }
    .card-name.coming-soon span {
      font-family: var(--font-heading);
      font-size: clamp(9px, 1.8vw, 13px);
      font-weight: 400;
      color: var(--color-text-tertiary);
      letter-spacing: var(--tracking-wider);
    }
    .card-key-img {
      position: absolute;
      top: 20%; left: 12%; right: 12%; bottom: 14%;
      display: flex; align-items: center; justify-content: center;
      z-index: 2;
    }
    .key-card .card-key-img img {
      height: 110%; width: auto; max-width: 110%; object-fit: contain;
    }
    .card-key-img > * { transform-origin: center top; }
    .key-card:not(.coming-soon):not(.reserved):hover .card-key-img > * {
      animation: keySwing 1.2s ease-in-out infinite;
    }

    /* ── hold ring ── */
    @keyframes holdRing {
      0%   { box-shadow: inset 0 0 0 0px rgba(192,168,255,0); }
      100% { box-shadow: inset 0 0 0 10px rgba(192,168,255,0.22); }
    }
    .key-card.pressing { animation: holdRing 0.6s ease-out forwards; }

    @keyframes keySwing {
      0%   { transform: rotate(0deg); }
      15%  { transform: rotate(18deg); }
      35%  { transform: rotate(-15deg); }
      55%  { transform: rotate(10deg); }
      70%  { transform: rotate(-7deg); }
      82%  { transform: rotate(4deg); }
      91%  { transform: rotate(-2deg); }
      100% { transform: rotate(0deg); }
    }

    /* ══════════════════════════════
       BELL
    ══════════════════════════════ */
    .bell-wrapper {
      position: fixed;
      bottom: clamp(var(--space-8), 8vw, var(--space-16));
      right: clamp(var(--space-5), 3.5vw, var(--space-10));
      z-index: var(--z-overlay);
      cursor: pointer;
      width: clamp(56px, 9vw, 84px);
      height: clamp(56px, 9vw, 84px);
      user-select: none;
      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.9);
      box-shadow: 0 4px 16px rgba(107, 79, 180, 0.18), 0 1px 4px rgba(0,0,0,0.08);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: box-shadow var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out);
    }
    .bell-wrapper:hover {
      background: rgba(255, 255, 255, 0.88);
      box-shadow: 0 6px 24px rgba(107, 79, 180, 0.28), 0 2px 8px rgba(0,0,0,0.10);
    }
    .bell-inner {
      width: 62%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .bell-top { position: relative; z-index: 2; transform-origin: center bottom; }
    .bell-top.ringing { animation: bellRingTop 0.45s ease; }
    .bell-bottom { position: relative; z-index: 1; margin-top: -4%; }
    .bell-img { width: 100%; height: auto; display: block; }
    .bell-img-down { margin-top: -6%; }

    @keyframes bellRingTop {
      0%   { transform: rotate(0deg) translateY(0); }
      20%  { transform: rotate(14deg) translateY(-4px); }
      40%  { transform: rotate(-11deg) translateY(-2px); }
      60%  { transform: rotate(8deg) translateY(-3px); }
      80%  { transform: rotate(-5deg) translateY(-1px); }
      100% { transform: rotate(0deg) translateY(0); }
    }

    /* ══════════════════════════════
       FOOTER
    ══════════════════════════════ */
    .footer {
      border-top: 1px solid var(--color-border);
      padding: var(--space-8) clamp(var(--space-5), 5vw, var(--space-12));
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: var(--space-4);
    }
    .footer-brand {
      font-family: var(--font-display);
      font-style: italic;
      font-size: var(--text-lg);
      color: var(--lavender-500);
      letter-spacing: var(--tracking-wide);
    }
    .footer-tagline {
      font-family: var(--font-heading);
      font-size: var(--text-xs);
      color: var(--color-text-tertiary);
      letter-spacing: var(--tracking-wider);
      text-transform: uppercase;
    }
    .footer-right {
      display: flex; gap: var(--space-5); align-items: center;
    }
    .footer-link {
      font-family: var(--font-heading);
      font-size: var(--text-xs);
      color: var(--color-text-tertiary);
      text-decoration: none;
      letter-spacing: var(--tracking-wide);
      transition: color var(--dur-fast);
    }
    .footer-link:hover { color: var(--lavender-500); }

    /* ══════════════════════════════
       RECOMMENDATION POPUP (벨)
    ══════════════════════════════ */
    .rec-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(42,31,72,0.45); backdrop-filter: blur(6px);
      z-index: var(--z-modal); align-items: center; justify-content: center;
      padding: 20px;
    }
    .rec-overlay.show { display: flex; }
    .rec-card {
      background: var(--color-surface);
      border-radius: var(--radius-2xl);
      padding: var(--space-8) var(--space-8) var(--space-6);
      max-width: 360px; width: 100%;
      box-shadow: var(--shadow-xl);
      animation: slideUp 0.22s var(--ease-out);
      position: relative;
    }
    .rec-close {
      position: absolute; top: 14px; right: 16px;
      background: none; border: none; cursor: pointer;
      font-size: 1.2rem; color: var(--color-text-tertiary);
      line-height: 1; padding: 4px; border-radius: 6px;
      transition: color .15s, background .15s;
    }
    .rec-close:hover { color: var(--color-text-primary); background: rgba(139,111,208,0.08); }
    .rec-header { text-align: center; margin-bottom: var(--space-5); }
    .rec-icon-wrap {
      width: 44px; height: 44px; background: var(--lavender-100);
      border-radius: var(--radius-full);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto var(--space-3); font-size: 1.2rem;
    }
    .rec-title {
      font-family: var(--font-display); font-style: italic;
      font-size: var(--text-xl); color: var(--color-text-primary);
      letter-spacing: var(--tracking-tight);
    }
    .rec-sub { font-size: var(--text-xs); color: var(--color-text-tertiary); margin-top: 3px; }
    /* 단일 추천 카드 */
    .rec-single-hero {
      display: flex; align-items: flex-start; gap: 16px;
      padding: 14px 16px; border-radius: var(--radius-xl);
      background: var(--lavender-50);
      border: 1px solid rgba(139,111,208,0.12);
      margin-bottom: 14px;
    }
    .rec-single-key {
      width: 52px; flex-shrink: 0; object-fit: contain;
    }
    .rec-single-key-placeholder {
      width: 52px; height: 72px; flex-shrink: 0; border-radius: 8px;
      background: linear-gradient(160deg, var(--lavender-200), var(--lavender-400));
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-display); font-style: italic; font-size: 1.1rem; color: white;
    }
    .rec-single-info { flex: 1; min-width: 0; }
    .rec-single-no { font-size: 10px; color: var(--color-text-tertiary); letter-spacing: .12em; margin-bottom: 2px; }
    .rec-single-name {
      font-family: var(--font-display); font-style: italic;
      font-size: 1.7rem; color: var(--color-text-primary);
      line-height: 1.1; letter-spacing: var(--tracking-tight);
    }
    .rec-single-weather {
      display: inline-flex; align-items: center; gap: 5px;
      margin-top: 8px; padding: 4px 10px;
      background: rgba(255,255,255,0.8); border-radius: 999px;
      border: 1px solid rgba(139,111,208,0.15);
      font-size: var(--text-xs); color: var(--color-text-secondary);
    }
    .rec-single-weather-loading {
      margin-top: 8px; font-size: var(--text-xs); color: var(--color-text-tertiary);
    }
    .rec-reason {
      font-size: var(--text-sm); color: var(--color-text-secondary);
      line-height: 1.65; margin-bottom: 14px; padding: 0 2px;
      font-style: italic;
    }
    .rec-goto {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      width: 100%; padding: 12px;
      background: var(--lavender-300); color: var(--lavender-700);
      border: none; border-radius: var(--radius-full);
      font-family: var(--font-heading); font-size: var(--text-sm); font-weight: 600;
      letter-spacing: var(--tracking-wide); text-decoration: none; cursor: pointer;
      transition: background .15s, box-shadow .15s; display: flex;
    }
    .rec-goto:hover { background: var(--lavender-400); color: #fff; box-shadow: var(--shadow-brand); }
    .rec-loading {
      text-align: center; padding: 24px 0;
      font-size: var(--text-sm); color: var(--color-text-tertiary);
    }
    .rec-loading-dot {
      display: inline-block; width: 6px; height: 6px; border-radius: 50%;
      background: var(--lavender-300); margin: 0 2px;
      animation: recDot 1.2s ease-in-out infinite;
    }
    .rec-loading-dot:nth-child(2) { animation-delay: .2s; }
    .rec-loading-dot:nth-child(3) { animation-delay: .4s; }
    @keyframes recDot { 0%,80%,100% { opacity:.2; transform:scale(.8); } 40% { opacity:1; transform:scale(1); } }

    /* 로그인 유도 팝업 */
    .login-req-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(42,31,72,0.45); backdrop-filter: blur(6px);
      z-index: var(--z-modal); align-items: center; justify-content: center;
    }
    .login-req-overlay.show { display: flex; }
    .login-req-card {
      background: var(--color-surface);
      border-radius: var(--radius-2xl);
      padding: var(--space-10) var(--space-10) var(--space-8);
      text-align: center; max-width: 300px; width: 88%;
      box-shadow: var(--shadow-xl);
      animation: slideUp 0.22s var(--ease-out);
    }
    .login-req-icon {
      width: 52px; height: 52px; background: var(--lavender-100);
      border-radius: var(--radius-full);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto var(--space-4); font-size: 1.4rem;
    }
    .login-req-title {
      font-family: var(--font-display); font-style: italic;
      font-size: var(--text-xl); color: var(--color-text-primary);
      margin-bottom: var(--space-2);
    }
    .login-req-sub {
      font-size: var(--text-sm); color: var(--color-text-secondary);
      line-height: var(--leading-normal); margin-bottom: var(--space-6);
    }
    .login-req-btns { display: flex; flex-direction: column; gap: 8px; }
    .login-req-btn-primary {
      display: block; width: 100%; padding: var(--space-3) var(--space-6);
      background: var(--lavender-300); color: var(--lavender-700);
      border: none; border-radius: var(--radius-full);
      font-family: var(--font-heading); font-size: var(--text-sm); font-weight: 600;
      letter-spacing: var(--tracking-wide); cursor: pointer; text-decoration: none;
      transition: background .15s, box-shadow .15s;
    }
    .login-req-btn-primary:hover { background: var(--lavender-400); color: #fff; box-shadow: var(--shadow-brand); }
    .login-req-btn-secondary {
      display: block; width: 100%; padding: var(--space-3) var(--space-6);
      background: none; color: var(--color-text-tertiary);
      border: 1px solid var(--color-border); border-radius: var(--radius-full);
      font-family: var(--font-heading); font-size: var(--text-sm); font-weight: 500;
      cursor: pointer; text-decoration: none;
      transition: border-color .15s, color .15s;
    }
    .login-req-btn-secondary:hover { border-color: var(--lavender-300); color: var(--lavender-500); }
    .login-req-close {
      margin-top: 10px; background: none; border: none; cursor: pointer;
      font-size: var(--text-xs); color: var(--color-text-tertiary);
      font-family: var(--font-heading);
    }
    .login-req-close:hover { color: var(--color-text-secondary); }

    /* ══════════════════════════════
       COMING SOON POPUP
    ══════════════════════════════ */
    .cs-overlay {
      display: none;
      position: fixed; inset: 0;
      background: rgba(42, 31, 72, 0.40);
      backdrop-filter: blur(4px);
      z-index: var(--z-modal);
      align-items: center; justify-content: center;
    }
    .cs-overlay.show { display: flex; }
    .cs-card {
      background: var(--color-surface);
      border-radius: var(--radius-2xl);
      padding: var(--space-10) var(--space-10) var(--space-8);
      text-align: center;
      max-width: 300px; width: 88%;
      box-shadow: var(--shadow-xl);
      animation: slideUp 0.22s var(--ease-out);
    }
    @keyframes slideUp {
      from { transform: translateY(16px); opacity: 0; }
      to   { transform: translateY(0);    opacity: 1; }
    }
    .cs-icon {
      width: 48px; height: 48px;
      background: var(--lavender-100);
      border-radius: var(--radius-full);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto var(--space-5);
    }
    .cs-title {
      font-family: var(--font-display);
      font-style: italic;
      font-size: var(--text-2xl);
      color: var(--color-text-primary);
      margin-bottom: var(--space-3);
      letter-spacing: var(--tracking-tight);
    }
    .cs-sub {
      font-size: var(--text-sm);
      color: var(--color-text-secondary);
