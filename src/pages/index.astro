    /* ══════════════════════════════
       BELL
    ══════════════════════════════ */
    .bell-wrapper {
      position: fixed;
      bottom: clamp(var(--space-8), 8vw, var(--space-16));
      right: clamp(var(--space-5), 3.5vw, var(--space-10));
      z-index: var(--z-overlay);
      cursor: pointer;
      width: clamp(56px, 9vw, 84px);
      height: clamp(56px, 9vw, 84px);
      user-select: none;
      background: var(--color-surface);
      border-radius: 50%;
      border: 1px solid var(--color-text-primary);
      box-shadow: 0 4px 14px rgba(32,41,67,0.08);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: box-shadow var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out);
    }
    @media (max-width: 599px) {
      .bell-wrapper { width: 48px; height: 48px; bottom: 16px; right: 16px; }
    }
    /* 히어로의 '오늘의 여행지 추천 받기' 버튼이 보이는 동안은 같은 기능인 떠 있는 종을 숨긴다
       (첫 화면에서 카드 글자를 가리지 않게) */
    .bell-wrapper { transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out), visibility var(--dur-base), box-shadow var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out); }
    .bell-wrapper.is-hidden { opacity: 0; transform: translateY(12px) scale(.9); visibility: hidden; pointer-events: none; }
    /* 페이지 맨 아래(푸터)가 떠 있는 종에 가려지지 않도록 종 크기 + 여백만큼 아래 공간을 둔다 */
    body:has(#bellWrapper) {
      padding-bottom: calc(clamp(var(--space-8), 8vw, var(--space-16)) + clamp(56px, 9vw, 84px));
    }
    @media (max-width: 599px) {
      body:has(#bellWrapper) { padding-bottom: 72px; }
    }
    .bell-wrapper:hover {
      background: #fff;
      box-shadow: 0 8px 22px rgba(32,41,67,0.14);
    }
    .bell-wrapper { padding: 0; font: inherit; color: inherit; }
    .pung-svg { width: 54%; height: auto; display: block; overflow: visible; }
    /* 풍경: 종은 줄 끝을, 물고기는 종 입구를 축으로 흔들린다 */
    .pung-bell { transform-box: view-box; transform-origin: 30px 6px; }
    .pung-fish { transform-box: view-box; transform-origin: 30px 40px; }
    .bell-wrapper:hover .pung-fish, .bell-wrapper:focus-visible .pung-fish { animation: pungFish 1.6s ease-in-out infinite; }
    .pung-bell.ringing { animation: pungRing 1.3s cubic-bezier(.3,.7,.4,1); }
