    async function _showRecPopup() {
      const available = TRIPS.filter(t => t.status !== 'coming-soon');
      if (!available.length) { showToast('아직 공개된 여행지가 없어요'); return; }

      /* 오늘 날짜 기준 고정 픽 (하루 종일 같은 여행지) */
      const today = new Date();
      const dayOfYear = Math.floor((today - new Date(today.getFullYear(), 0, 0)) / 86400000);
      const trip = available[dayOfYear % available.length];
      const slug = trip.url.replace('/trips/','');

      /* 팝업 먼저 열기 (로딩 상태) */
      document.getElementById('recOverlay').classList.add('show');

      /* 날씨 API 호출 */
      const coords = TRIP_COORDS[slug];
      let weatherHTML = '<span class="rec-single-weather-loading">날씨 불러오는 중…</span>';
      let reason = _getReason(slug, 3, today.getMonth() + 1); // 기본값 흐림

      if (coords) {
        try {
          const url = `https://api.open-meteo.com/v1/forecast?latitude=${coords.lat}&longitude=${coords.lon}&current=temperature_2m,weather_code&timezone=Asia%2FSeoul&forecast_days=1`;
          const res  = await fetch(url);
          const json = await res.json();
          const code = json.current.weather_code;
          const temp = Math.round(json.current.temperature_2m);
          const { emoji, label } = _weatherLabel(code);
          weatherHTML = `<span class="rec-single-weather">${emoji} ${temp}°C&nbsp;·&nbsp;${label}</span>`;
          reason = _getReason(slug, code, today.getMonth() + 1);
        } catch (_) { /* 날씨 실패 시 기본 문구 유지 */ }
      }

      const imgTag = trip.key
        ? `<img class="rec-single-key" src="${trip.key}" alt="${_esc(trip.nameKo)}" loading="lazy"/>`
        : `<div class="rec-single-key-placeholder">${_esc(trip.nameKo[0])}</div>`;

      document.getElementById('recContent').innerHTML = `
        <div class="rec-single-hero">
          <div class="rec-key-stage">${imgTag}</div>
          <div class="rec-single-info">
            <div class="rec-single-name">${_esc(trip.nameKo)}</div>
            ${weatherHTML}
          </div>
        </div>
        <p class="rec-reason">"${reason}"</p>
        <a class="rec-goto" href="${trip.url}">바로가기 →</a>`;
    }

    function hideRecPopup(e) {
      if (e && e.target !== document.getElementById('recOverlay')) return;
      document.getElementById('recOverlay').classList.remove('show');
    }

    /* ── TOAST ── */
    function showToast(msg) {
      const c = document.getElementById('toastContainer');
      const t = document.createElement('div');
      t.className = 'toast';
      t.textContent = msg;
      c.appendChild(t);
      setTimeout(() => {
        t.classList.add('removing');
        setTimeout(() => t.remove(), 200);
      }, 2200);
    }

    /* ── UTILITIES ── */
    function _fmtNo(no) { return String(no).padStart(2, '0'); }

    /* ════════════════════════════════════════════
       CARD SVG TEMPLATES  (전통 테마: 한지·연지·금)
    ════════════════════════════════════════════ */
    /* 카드 그림: 머리글 아래 가는 선에서 내려온 연지 끈 + 선으로 그린 생쪽매듭. 틀과 글자는 HTML/CSS가 맡는다 */
    /* 열쇠 그림 뒤: 줄 맨 위 창방 선에서 내려온 네이비 끈 + 매듭 */
    /* 즐겨찾기한 여행지는 매듭 대신 연지색 매화를 단다 */
    const _CARD_KNOT   = `<g transform="translate(100 16)"><path d="${window.__KNOT_PATH__}" stroke="#202943" stroke-opacity=".8" stroke-width="1"/></g>`;
    const _CARD_FLOWER = `<g transform="translate(100 16) scale(1.1)"><path d="${window.__FLOWER_PATH__}" fill="#FBE3E7" stroke="#EF4D6D" stroke-width=".9"/></g>`;
    function _cardBg(fav) {
      return `<svg class="card-slot-img" viewBox="0 0 200 240" fill="none" xmlns="http://www.w3.org/2000/svg" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path d="M100 0V34" stroke="#202943" stroke-opacity=".7" stroke-width="1.1"/>
${fav ? _CARD_FLOWER : _CARD_KNOT}
</svg>`;
    }
    const _CARD_BG = _cardBg(false);

    /* 준비 중: 아직 걸리지 않은 열쇠 자리 — 점선으로 그린 열쇠 윤곽 */
    function _comingSoonSVG() {
      return `<svg style="width:46%;height:92%" viewBox="0 0 80 200" fill="none" stroke="#202943" stroke-opacity=".28" stroke-width="1.2" stroke-dasharray="3 4" stroke-linecap="round" aria-hidden="true">
  <circle cx="40" cy="34" r="26"/><circle cx="40" cy="34" r="12"/>
  <path d="M40 60V184M40 150H54V160H46M40 168H52V178H40"/>
  <text x="40" y="112" text-anchor="middle" font-family="Pretendard,sans-serif" font-size="9" letter-spacing="3" fill="#646B84" stroke="none">SOON</text>
</svg>`;
    }

    /* 예약: 열쇠 대신 걸어 둔 종이 꼬리표 */
    function _reservedSVG() {
      return `<svg style="width:62%;height:82%" viewBox="0 0 120 190" fill="none" aria-hidden="true">
  <path d="M60 0V30" stroke="#EF4D6D" stroke-width="1.2"/>
  <path d="M30 40L60 26L90 40V180H30Z" fill="#FBF7F0" stroke="#202943" stroke-width="1.2"/>
  <circle cx="60" cy="40" r="4" stroke="#202943" stroke-width="1.2"/>
  <path d="M40 70H80M40 150H80" stroke="#202943" stroke-opacity=".3"/>
  <text x="60" y="114" text-anchor="middle" font-family="Pretendard,sans-serif" font-size="17" font-weight="600" fill="#202943">예약</text>
  <text x="60" y="134" text-anchor="middle" font-family="Pretendard,sans-serif" font-size="8" letter-spacing="3" fill="#EF4D6D">RESERVED</text>
</svg>`;
    }

    const _placeholderKey = `<svg style="width:60%;height:70%" viewBox="0 0 80 200" fill="none" xmlns="http://www.w3.org/2000/svg">
<circle cx="40" cy="38" r="30" stroke="#EF4D6D" stroke-width="2.5" fill="rgba(232,163,163,0.15)"/>
<circle cx="40" cy="38" r="20" stroke="#D06A6E" stroke-width="1.8" fill="rgba(250,234,235,0.25)"/>
<circle cx="40" cy="38" r="8" fill="rgba(239,77,109,0.25)" stroke="#EF4D6D" stroke-width="1.5"/>
<rect x="37" y="68" width="6" height="100" rx="3" fill="rgba(239,77,109,0.35)" stroke="#EF4D6D" stroke-width="1.5"/>
<rect x="43" y="110" width="12" height="8" rx="2" fill="rgba(239,77,109,0.45)" stroke="#EF4D6D" stroke-width="1.2"/>
<rect x="43" y="126" width="8"  height="8" rx="2" fill="rgba(239,77,109,0.45)" stroke="#EF4D6D" stroke-width="1.2"/>
<rect x="43" y="142" width="12" height="8" rx="2" fill="rgba(239,77,109,0.45)" stroke="#EF4D6D" stroke-width="1.2"/>
</svg>`;

    function _onKeyImgError(img) { img.outerHTML = _placeholderKey; }

    /* 여행지 정보를 innerHTML 템플릿에 넣기 전에 escape */
    function _esc(v) {
      return String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    }

    function _keyImgHTML(trip, i) {
      const lazy = i >= 10 ? 'loading="lazy" ' : '';
      if (trip.key) return `<img src="${trip.key}" ${lazy}width="416" height="1077" alt="${_esc(trip.nameKo)} 열쇠" onerror="_onKeyImgError(this)" />`;
      return _placeholderKey;
    }

    /* ── STATE (localStorage) ── */
    const RESERVED_KEY = 'huihui_reserved';
    const HOLD_MS      = 600;

    function _getSet(key) {
      try { return new Set(JSON.parse(localStorage.getItem(key) || '[]')); }
      catch(e) { return new Set(); }
    }
    function _saveSet(key, s) { localStorage.setItem(key, JSON.stringify([...s])); }

    let reservedSet = new Set(); // _init 에서 TRIPS 를 만든 뒤 읽는다

    /* 즐겨찾기: 여행지 상세페이지 우상단 매듭을 누르면 그 주소가 남는다.
       버전 묶음 카드는 묶음 안 어느 버전을 즐겨찾아도 즐겨찾기로 본다 */
    const FAV_KEY = 'huihui_favorites';
    let favSet = new Set();
    function _isFav(trip) {
      if (favSet.has(trip.url)) return true;
      const cfg = Object.values(TRIP_CONFIG).find(c => c.url === trip.url);
      return !!(cfg && (cfg.aliases || []).some(a => favSet.has(a)));
    }

    /* 첫 페이지에서는 '여행 완료(방문)' 여부와 무관하게 키 이미지가 있으면 항상 걸려 있는 키로 보여준다.
       방문 상태는 갤러리에서만 사용. */
    function _effectiveStatus(trip) {
      if (reservedSet.has(trip.url)) return 'reserved';
      return trip.status;
    }

    /* ── RENDER CARD ── */
    function _renderCard(trip, i) {
      const s       = _effectiveStatus(trip);
      const fav     = _isFav(trip);
      const cl      = 'key-card' + (s !== 'open' ? ' ' + s : '') + (fav ? ' fav' : '');
      const isKo    = _currentLang() === 'ko';
      const label   = isKo ? trip.nameKo : trip.nameEn;
      const nameCls = s === 'coming-soon' ? 'card-name coming-soon' : 'card-name' + (label.length > 5 ? ' long' : '');
      /* 고를 때 먼저 보는 기간은 카드 머리에, 장소·지역은 카드 아래에 */
      const metaTxt = s === 'coming-soon' ? '준비 중' : [trip.nights, trip.loc].filter(Boolean).join(' · ');
      let keyHTML   = '';
      if      (s === 'open')        keyHTML = `<div class="card-key-img">${_keyImgHTML(trip, i)}</div>`;
      else if (s === 'reserved')    keyHTML = `<div class="card-key-img">${_reservedSVG()}</div>`;
      else if (s === 'coming-soon') keyHTML = `<div class="card-key-img">${_comingSoonSVG()}</div>`;
      return `<div class="${cl}" data-trip-idx="${i}"><div class="card-3d">${_cardBg(fav)}${keyHTML}</div><div class="card-cap"><span class="${nameCls}">${_esc(label)}</span><span class="card-meta">${_esc(metaTxt)}</span></div></div>`;
    }

    function _attachCardClicks() {
      document.querySelectorAll('[data-trip-idx]').forEach(card => {
        const i = parseInt(card.dataset.tripIdx);
        card.addEventListener('click', () => {
          const trip = TRIPS[i];
          const st   = _effectiveStatus(trip);
          if (st === 'coming-soon')                              showComingSoonPopup();
          else if (st === 'open' && trip.url) goTo(trip.url);
        });
      });
    }

    /* ── LONG PRESS → reserved toggle ── */
    function _toggleReserved(i) {
      const url = TRIPS[i].url;
      if (reservedSet.has(url)) reservedSet.delete(url);
      else                      reservedSet.add(url);
      _saveSet(RESERVED_KEY, reservedSet);
      _renderGrid();
    }

    let _longPressReady = false;
    function _attachLongPress() {
      if (_longPressReady) return;
      _longPressReady = true;
      const grid = document.getElementById('keyGrid');
      let timer = null, activeCard = null;
      const cancel = () => {
        clearTimeout(timer); timer = null;
        if (activeCard) { activeCard.classList.remove('pressing'); activeCard = null; }
      };
      grid.addEventListener('pointerdown', e => {
        const card = e.target.closest('[data-trip-idx]');
        if (!card) return;
        const i = parseInt(card.dataset.tripIdx);
        e.preventDefault();
        activeCard = card;
        card.classList.add('pressing');
        card.setPointerCapture(e.pointerId);
        timer = setTimeout(() => { cancel(); _toggleReserved(i); }, HOLD_MS);
      });
      grid.addEventListener('pointerup',     cancel);
      grid.addEventListener('pointercancel', cancel);
      grid.addEventListener('pointermove', e => {
        if (!timer) return;
        if (e.target.closest('[data-trip-idx]') !== activeCard) cancel();
      });
    }

    /* ── BUILD TRIPS FROM CONFIG ── */
    /* 이 브라우저에서 한 번 연 비밀 여행지. 저장된 건 주소뿐이고, 카드 정보는 매번 <주소>/card.json 에서 읽는다.
       404(코드 변경·삭제·공개 전환)면 목록에서 지우고, 네트워크 오류면 이번에만 빼 둔다. */
    const UNLOCKED_KEY = 'huihui_unlocked';

    async function _unlockedTrips(publicUrls) {
      let saved = [];
      try {
        const parsed = JSON.parse(localStorage.getItem(UNLOCKED_KEY) || '[]');
        if (Array.isArray(parsed)) saved = parsed;
      } catch (_) {}
      /* 예전 형식(카드 객체)도 주소로 바꿔 읽는다 */
      const urls = [...new Set(saved.map(c => typeof c === 'string' ? c : c && c.url)
        .filter(u => typeof u === 'string' && /^\/trips\/[\w-]+$/.test(u) && !publicUrls.has(u)))];
      const results = await Promise.all(urls.map(async url => {
        try {
          const res = await fetch(url + '/card.json', { cache: 'no-cache' });
          if (res.status === 404) return { url, gone: true };
          if (!res.ok) return { url };
          const c = await res.json();
          if (!c || !c.nameKo) return { url, gone: true };
          const card = Object.fromEntries(Object.entries(c).map(([k, v]) => [k, String(v ?? '')]));
          const key = /^\/assets\/keys\/[\w-]+\.webp$/.test(c.key) ? c.key : '/assets/keys/secret.webp';
          return { url, trip: _toTrip(card, { url, key, no: Number(c.no) || 999 }) };
        } catch (_) { return { url }; }
      }));
      const kept = results.filter(r => !r.gone).map(r => r.url);
      if (JSON.stringify(kept) !== JSON.stringify(saved)) {
        try { localStorage.setItem(UNLOCKED_KEY, JSON.stringify(kept)); } catch (_) {}
      }
      return results.filter(r => r.trip).map(r => r.trip);
    }

    /* 공개·비밀 여행지 카드가 같은 모양이 되도록 한 곳에서 만든다 (cfg 는 homeCardOf 결과) */
    function _toTrip(cfg, { url, key, no }) {
      return {
        nameEn:  cfg.nameEn  || '',
        nameKo:  cfg.nameKo  || cfg.nameEn || '',
        status:  'open',
        url,
        no,
        key,
        tagline: cfg.tagline || '',
        region:  cfg.region  || '',
        nights:  cfg.nights  || '',
        theme:   cfg.theme   || '',
        loc:     cfg.loc     || '',
      };
    }

    function _buildTrips() {
      return Object.entries(TRIP_CONFIG).map(([slug, cfg], idx) =>
        _toTrip(cfg, { url: cfg.url, key: `/assets/keys/${slug}.webp`, no: cfg.no || (idx + 1) }));
    }

    /* 예약 표시는 여행지 주소로 저장한다. 예전 형식(카드 순서 번호)은 지금 순서대로 주소로 바꿔 둔다.
       버전 묶음으로 합쳐진 여행지의 주소(cfg.aliases)는 묶음 카드 주소로 옮긴다 */
    function _loadReserved() {
      const alias = {};
      Object.values(TRIP_CONFIG).forEach(cfg => (cfg.aliases || []).forEach(a => { alias[a] = cfg.url; }));
      const saved = [..._getSet(RESERVED_KEY)];
      const set = new Set(saved
        .map(v => typeof v === 'number' ? TRIPS[v]?.url : (alias[v] || v))
        .filter(v => typeof v === 'string'));
      if (saved.some(v => typeof v !== 'string' || alias[v])) {
        try { _saveSet(RESERVED_KEY, set); } catch (_) {}
      }
      return set;
    }

    /* ── FILTER (기간 · 지역 · 검색어) ── */
    const FILTER = { nights: '', region: '', q: '' };
    const REGION_ORDER = ['수도권', '강원', '충청', '전라', '경상', '제주'];

    function _matches(t) {
      if (FILTER.nights && t.nights !== FILTER.nights) return false;
      if (FILTER.region && t.region !== FILTER.region) return false;
      if (FILTER.q) {
        const hay = (t.nameKo + ' ' + t.loc + ' ' + t.theme + ' ' + t.region + ' ' + t.nameEn).toLowerCase();
        if (!hay.includes(FILTER.q.toLowerCase())) return false;
      }
      return true;
    }

    function _renderFilters() {
      const bar = document.getElementById('filterBar');
      const uniq = (arr) => [...new Set(arr.filter(Boolean))];
      const group = (key, label, values) => `
        <div class="filter-row" data-group="${key}">
          <span class="filter-label">${label}</span>
          <button type="button" class="fchip" data-v="" aria-pressed="${FILTER[key] === ''}">전체</button>
          ${values.map(v => `<button type="button" class="fchip" data-v="${_esc(v)}" aria-pressed="${FILTER[key] === v}">${_esc(v)}</button>`).join('')}
        </div>`;
      bar.innerHTML =
        group('nights', '기간', uniq(TRIPS.map(t => t.nights)).sort()) +
        group('region', '지역', uniq(TRIPS.map(t => t.region)).sort((a, b) => (REGION_ORDER.indexOf(a) + 1 || 99) - (REGION_ORDER.indexOf(b) + 1 || 99))) +
        '<p class="filter-count" id="filterCount" aria-live="polite"></p>';
    }

    document.addEventListener('click', (e) => {
      const chip = e.target.closest('.fchip');
      if (!chip) return;
      const key = chip.closest('.filter-row').dataset.group;
      FILTER[key] = chip.dataset.v;
      _renderFilters();
      _renderGrid();
    });

    function resetFilters() {
      FILTER.nights = ''; FILTER.region = ''; FILTER.q = '';
      const si = document.getElementById('hhNavSearch'); if (si) si.value = '';
      _renderFilters(); _renderGrid();
    }
    /* 내비게이션 검색창이 홈에서도 코스를 걸러 준다 */
    window.filterBySearch = function (v) { FILTER.q = (v || '').trim(); _renderGrid(); };

    /* ── 비밀코드 카드 (그리드 맨 끝, 필터·추천 대상 아님) ── */
    function _renderSecretCard() {
      const i = TRIPS.length; // 다른 카드와 SVG 그라데이션 id가 겹치지 않게
      return `<div class="key-card secret" id="secretCard" role="button" tabindex="0" aria-label="비밀코드 입력"><div class="card-3d">${_CARD_BG}<div class="card-key-img"><img src="/assets/keys/secret.webp" width="416" height="1077" alt="비밀코드 열쇠" onerror="_onKeyImgError(this)" /></div></div><div class="card-cap"><span class="card-name">비밀코드</span><span class="card-meta">코드를 입력하세요</span></div></div>`;
    }

    function _renderGrid() {
      /* 순서: 즐겨찾기 → 열쇠 이미지가 있는 카드 → 카드에 보이는 이름순 (한국어는 가나다, 그 밖은 영문 ABC) */
      const isKo = _currentLang() === 'ko';
      const nameOf = t => isKo ? t.nameKo : t.nameEn;
      const rows = TRIPS.map((t, i) => ({ t, i, fav: _isFav(t), hasKey: !!t.key })).filter(({ t }) => _matches(t))
        .sort((a, b) => (b.fav - a.fav) || (b.hasKey - a.hasKey)
          || nameOf(a.t).localeCompare(nameOf(b.t), isKo ? 'ko' : 'en') || (a.i - b.i));
      document.getElementById('keyGrid').innerHTML = (rows.length
        ? rows.map(({ t, i }) => _renderCard(t, i)).join('')
        : `<div class="filter-empty"><p>조건에 맞는 코스가 아직 없어요.</p><button type="button" class="fchip" onclick="resetFilters()">필터 초기화</button></div>`)
        + _renderSecretCard();
      const cnt = document.getElementById('filterCount');
      if (cnt) cnt.textContent = rows.length === TRIPS.length ? `전체 ${rows.length}개 코스` : `${TRIPS.length}개 중 ${rows.length}개 코스`;
      _attachCardClicks();
      const sc = document.getElementById('secretCard');
      sc.addEventListener('click', showSecretPopup);
      sc.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); showSecretPopup(); } });
    }

    /* ── 비밀코드 입력 ── */
    async function _hashSecret(v) {
      const norm = v.trim().toLowerCase().replace(/\s+/g, '');
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode('travel-huihui-secret:' + norm));
      return [...new Uint8Array(buf)].map(b => b.toString(16).padStart(2, '0')).join('');
    }
    function _secretMsg(text, ok) {
      const m = document.getElementById('secretMsg');
      m.textContent = text;
      m.classList.toggle('ok', !!ok);
    }
    function showSecretPopup() {
      _secretMsg('');
      const input = document.getElementById('secretInput');
      input.value = '';
      input.classList.remove('shake');
      document.getElementById('secretOverlay').classList.add('show');
      input.focus();
    }
    function hideSecretPopup() {
      document.getElementById('secretOverlay').classList.remove('show');
      const sc = document.getElementById('secretCard');
      if (sc) sc.focus();
    }
    document.getElementById('secretForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('secretInput');
      if (!input.value.trim()) { _secretMsg('코드를 입력해 주세요.'); input.focus(); return; }
      if (!(window.crypto && crypto.subtle)) { _secretMsg('이 환경에서는 코드를 확인할 수 없어요. https 주소로 접속해 주세요.'); return; }
      const url = '/trips/' + (await _hashSecret(input.value)).slice(0, 24) + '/';
      let found = false;
      try { found = (await fetch(url, { method: 'HEAD', cache: 'no-store' })).ok; } catch (_) {}
      if (found) {
        _secretMsg('열쇠가 맞았어요. 이동합니다…', true);
        setTimeout(() => goTo(url), 350);
      } else {
        _secretMsg('맞지 않는 코드예요. 다시 확인해 주세요.');
        input.classList.remove('shake'); void input.offsetWidth; input.classList.add('shake');
        input.select();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && document.getElementById('secretOverlay').classList.contains('show')) hideSecretPopup();
    });

    /* 키 이미지가 실제로 로드되는지 확인 */
    function _probeImg(src) {
      return new Promise(resolve => {
        const img = new Image();
        img.onload  = () => resolve(true);
        img.onerror = () => resolve(false);
        img.src = src;
      });
    }

    /* 키 이미지 존재 여부 병렬 체크 → 없으면 coming-soon */
    async function _probeKeys(trips) {
      await Promise.all(trips.map(async trip => {
        const exists = await _probeImg(trip.key);
        if (!exists) { trip.status = 'coming-soon'; trip.key = null; }
      }));
      return trips;
    }

    async function _init() {
      const pub = _buildTrips();
      /* 공개 여행지 키 확인과 비밀 여행지 card.json 읽기를 동시에 진행한다 */
      const [, unlocked] = await Promise.all([
        _probeKeys(pub),
        _unlockedTrips(new Set(pub.map(t => t.url))).then(_probeKeys),
      ]);
      TRIPS = pub.concat(unlocked);
      reservedSet = _loadReserved();
      favSet = _getSet(FAV_KEY);
      _renderFilters();
      _renderGrid();
      _attachLongPress();
      _initHeroKey();
    }

    /* 히어로에 걸린 '오늘의 키': 프런트 데스크 추천과 같은 규칙(하루 종일 같은 여행지)으로 고른다 */
    function _initHeroKey() {
      const avail = TRIPS.map((t, i) => ({ t, i })).filter(({ t }) => t.status !== 'coming-soon');
      const btn = document.getElementById('heroKey');
      if (!avail.length || !btn) return;
      const today = new Date();
      const doy = Math.floor((today - new Date(today.getFullYear(), 0, 0)) / 86400000);
      const { t, i } = avail[doy % avail.length];
      btn.querySelector('img').src = t.key;
      btn.querySelector('.hero-key-cap').textContent = '오늘의 키 — ' + t.nameKo;
      btn.setAttribute('aria-label', '오늘의 키 ' + t.nameKo + ' 코스로 이동');
      btn.hidden = false;
      btn.onclick = () => {
        if (!_matches(t)) resetFilters();
        const card = document.querySelector('[data-trip-idx="' + i + '"]');
        if (!card) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        card.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
        card.classList.add('spot');
        setTimeout(() => card.classList.remove('spot'), 3300);
      };
    }

    _init();

    /* bfcache 복원 시 localStorage 재읽기 */
    window.addEventListener('pageshow', e => {
      if (!e.persisted) return;
      reservedSet = _loadReserved();
      favSet = _getSet(FAV_KEY);
      _renderGrid();
    });

  </script>

