    @keyframes pungFish { 0%, 100% { transform: rotate(-6deg); } 50% { transform: rotate(6deg); } }
    @keyframes pungRing {
      0% { transform: rotate(0); } 12% { transform: rotate(16deg); } 30% { transform: rotate(-12deg); }
      48% { transform: rotate(8deg); } 66% { transform: rotate(-4deg); } 84% { transform: rotate(2deg); } 100% { transform: rotate(0); }
    }
    /* 물고기는 종보다 한 박자 늦게, 더 크게 */
    @keyframes pungFishRing {
      0% { transform: rotate(0); } 18% { transform: rotate(-26deg); } 38% { transform: rotate(22deg); }
      58% { transform: rotate(-14deg); } 76% { transform: rotate(7deg); } 100% { transform: rotate(0); }
    }
