    ══════════════════════════════ */
    .tips-section {
      max-width: 1148px; margin: 0 auto;
      padding: 0 clamp(var(--space-5), 5vw, var(--space-12))
               clamp(var(--space-16), 14vw, var(--space-24));
    }
    .tips-intro {
      font-size: var(--text-sm);
      color: var(--color-text-secondary);
      line-height: var(--leading-normal);
      max-width: 640px;
      margin-bottom: var(--space-4);
    }
    /* 접힌 상태 미리보기: 카테고리 칩 */
    .tips-teaser {
      display: flex; flex-wrap: wrap; row-gap: var(--space-2);
      padding: var(--space-4) 0; border-top: 1px solid var(--color-rule); border-bottom: 1px solid var(--color-rule);
    }
    .tips-teaser.hidden { display: none; }
    /* 접힌 상태: 다룰 주제를 빗금으로 나열한 글줄 */
    .tip-chip {
      font-family: var(--font-heading); font-size: var(--text-sm); font-weight: 500;
      color: var(--color-text-secondary); white-space: nowrap;
    }
    .tip-chip + .tip-chip::before { content: '/'; margin: 0 var(--space-3); color: var(--color-rule-strong); opacity: .35; }
    /* 펼침 상태 상세 콘텐츠 */
    .tips-grid {
      display: none;
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-12); row-gap: var(--space-10);
      margin-top: var(--space-8);
    }
    .tips-grid.expanded {
      display: grid;
      animation: fadeUp var(--dur-slower) var(--ease-out);
    }
    /* 펼친 상태: 상자 없이 굵은 선 아래 소제목과 본문 */
    .tip-card {
      border-top: 2px solid var(--color-text-primary);
      padding-top: var(--space-4);
    }
    .tip-title {
      font-family: var(--font-display);
      font-size: var(--text-lg);
      font-weight: 700;
      color: var(--color-text-primary);
      margin-bottom: var(--space-4);
      letter-spacing: -0.01em;
    }
    .tip-list {
      list-style: none;
      display: flex; flex-direction: column; gap: var(--space-3);
    }
    .tip-list li {
      position: relative;
      padding-left: var(--space-4);
      font-size: var(--text-sm);
      color: var(--color-text-secondary);
      line-height: var(--leading-normal);
    }
    .tip-list li::before {
      content: '';
      position: absolute; left: 0; top: 0.8em;
      width: 8px; height: 1px;
      background: var(--color-text-primary);
    }
    .tip-list li strong {
      color: var(--color-text-primary);
      font-weight: 600;
    }
    .tips-toggle {
      display: flex; align-items: center; justify-content: center; gap: 6px;
      margin: var(--space-6) 0 0;
      padding: 0 0 2px; min-height: 44px;
