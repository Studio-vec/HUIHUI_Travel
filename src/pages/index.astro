---
import { asset } from '../lib/asset';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TripIndex from '../components/TripIndex.astro';
import HanokEave from '../components/HanokEave.astro';
import { homeCardOf, listedTrips, publicTrips } from '../lib/tripData';
import { KNOT_PATH, FLOWER_PATH } from '../lib/hanok';

/* 버전 묶음(원주 커플·가족 등)은 대표 카드 하나만 싣고, 버전은 여행지 페이지의 탭에서 고른다 */
const keyTrips = listedTrips();
/* 글 목차(TripIndex)는 크롤러가 따라갈 진입점이라 버전까지 모든 공개 여행지를 싣는다 */
const allTrips = publicTrips();

/* 비밀코드 여행지는 홈에 아무 정보도 싣지 않는다. 입력한 코드의 해시로 주소(/trips/<해시 앞 24자>)를 만들어
   그 페이지가 있는지만 확인한다. 해시 규칙은 scripts/secret_hash.mjs 와 같아야 한다.
   한 번 연 비밀 여행지는 그 페이지가 localStorage(huihui_unlocked)에 주소를 남기고, 홈이 <주소>/card.json 으로 카드를 그린다. */

const tripConfig = Object.fromEntries(keyTrips.map(({ trip, variants }, idx) => [trip.id, homeCardOf(trip, idx + 1, variants)]));
---
<BaseLayout title="Travel HUIHUI — 국내 여행 안내서">
  <Fragment slot="head">
  <link rel="stylesheet" href={asset('/assets/css/tokens.css')}/>
  </Fragment>
  <Navbar />
  <main id="main">


  <!-- ── NAVBAR ── -->

  <!-- ── HERO: 기와 처마 아래 프런트 ── -->
  <section class="hero">
    <HanokEave />
    <div class="hero-inner">
      <button class="hero-key" id="heroKey" type="button" hidden>
        <span class="hero-key-rope" aria-hidden="true"></span>
        <span class="hero-key-knot" aria-hidden="true"></span>
        <img alt="" width="416" height="1077" />
        <span class="hero-key-cap"></span>
      </button>
      <h1 class="hero-title fade-up" id="heroTitle">
        <span class="hero-kicker">기쁜 걸음만 골라 담은</span><em>국내 여행 안내서</em>
      </h1>
      <div class="hero-foot fade-up">
        <p class="hero-desc" id="heroDesc">
          직접 걸어 본 길을 하루 단위 코스로 엮었어요.<br>
          동선과 시간, 현장에서 알게 된 작은 팁까지 함께 적어 둡니다.
        </p>
        <div class="hero-actions">
          <button class="hero-cta" type="button" onclick="ringBell()">
            오늘의 여행지 추천 받기 <span class="hero-cta-arrow" aria-hidden="true">→</span>
          </button>
          <button type="button" class="he-sound-btn" aria-pressed="false"><svg class="he-spk" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6h3l4-3v10L5 10H2z"/><path class="he-spk-on" d="M11.5 5.5a3.5 3.5 0 0 1 0 5M13.5 3.5a6.5 6.5 0 0 1 0 9"/><path class="he-spk-off" d="M11 6l4 4M15 6l-4 4"/></svg>풍경 소리 <span>끔</span></button>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SECTION LABEL ── -->
  <div class="section-label">
    <span class="section-label-text" id="sectionLabel">여행 코스</span>
    <div class="section-label-line"></div>
  </div>

  <!-- ── FILTER ── -->
  <div class="filter-bar" id="filterBar" role="group" aria-label="여행 코스 필터"></div>

  <!-- ── KEY GRID ── -->
  <section class="grid-section">
    <div class="key-grid" id="keyGrid"></div>
  </section>

  <!-- ── SECTION LABEL (TIPS) ── -->
  <div class="section-label">
    <span class="section-label-text">여행 팁</span>
    <div class="section-label-line"></div>
  </div>

  <!-- ── TRAVEL TIPS ── -->
  <section class="tips-section">
    <p class="tips-intro">직접 다녀본 국내 여행지를 바탕으로 정리한 실전 팁 11가지예요.</p>

    <!-- 접힌 상태의 미리보기: 카테고리 칩만 노출 -->
    <div class="tips-teaser" id="tipsTeaser">
      <span class="tip-chip">짐·숙소</span>
      <span class="tip-chip">교통·이동</span>
      <span class="tip-chip">예산·할인</span>
      <span class="tip-chip">날씨 대응</span>
      <span class="tip-chip">단체 여행</span>
      <span class="tip-chip">혼자 여행</span>
      <span class="tip-chip">숙소 놀거리</span>
      <span class="tip-chip">계절별 추천</span>
      <span class="tip-chip">당일치기</span>
      <span class="tip-chip">여행 사진</span>
      <span class="tip-chip">안전·비상</span>
    </div>

    <div class="tips-grid" id="tipsGrid">
      <article class="tip-card">
        <h3 class="tip-title">짐 싸기 &amp; 숙소 예약</h3>
        <ul class="tip-list">
          <li><strong>배낭이 캐리어보다 낫습니다.</strong> 1박 2일 일정이라면 계단이 많은 골목 안 숙소나 환승이 잦은 여행지에서는 바퀴 달린 캐리어가 오히려 짐이 됩니다. 배낭이나 보스턴백을 챙기면 계단을 오르내리거나 좁은 골목을 지날 때 훨씬 수월하고, 양손도 자유로워서 사진을 찍거나 간식을 사 먹기도 편해요.</li>
          <li><strong>옷은 여행 일수보다 하루 적게, 상비약은 넉넉히.</strong> 여행지 근처 편의점이나 마트에서 옷을 구하기는 번거롭지만 여벌 양말이나 속옷 정도는 언제든 구할 수 있으니 짐 무게를 줄이는 게 낫습니다. 대신 진통제, 멀미약, 밴드, 소화제 같은 상비약은 현지에서 급하게 찾기 어려운 경우가 많으니 미리 소분해서 챙겨두세요.</li>
          <li><strong>보조배터리와 멀티탭은 필수템입니다.</strong> 숙소마다 콘센트 위치가 침대 옆, 화장대 밑 등 제각각이라 동시에 여러 기기를 충전하기 애매한 경우가 많아요. 멀티탭 하나만 있으면 휴대폰, 카메라, 보조배터리를 한 번에 충전할 수 있어서 의외로 매 여행마다 자주 쓰게 됩니다.</li>
          <li><strong>숙소 후기는 최신순으로 정렬해서 보세요.</strong> 평점은 시간이 지나며 왜곡되기 쉬우니 최근 1~3개월 이내 리뷰를 우선 확인하는 게 정확해요. 특히 방음, 주차 공간 유무, 청소 상태, 벌레 관련 언급이 있는지를 중점적으로 살펴보면 실망할 확률이 크게 줄어듭니다.</li>
          <li><strong>무료 취소가 가능한 숙소를 우선 고려하세요.</strong> 성수기나 주말엔 날씨나 개인 사정으로 일정이 바뀔 가능성이 항상 있습니다. 예약 단계에서 취소 및 환불 정책을 꼼꼼히 확인해두면, 일정이 틀어져도 위약금 걱정 없이 유연하게 대응할 수 있어요.</li>
        </ul>
      </article>

      <article class="tip-card">
        <h3 class="tip-title">교통 &amp; 이동</h3>
        <ul class="tip-list">
          <li><strong>숙소는 동선의 중간 지점에 잡으세요.</strong> 역이나 터미널 바로 앞이 항상 정답은 아니에요. 그날 하루 어떤 순서로 이동할지 먼저 그려보고, 그 동선의 중간 즈음에 숙소를 잡으면 아침저녁으로 이동하는 시간이 눈에 띄게 줄어듭니다. 특히 저녁 늦게까지 돌아다니는 코스라면 마지막 목적지와 가까운 숙소가 하루를 여유롭게 마무리하는 데 훨씬 도움이 됩니다.</li>
          <li><strong>지방 소도시는 대중교통 시간표부터 확인하세요.</strong> 버스 배차 간격이 30분에서 1시간 이상인 지역이 흔해서, 현장에서 시간표를 보고 놀라는 경우가 많아요. 출발 전에 네이버지도나 카카오맵으로 노선과 막차 시간을 미리 캡처해두면 현장에서 헤매는 시간을 크게 줄일 수 있습니다.</li>
          <li><strong>콜택시 번호는 미리 저장해두세요.</strong> 택시 호출 앱이 잘 잡히지 않는 외곽 지역이 의외로 많습니다. 그런 지역은 앱보다 지역 콜택시 업체에 직접 전화하는 편이 훨씬 빠르니, 방문 전 검색으로 번호를 저장해두는 습관을 들이면 좋아요.</li>
          <li><strong>KTX·SRT는 출발 한 달 전에 예매하세요.</strong> 특가석이나 할인 좌석은 예매가 빠를수록 남아 있을 확률이 높고 가격도 저렴합니다. 출발 임박해서 예매하면 입석만 남거나 정가로 결제해야 하는 경우가 많으니 일정이 정해지면 바로 예매하는 게 좋아요.</li>
          <li><strong>관광 순환버스나 트램을 적극 활용하세요.</strong> 여수, 강릉처럼 인기 여행지는 주요 명소를 도는 순환버스나 트램이 운영되는 경우가 많아 렌트카 없이도 촘촘한 동선을 짤 수 있습니다. 1일 자유이용권을 판매하는 곳도 많아 대중교통비를 아끼는 데도 도움이 됩니다.</li>
        </ul>
      </article>

      <article class="tip-card">
        <h3 class="tip-title">예산 절약 &amp; 할인 혜택</h3>
        <ul class="tip-list">
          <li><strong>지역사랑상품권부터 확인하세요.</strong> 방문할 지역의 지역화폐를 앱으로 충전하면 5~10% 캐시백이 붙는 경우가 많고, 관광지 주변 식당·카페·기념품점에서도 사용처가 꽤 넓습니다. 여행 전날 미리 충전해두면 현장에서 헤매지 않고 바로 쓸 수 있어요.</li>
          <li><strong>비수기 방문이 가장 확실한 할인입니다.</strong> 주중이나 명소 개장 초반 시즌에 방문하면 숙박비가 성수기 대비 30~50%까지 저렴해지는 경우가 흔합니다. 사람도 적어 사진 찍기 좋고 대기 시간도 짧아지니 일정에 여유가 있다면 비수기를 노려보세요.</li>
          <li><strong>지자체 관광 홈페이지의 쿠폰을 챙기세요.</strong> 지역 축제 기간에는 무료 셔틀버스, 입장료 할인 쿠폰, 지역 상품권 증정 이벤트를 진행하는 경우가 많은데, 현장에서는 몰라서 놓치기 쉬워요. 출발 전 관광 홈페이지나 SNS 공지를 한 번 확인하는 습관을 들이면 좋아요.</li>
          <li><strong>조식 포함 숙소가 오히려 이득일 수 있어요.</strong> 관광지 근처 식당 물가가 비싼 지역일수록 조식 포함 패키지가 개별로 아침을 사 먹는 것보다 저렴한 경우가 많습니다. 예약 전 조식 포함 여부와 가격 차이를 함께 비교해보세요.</li>
          <li><strong>문화누리카드·지역 할인카드는 꼭 활용하세요.</strong> 대상자라면 박물관, 미술관, 체험시설 입장료가 무료이거나 큰 폭으로 할인되는 경우가 많습니다. 카드를 미리 챙겨가고, 방문 전 해당 시설이 카드 사용처인지 확인해두면 헛걸음을 줄일 수 있어요.</li>
        </ul>
      </article>

      <article class="tip-card">
        <h3 class="tip-title">날씨 대응</h3>
        <ul class="tip-list">
          <li><strong>우천 대비 실내 코스를 하나는 준비해두세요.</strong> 박물관, 전통시장, 카페 거리처럼 비가 와도 즐길 수 있는 곳을 예비 코스로 잡아두면 날씨 때문에 일정이 통째로 무너지는 일을 막을 수 있습니다. 우산보다 우비가 이동 중엔 훨씬 편하다는 점도 기억해두세요.</li>
          <li><strong>여름 폭염엔 정오부터 오후 4시까지 야외 활동을 최소화하세요.</strong> 이 시간대는 자외선과 체감 온도가 가장 높아 야외 명소보다 실내 체험, 카페 투어, 쇼핑몰 위주로 동선을 옮기는 게 체력 소모를 줄이는 데 훨씬 유리합니다. 그늘이 있는 산책로를 미리 찾아두는 것도 방법이에요.</li>
          <li><strong>해안 지역은 출발 전 강풍특보를 꼭 확인하세요.</strong> 케이블카나 유람선은 강풍이 불면 안전상의 이유로 운행이 중단되는 경우가 흔합니다. 현장에서 헛걸음하지 않으려면 출발 전날 저녁과 당일 아침 두 번 운행 여부를 확인하는 게 안전해요.</li>
          <li><strong>겨울 산간·해안도로는 결빙 구간을 주의하세요.</strong> 렌트카로 이동한다면 스노체인이나 겨울용 타이어가 장착되어 있는지 미리 확인하고, 급경사 구간은 내비게이션에서 우회 경로를 검색해두는 편이 안전합니다.</li>
          <li><strong>기상청 특보 알림을 여행 기간만이라도 켜두세요.</strong> 여행 중 갑작스러운 특보가 발효되면 실시간으로 알림을 받아 바로 동선을 조정할 수 있습니다. 특히 계곡, 해안, 산간 지역을 방문할 계획이라면 이 알림 하나가 안전을 크게 좌우해요.</li>
        </ul>
      </article>

      <article class="tip-card">
        <h3 class="tip-title">단체 여행</h3>
        <ul class="tip-list">
          <li><strong>인원이 많을수록 예약은 최소 한 달 전에 하세요.</strong> 단체석이나 단체룸은 개인 예약보다 훨씬 빨리 마감되는 경우가 많습니다. 특히 주말이나 연휴 기간이라면 한 달로도 부족할 수 있으니 일정이 확정되는 즉시 예약부터 시작하는 게 좋습니다.</li>
          <li><strong>단체 할인은 먼저 물어봐야 나오는 경우가 많아요.</strong> 식당, 렌트카, 체험시설 홈페이지에는 단체 할인 안내가 따로 없어도 전화로 인원수를 말하고 문의하면 할인을 받을 수 있는 곳이 의외로 많습니다. 예약 전화를 할 때 인원과 할인 가능 여부를 함께 물어보는 습관을 들이세요.</li>
          <li><strong>일정에 자유시간 블록을 꼭 넣으세요.</strong> 취향이 다른 인원이 섞인 단체 여행일수록 하루 1~2시간의 자유시간을 넣어야 각자 원하는 걸 하고 만족도가 올라갑니다. 모든 일정을 함께 움직이려 하면 오히려 불만이 쌓이기 쉬워요.</li>
          <li><strong>단톡방에 집합 장소와 시간을 고정 공지하세요.</strong> 이동할 때마다 다음 집합 장소와 시각을 사진과 지도 링크로 함께 공유하면 인원이 흩어지는 일이 크게 줄어듭니다. 특히 시장이나 축제처럼 사람이 많은 장소에서는 이 방법이 확실히 도움이 돼요.</li>
          <li><strong>차량 이동은 좌석과 짐 배치를 출발 전에 정하세요.</strong> 현장에서 누가 어디 앉을지, 짐은 어디에 실을지 정하면 시간이 두 배로 걸립니다. 출발 전 단톡방에서 미리 정해두면 실제 이동은 훨씬 매끄러워집니다.</li>
        </ul>
      </article>

      <article class="tip-card">
        <h3 class="tip-title">혼자 여행 (개인 여행)</h3>
        <ul class="tip-list">
          <li><strong>숙소는 접근성과 안전을 최우선으로 고르세요.</strong> 특히 여성 1인 여행이라면 후기에서 출입구 보안 상태, 복도 CCTV 유무, 주변 치안 관련 언급을 꼼꼼히 확인하는 게 좋습니다. 역이나 번화가에서 도보로 이동 가능한 숙소를 고르면 늦은 시간 이동 부담도 줄어들어요.</li>
          <li><strong>실시간 위치 공유 앱을 켜두세요.</strong> 가족이나 지인과 위치를 공유해두면 만약의 상황에도 빠르게 도움을 받을 수 있어 심리적으로도 훨씬 안심이 됩니다. 하루 일정이 끝난 시각을 짧게라도 메시지로 남기는 습관도 함께 들이면 좋아요.</li>
          <li><strong>혼밥이 가능한 식당을 미리 검색해두세요.</strong> 바 좌석이나 1인석이 있는 식당을 지도 앱에 미리 저장해두면 끼니때마다 눈치를 보거나 헤매는 일이 줄어듭니다. 최근엔 혼밥 전용 좌석을 갖춘 맛집도 많이 늘어난 편이에요.</li>
          <li><strong>일정은 여유 있게 짜고 즉흥적인 시간을 남겨두세요.</strong> 혼자 여행의 가장 큰 장점은 유연함이니 너무 빡빡한 시간표를 짜기보다는, 마음에 드는 장소를 만나면 계획 없이 더 머물 수 있는 여유를 남겨두는 게 만족도를 높입니다.</li>
          <li><strong>현지 소모임이나 여행 커뮤니티를 활용해보세요.</strong> 당일 투어나 로컬 맛집 정보를 얻기 좋을 뿐 아니라, 낯선 지역에서 함께 다닐 사람을 만나 안전 면에서도 도움이 되는 경우가 많습니다.</li>
        </ul>
      </article>

      <article class="tip-card">
        <h3 class="tip-title">숙소에서 즐기는 놀거리</h3>
        <ul class="tip-list">
          <li><strong>커플·가족 잠옷 맞추기.</strong> 여행 전 온라인몰에서 같은 디자인의 잠옷을 미리 주문해서 챙겨가면, 숙소에서 사진을 찍거나 함께 시간을 보낼 때 특별한 기분을 낼 수 있어요. 숙소 조명과 톤이 맞는 파스텔 컬러를 고르면 사진이 훨씬 잘 나옵니다.</li>
          <li><strong>배쓰밤·입욕제로 미니 스파 즐기기.</strong> 욕조가 있는 숙소라면 여행 가방에 배쓰밤이나 입욕제를 하나 챙겨가 보세요. 하루 종일 걸어 다닌 피로를 푸는 데도 좋고, 향과 색이 있는 배쓰밤은 숙소 안에서도 특별한 분위기를 만들어줍니다.</li>
          <li><strong>휴대용 보드게임·카드게임 챙기기.</strong> 부피가 작은 우노, 할리갈리 같은 카드게임 하나만 챙겨도 저녁 시간이 훨씬 풍성해집니다. 단체 여행이라면 인원이 많아도 함께 즐길 수 있는 게임을 고르는 게 좋아요.</li>
          <li><strong>미니 홈파티 세팅하기.</strong> 근처 마트에서 간단한 안주와 음료, 무드등이나 폴라로이드 카메라를 준비해서 숙소 테이블에 세팅하면 밖에서 노는 것 못지않은 특별한 저녁을 만들 수 있어요. 폴라로이드 사진은 그 자리에서 바로 인화되니 여행 기록으로도 남기 좋습니다.</li>
          <li><strong>넷플릭스·영화 한 편 정해두기.</strong> 늦은 밤 숙소에서 볼 영화나 드라마를 미리 하나 정해두면, 일정이 끝난 뒤 무엇을 할지 고민하는 시간 없이 편하게 하루를 마무리할 수 있습니다. 이어폰보다 작은 블루투스 스피커를 챙기면 분위기가 한층 살아나요.</li>
        </ul>
      </article>

      <article class="tip-card">
        <h3 class="tip-title">계절별 여행지 선택</h3>
        <ul class="tip-list">
          <li><strong>봄·가을엔 걷기 좋은 여행지를 고르세요.</strong> 수원화성 성곽길이나 노원 수락산처럼 산책과 꽃·단풍을 함께 즐길 수 있는 여행지가 이 계절엔 만족도가 특히 높습니다. 일교차가 크니 얇은 겉옷을 챙기는 것도 잊지 마세요.</li>
          <li><strong>여름엔 물이 있는 여행지를 우선하세요.</strong> 여수, 강릉처럼 바다나 계곡이 있는 지역은 더위를 식히기 좋을 뿐 아니라 해양 액티비티나 물놀이까지 함께 즐길 수 있어 여름 여행지로 만족도가 높습니다.</li>
          <li><strong>겨울엔 실내·온천 중심 코스를 짜세요.</strong> 이천, 대전처럼 온천이나 실내 체험이 풍부한 지역은 추위 걱정 없이 하루를 알차게 보낼 수 있어 겨울철 만족도가 특히 좋았습니다.</li>
          <li><strong>장마철엔 습도가 낮은 내륙 지역을 우선하세요.</strong> 해안 지역은 장마 기간 파도와 강풍으로 야외 일정이 취소되기 쉬운 반면, 내륙 도심 여행지는 실내 위주로 동선을 짜기 좋아 일정 차질이 상대적으로 적습니다.</li>
          <li><strong>여행 시기를 먼저 정하고 지역을 고르세요.</strong> 지역부터 정하고 시기를 맞추면 계절과 어울리지 않는 코스가 되기 쉬워요. 언제 떠날지 먼저 정한 뒤 그 계절에 가장 잘 어울리는 지역을 고르면 후회가 훨씬 줄어듭니다.</li>
        </ul>
      </article>

      <article class="tip-card">
        <h3 class="tip-title">당일치기 코스 짜기</h3>
        <ul class="tip-list">
          <li><strong>명소는 3곳을 넘기지 마세요.</strong> 욕심을 내서 4~5곳을 계획하면 이동에 시간을 다 쓰고 정작 머무는 시간이 짧아져 남는 게 없는 여행이 되기 쉽습니다. 적은 수의 명소를 여유 있게 즐기는 편이 만족도가 훨씬 높아요.</li>
          <li><strong>대표 명소 1곳, 식사·카페 1곳, 산책 코스 1곳으로 압축하세요.</strong> 이 조합이 이동 부담은 적으면서도 가장 여유롭고 기억에 남는 하루를 만들어줍니다. 각 장소에 최소 1시간 이상 머물 수 있도록 여유를 두는 게 핵심이에요.</li>
          <li><strong>동선은 원형이 아니라 한 방향으로 흐르게 짜세요.</strong> 왔던 길을 되짚어 가지 않도록 출발지에서 도착지까지 한 방향으로 흐르는 동선을 짜면 이동 시간이 눈에 띄게 줄어듭니다.</li>
          <li><strong>점심시간은 12시보다 이르거나 늦게 잡으세요.</strong> 유명 맛집일수록 웨이팅이 몰리는 12시~1시를 피하면 대기 시간 없이 훨씬 여유롭게 식사할 수 있습니다.</li>
          <li><strong>돌아오는 막차·막기차 시간부터 거꾸로 계획하세요.</strong> 마지막 목적지를 그 시간에 맞춰 배치하면 하루를 급하게 마무리하거나 일정을 중간에 끊을 일이 없어 훨씬 안정적인 하루가 됩니다.</li>
        </ul>
      </article>

      <article class="tip-card">
        <h3 class="tip-title">여행 사진 잘 찍기</h3>
        <ul class="tip-list">
          <li><strong>사람이 없는 시간대를 노리세요.</strong> 오전 9시 이전이나 해 질 무렵에 인기 명소를 방문하면 인파 없이 여유롭게 촬영할 수 있습니다. 개장 직후가 가장 한산한 경우가 많으니 아침 일찍 움직이는 걸 추천해요.</li>
          <li><strong>이른 아침 빛과 노을 시간대를 적극 활용하세요.</strong> 한옥 골목은 아침 빛이 부드럽게 들어와 사진이 특히 예쁘게 나오고, 바닷가는 노을 시간대에 색감이 확 살아납니다. 장소별로 촬영하기 좋은 시간대를 미리 알아두면 도움이 돼요.</li>
          <li><strong>일출·일몰 시각을 미리 검색해두세요.</strong> 그 시간에 맞춰 동선을 짜는 것만으로도 사진의 완성도가 크게 달라집니다. 날씨 앱에서 일출·일몰 시각을 함께 확인할 수 있으니 여행 전 체크해두세요.</li>
          <li><strong>구도는 가로·세로 컷을 함께 남기세요.</strong> SNS 업로드용 세로 컷과 나중에 인화하거나 앨범으로 만들기 좋은 가로 컷을 함께 찍어두면 용도에 맞게 골라 쓸 수 있어 편집이 훨씬 수월해집니다.</li>
          <li><strong>흐린 날엔 색감보다 분위기를 살린 사진을 노리세요.</strong> 안개가 낀 풍경이나 파스텔톤 흐린 하늘은 맑은 날보다 오히려 감성적이고 차분한 분위기의 컷을 남기기 좋은 조건이에요.</li>
        </ul>
      </article>

      <article class="tip-card">
        <h3 class="tip-title">안전 &amp; 비상 상황 대비</h3>
        <ul class="tip-list">
          <li><strong>단기 여행자보험 가입을 고려하세요.</strong> 국내 여행이라도 상해나 휴대품 파손·분실을 보장하는 저렴한 단기 보험 상품이 많습니다. 몇천 원 수준의 비용으로 만약의 사고에 대비할 수 있으니 액티비티가 포함된 일정이라면 특히 추천해요.</li>
          <li><strong>여행지 응급실과 약국 위치를 미리 확인해두세요.</strong> 지도 앱에 가까운 응급실과 24시간 약국을 미리 저장해두면 급한 상황에서 시간을 크게 아낄 수 있습니다.</li>
          <li><strong>신분증과 중요 서류는 클라우드에 사본을 보관하세요.</strong> 여권이나 신분증을 분실했을 때 사본이 있으면 재발급 절차가 훨씬 수월해집니다. 사진을 찍어 클라우드나 메일로 보내두는 것만으로 충분해요.</li>
          <li><strong>등산이나 해루질 같은 활동은 반드시 동행자와 함께하세요.</strong> 나 홀로 산행이나 야간 갯벌 활동은 사고 발생 시 도움을 받기 어려워 위험이 훨씬 커집니다. 동행자가 없다면 사람이 많은 시간대와 코스를 선택하는 게 안전해요.</li>
          <li><strong>비상 연락처는 오프라인으로도 저장해두세요.</strong> 휴대폰 배터리가 없거나 신호가 안 잡히는 상황을 대비해 숙소 전화번호와 비상 연락처를 수첩이나 메모지에 적어두면 훨씬 안심이 됩니다.</li>
        </ul>
      </article>
    </div>

    <button class="tips-toggle" id="tipsToggleBtn" onclick="toggleTips()" aria-expanded="false" aria-controls="tipsGrid">
      <span id="tipsToggleText">더보기</span>
      <svg id="tipsToggleIcon" width="14" height="14" viewBox="0 0 24 24" fill="none">
        <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </section>

  <!-- ── 풍경: 울리면 오늘의 여행지를 골라 준다 (히어로 처마의 풍경과 같은 그림) ── -->
  <button class="bell-wrapper" id="bellWrapper" type="button" onclick="ringBell()" aria-label="풍경 울리기 — 오늘의 여행지 추천" title="오늘의 길잡이">
    <svg class="pung-svg" viewBox="0 0 60 84" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M14 6H46" stroke="#202943" stroke-width="2.2"/>
      <g class="pung-bell" id="bellTop">
        <path d="M30 6V17" stroke="#202943" stroke-width="1.6"/>
        <path d="M17 40C17 25 22 17 30 17C38 17 43 25 43 40Z" fill="#FBF7F0" stroke="#202943" stroke-width="2"/>
        <path d="M13 40H47M22 28H38" stroke="#202943" stroke-width="1.6"/>
        <circle cx="30" cy="12" r="2.4" fill="#EF4D6D"/>
        <g class="pung-fish">
          <path d="M30 40V52" stroke="#202943" stroke-width="1.4"/>
          <path d="M30 52C36 56 36 66 30 72C24 66 24 56 30 52ZM30 72L25 80H35Z" fill="#00A58C"/>
          <circle cx="28.4" cy="58" r="1.2" fill="#FBF7F0"/>
        </g>
      </g>
    </svg>
  </button>
  <script is:inline>
    /* 히어로(추천 버튼·오늘의 키)가 화면에 걸쳐 있는 동안은 떠 있는 풍경을 숨기고,
       열쇠 목록으로 내려오면 나타나게 한다 (첫 화면에서 오늘의 키와 겹치지 않게) */
    (function () {
      var bell = document.getElementById('bellWrapper');
      var hero = document.querySelector('.hero');
      if (!bell || !hero || !('IntersectionObserver' in window)) return;
      bell.classList.add('is-hidden');
      new IntersectionObserver(function (entries) {
        bell.classList.toggle('is-hidden', entries[0].isIntersecting);
      }).observe(hero);
    })();
  </script>

